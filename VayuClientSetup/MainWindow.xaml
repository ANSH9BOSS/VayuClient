<Window x:Class="VayuClientSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VayuClient Setup — ANSH9BOSS"
        Icon="/Assets/Images/vayu_logo.png"
        FontFamily="{StaticResource VayuFontFamily}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Width="720" Height="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen">

    <!-- Outer container with rounded corners and shadow -->
    <Border CornerRadius="16" Background="#FF080810">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.6" Color="Black"/>
        </Border.Effect>

        <Border CornerRadius="16" ClipToBounds="True" BorderBrush="#1BFFFFFF" BorderThickness="1">
            <Grid>
                <!-- Atmospheric background gradient -->
                <Grid IsHitTestVisible="False">
                    <Ellipse Width="400" Height="400" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-100,-100">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#182196F3" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="300" Height="300" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-80,-80,0,0">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#1400D2FF" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Border Background="#A0080810"/>
                </Grid>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42"/>  <!-- Title bar -->
                        <RowDefinition Height="*"/>   <!-- Content -->
                    </Grid.RowDefinitions>

                    <!-- ═══ TITLE BAR ═══ -->
                    <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                            <Image Source="/Assets/Images/vayu_logo.png" Width="20" Height="20" Margin="0,0,8,0"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="TitleText" Text="VayuClient Setup" 
                                       FontFamily="{StaticResource VayuFontFamily}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource VayuTextDimBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Grid.Column="2" Style="{StaticResource TitleBarCloseButton}" Click="Close_Click">
                            <TextBlock Text="✕" FontSize="12" Foreground="{StaticResource VayuTextDimBrush}"/>
                        </Button>
                    </Grid>

                    <!-- ═══ CONTENT PANELS ═══ -->
                    <Grid Grid.Row="1" Margin="32,8,32,24">

                        <!-- ═══ SCREEN 0: WELCOME (FRESH INSTALL) ═══ -->
                        <Grid x:Name="ScreenWelcome" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <!-- Official Logo -->
                                <Image Source="/Assets/Images/vayu_logo.png" Width="100" Height="100" Margin="0,0,0,16"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>

                                <TextBlock Text="VayuClient" Style="{StaticResource VayuH1}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Your Minecraft. Your Way." Style="{StaticResource VayuBodyDim}" 
                                           FontSize="15" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                <TextBlock Text="Developer: ANSH9BOSS" Style="{StaticResource VayuCaption}" 
                                           Margin="0,10,0,0" Foreground="{StaticResource VayuAccentLightBrush}"
                                           HorizontalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource VayuGlassButton}" Padding="24,12" Margin="0,0,12,0" Click="Close_Click">
                                    <TextBlock Text="Cancel" FontSize="14" Foreground="{StaticResource VayuTextDimBrush}"/>
                                </Button>
                                <Button Style="{StaticResource VayuAccentButton}" Padding="32,12" Click="WelcomeNext_Click">
                                    <TextBlock Text="Install" FontSize="14" FontWeight="Bold" Foreground="White"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- ═══ SCREEN UPDATE: EXISTING INSTALLATION DETECTED ═══ -->
                        <Grid x:Name="ScreenUpdate" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                                <Image Source="/Assets/Images/vayu_logo.png" Width="72" Height="72" Margin="0,0,0,14"
                                       HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>

                                <TextBlock x:Name="TxtUpdateHeader" Text="Update VayuClient" Style="{StaticResource VayuH1}" FontSize="24" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtUpdateSubheader" Text="An existing VayuClient installation was found." 
                                           Style="{StaticResource VayuBodyDim}" FontSize="13.5" Margin="0,4,0,16" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>

                                <!-- Card 1: Version Comparison (Shown when Update is Available) -->
                                <Border x:Name="CardVersionComparison" CornerRadius="12" Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1"
                                        Padding="18,14" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                            <TextBlock Text="INSTALLED VERSION" Style="{StaticResource VayuLabel}" FontSize="10.5" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtInstalledVer" Text="1.0.0" FontSize="16" FontWeight="Bold" Foreground="#A0A0B0" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="➔" FontSize="20" Foreground="{StaticResource VayuSecondaryBrush}" VerticalAlignment="Center" Margin="16,0"/>

                                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                            <TextBlock Text="UPDATE VERSION" Style="{StaticResource VayuLabel}" FontSize="10.5" Foreground="{StaticResource VayuSecondaryBrush}" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtAvailableVer" Text="1.1.0" FontSize="16" FontWeight="Bold" Foreground="{StaticResource VayuSecondaryBrush}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Card 2: Already Up to Date Badge (Shown when Versions Match) -->
                                <Border x:Name="CardAlreadyInstalled" CornerRadius="12" Background="#1000D2FF" BorderBrush="#2500D2FF" BorderThickness="1"
                                        Padding="18,14" Margin="0,0,0,12" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="#2000D2FF" Margin="0,0,14,0">
                                            <TextBlock Text="✓" FontSize="20" FontWeight="Bold" Foreground="{StaticResource VayuAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="TxtInstalledVerBadge" Text="VayuClient v1.1.0" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource VayuTextBrush}"/>
                                                <Border Background="#16233B" BorderBrush="#00D2FF" BorderThickness="1" CornerRadius="3" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="UP TO DATE" FontSize="9.5" FontWeight="Bold" Foreground="#00D2FF"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtInstalledPathDisplay" Text="Installed at: %LOCALAPPDATA%\Programs\VayuClient" FontSize="11.5" Foreground="{StaticResource VayuTextDimBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border CornerRadius="10" Background="#1200E676" BorderBrush="#2500E676" BorderThickness="1" Padding="14,10">
                                    <TextBlock Text="✓ Your player profiles, accounts, and instance data in %APPDATA%\VayuClient will remain 100% safe." 
                                               FontSize="11.5" Foreground="{StaticResource VayuSuccessBrush}" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>

                            <!-- Bottom Action Buttons: Update Mode -->
                            <Grid x:Name="PanelUpdateButtons" Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Style="{StaticResource VayuGlassButton}" Padding="16,10" Click="UninstallFromUpdate_Click">
                                    <TextBlock Text="Uninstall..." FontSize="13" Foreground="#FF6B6B"/>
                                </Button>

                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Style="{StaticResource VayuGlassButton}" Padding="20,11" Margin="0,0,10,0" Click="Close_Click">
                                        <TextBlock Text="Cancel" FontSize="13.5" Foreground="{StaticResource VayuTextDimBrush}"/>
                                    </Button>
                                    <Button Style="{StaticResource VayuAccentButton}" Padding="26,11" Click="StartUpdate_Click">
                                        <TextBlock Text="Update Now" FontSize="13.5" FontWeight="Bold" Foreground="White"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Bottom Action Buttons: Up-to-date / Reinstall Mode -->
                            <Grid x:Name="PanelUpToDateButtons" Grid.Row="1" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Style="{StaticResource VayuGlassButton}" Padding="16,10" Click="UninstallFromUpdate_Click">
                                    <TextBlock Text="Uninstall..." FontSize="13" Foreground="#FF6B6B"/>
                                </Button>

                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Style="{StaticResource VayuGlassButton}" Padding="18,11" Margin="0,0,10,0" Click="StartUpdate_Click">
                                        <TextBlock Text="Repair / Reinstall" FontSize="13.5" Foreground="{StaticResource VayuTextBrush}"/>
                                    </Button>
                                    <Button Style="{StaticResource VayuAccentButton}" Padding="26,11" Click="LaunchInstalled_Click">
                                        <TextBlock Text="Launch VayuClient" FontSize="13.5" FontWeight="Bold" Foreground="White"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- ═══ SCREEN 1: OPTIONS (LOCATION & SHORTCUTS) ═══ -->
                        <Grid x:Name="ScreenOptions" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                                <TextBlock Text="Installation Options" Style="{StaticResource VayuH2}"/>
                                <TextBlock Text="Select installation folder and shortcut preferences" Style="{StaticResource VayuBodyDim}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" VerticalAlignment="Top">
                                <!-- Location -->
                                <Border CornerRadius="12" Background="#0AFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1" Padding="20,16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="INSTALLATION LOCATION" Style="{StaticResource VayuLabel}" Margin="0,0,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtInstallPath" Style="{StaticResource VayuGlassTextBox}"
                                                     Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Style="{StaticResource VayuGlassButton}" Padding="16,10" Click="Browse_Click">
                                                <TextBlock Text="Browse..." FontSize="12" Foreground="{StaticResource VayuTextBrush}"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Shortcuts -->
                                <Border CornerRadius="12" Background="#0AFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1" Padding="20,16">
                                    <StackPanel>
                                        <TextBlock Text="SHORTCUT OPTIONS" Style="{StaticResource VayuLabel}" Margin="0,0,0,12"/>
                                        <CheckBox x:Name="ChkDesktopShortcut" Style="{StaticResource VayuGlassToggle}" 
                                                  Content="Create Desktop Shortcut" IsChecked="True" Margin="0,0,0,10"/>
                                        <CheckBox x:Name="ChkStartMenuShortcut" Style="{StaticResource VayuGlassToggle}" 
                                                  Content="Create Start Menu Shortcut" IsChecked="True"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource VayuGlassButton}" Padding="24,12" Margin="0,0,12,0" Click="OptionsBack_Click">
                                    <TextBlock Text="Back" FontSize="14" Foreground="{StaticResource VayuTextDimBrush}"/>
                                </Button>
                                <Button Style="{StaticResource VayuAccentButton}" Padding="32,12" Click="StartInstall_Click">
                                    <TextBlock Text="Install Now" FontSize="14" FontWeight="Bold" Foreground="White"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- ═══ SCREEN 2: PROGRESS ═══ -->
                        <Grid x:Name="ScreenProgress" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="32,0">
                                <Image Source="/Assets/Images/vayu_logo.png" Width="64" Height="64" Margin="0,0,0,20"
                                       HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>

                                <TextBlock x:Name="TxtProgressTitle" Text="Installing VayuClient..." Style="{StaticResource VayuH2}" 
                                           HorizontalAlignment="Center" Margin="0,0,0,24"/>

                                <!-- Progress Track -->
                                <Border CornerRadius="8" Height="10" Background="#15FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" 
                                        HorizontalAlignment="Stretch" Margin="0,0,0,12" ClipToBounds="True">
                                    <Border x:Name="ProgressBarFill" HorizontalAlignment="Left" Width="0" CornerRadius="8">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                <GradientStop Color="#2196F3" Offset="0"/>
                                                <GradientStop Color="#00D2FF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Border>

                                <Grid>
                                    <TextBlock x:Name="TxtProgressStatus" Text="Preparing installation..." Style="{StaticResource VayuCaption}" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="TxtProgressPercent" Text="0%" Style="{StaticResource VayuCaption}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- ═══ SCREEN 3: COMPLETED ═══ -->
                        <Grid x:Name="ScreenCompleted" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border Width="72" Height="72" CornerRadius="36" Background="#2000E676" BorderBrush="#4000E676" BorderThickness="1" 
                                        Margin="0,0,0,20" HorizontalAlignment="Center">
                                    <TextBlock Text="✓" FontSize="36" FontWeight="Bold" Foreground="{StaticResource VayuSuccessBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock x:Name="TxtCompletedHeader" Text="VayuClient Installed Successfully" Style="{StaticResource VayuH2}" HorizontalAlignment="Center"/>
                                <TextBlock Text="VayuClient is ready for action." Style="{StaticResource VayuBodyDim}" Margin="0,6,0,20" HorizontalAlignment="Center"/>

                                <CheckBox x:Name="ChkLaunchApp" Style="{StaticResource VayuGlassToggle}" 
                                          Content="Launch VayuClient now" IsChecked="True" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource VayuAccentButton}" Padding="36,12" Click="Finish_Click">
                                    <TextBlock Text="Finish" FontSize="14" FontWeight="Bold" Foreground="White"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- ═══ SCREEN 4: UNINSTALL ═══ -->
                        <Grid x:Name="ScreenUninstall" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500">
                                <Image Source="/Assets/Images/vayu_logo.png" Width="72" Height="72" Margin="0,0,0,16"
                                       HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>

                                <TextBlock Text="Uninstall VayuClient" Style="{StaticResource VayuH2}" HorizontalAlignment="Center"/>
                                <TextBlock Text="This will remove VayuClient application files and shortcuts from your system." 
                                           Style="{StaticResource VayuBodyDim}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,16"/>

                                <Border CornerRadius="10" Background="#1500E676" BorderBrush="#3000E676" BorderThickness="1" Padding="14,10">
                                    <TextBlock Text="✓ Your user profiles and Minecraft data in %APPDATA%\VayuClient will remain safe." 
                                               FontSize="12" Foreground="{StaticResource VayuSuccessBrush}" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource VayuGlassButton}" Padding="24,12" Margin="0,0,12,0" Click="Close_Click">
                                    <TextBlock Text="Cancel" FontSize="14" Foreground="{StaticResource VayuTextDimBrush}"/>
                                </Button>
                                <Button Style="{StaticResource VayuAccentButton}" Padding="28,12" Click="StartUninstall_Click">
                                    <TextBlock Text="Uninstall VayuClient" FontSize="14" FontWeight="Bold" Foreground="White"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                    </Grid>
                </Grid>

                <!-- ═══ MODAL OVERLAY: RUNNING PROCESS DETECTED ═══ -->
                <Grid x:Name="ModalRunningProcess" Visibility="Collapsed" Background="#C0080810">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="480"
                            CornerRadius="16" Background="#FF12121E" BorderBrush="#30FFFFFF" BorderThickness="1" Padding="28,24">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="25" ShadowDepth="0" Color="Black" Opacity="0.8"/>
                        </Border.Effect>

                        <StackPanel>
                            <Border Width="48" Height="48" CornerRadius="24" Background="#25FFAB40" BorderBrush="#50FFAB40" BorderThickness="1"
                                    HorizontalAlignment="Center" Margin="0,0,0,14">
                                <TextBlock Text="⚠" FontSize="24" Foreground="#FFAB40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="VayuClient is Running" Style="{StaticResource VayuH2}" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="VayuClient is currently active. Close it to proceed with the update." 
                                       Style="{StaticResource VayuBodyDim}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,20"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource VayuGlassButton}" Padding="20,10" Margin="0,0,12,0" Click="CancelProcessClose_Click">
                                    <TextBlock Text="Cancel" FontSize="13"/>
                                </Button>
                                <Button Style="{StaticResource VayuAccentButton}" Padding="24,10" Click="ConfirmProcessClose_Click">
                                    <TextBlock Text="Close &amp; Update" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>
        </Border>
    </Border>
</Window>
