<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- VayuClient Global Custom Font & Typography System (Installer)  -->
    <!-- Developer: ANSH9BOSS                                           -->
    <!-- ═══════════════════════════════════════════════════════════════ -->

    <!-- 1. Global Font Families (Pack URI embedded + Clean Fallback Chain) -->
    <FontFamily x:Key="VayuFontFamily">pack://application:,,,/Assets/Fonts/#Inter, pack://application:,,,/Assets/Fonts/#Inter Variable, Segoe UI Variable, Segoe UI, -apple-system, system-ui, Arial, sans-serif</FontFamily>
    <FontFamily x:Key="VayuFontPrimary">pack://application:,,,/Assets/Fonts/#Inter, pack://application:,,,/Assets/Fonts/#Inter Variable, Segoe UI Variable, Segoe UI, -apple-system, system-ui, Arial, sans-serif</FontFamily>
    <FontFamily x:Key="VayuFontDisplay">pack://application:,,,/Assets/Fonts/#Inter Display, pack://application:,,,/Assets/Fonts/#Inter, Segoe UI Variable Display, Segoe UI, Arial, sans-serif</FontFamily>
    <FontFamily x:Key="VayuFontMono">pack://application:,,,/Assets/Fonts/#JetBrains Mono, Cascadia Code, Consolas, Courier New, monospace</FontFamily>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 2. Typography Styles Hierarchy                                  -->
    <!-- ═══════════════════════════════════════════════════════════════ -->

    <!-- Display Text -->
    <Style x:Key="VayuDisplayText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource VayuFontDisplay}"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource VayuTextBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- Title Text -->
    <Style x:Key="VayuTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource VayuFontDisplay}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource VayuTextBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- Heading Text -->
    <Style x:Key="VayuHeadingText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource VayuFontPrimary}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource VayuTextBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- Body Text -->
    <Style x:Key="VayuBodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource VayuFontPrimary}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource VayuTextBrush}"/>
        <Setter Property="LineHeight" Value="20"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- Secondary Text -->
    <Style x:Key="VayuSecondaryText" TargetType="TextBlock" BasedOn="{StaticResource VayuBodyText}">
        <Setter Property="Foreground" Value="{StaticResource VayuTextDimBrush}"/>
    </Style>

    <!-- Caption Text -->
    <Style x:Key="VayuCaptionText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource VayuFontPrimary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource VayuTextDimBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- Button Text -->
    <Style x:Key="VayuButtonText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource VayuFontPrimary}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource VayuTextBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- Navigation Text -->
    <Style x:Key="VayuNavigationText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource VayuFontPrimary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource VayuTextDimBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- Monospace Text -->
    <Style x:Key="VayuMonoText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource VayuFontMono}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource VayuSecondaryBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 3. Compatibility Aliases                                        -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="VayuH1" TargetType="TextBlock" BasedOn="{StaticResource VayuDisplayText}"/>
    <Style x:Key="VayuH2" TargetType="TextBlock" BasedOn="{StaticResource VayuTitleText}"/>
    <Style x:Key="VayuH3" TargetType="TextBlock" BasedOn="{StaticResource VayuHeadingText}"/>
    <Style x:Key="VayuSubtitle" TargetType="TextBlock" BasedOn="{StaticResource VayuHeadingText}">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style x:Key="VayuBody" TargetType="TextBlock" BasedOn="{StaticResource VayuBodyText}"/>
    <Style x:Key="VayuBodyDim" TargetType="TextBlock" BasedOn="{StaticResource VayuSecondaryText}"/>
    <Style x:Key="VayuCaption" TargetType="TextBlock" BasedOn="{StaticResource VayuCaptionText}"/>
    <Style x:Key="VayuLabel" TargetType="TextBlock" BasedOn="{StaticResource VayuCaptionText}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="VayuMono" TargetType="TextBlock" BasedOn="{StaticResource VayuMonoText}"/>

</ResourceDictionary>
