<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>VayuClientSetup</RootNamespace>
    <AssemblyName>VayuClientSetup</AssemblyName>
    <Description>VayuClient Real Windows Installer by ANSH9BOSS</Description>
    <Company>ANSH9BOSS</Company>
    <Product>VayuClient Setup</Product>
    <Version>1.3.2</Version>
    <FileVersion>1.3.2</FileVersion>
    <AssemblyVersion>1.3.2</AssemblyVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\Images\vayu_logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Images\**" />
    <Resource Include="Assets\Fonts\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\VayuClientPayload.zip" Condition="Exists('Resources\VayuClientPayload.zip')" />
  </ItemGroup>

</Project>

















