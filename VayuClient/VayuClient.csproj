<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>VayuClient</RootNamespace>
    <AssemblyName>VayuClient</AssemblyName>
    <Description>VayuClient Ã¢â‚¬â€ Premium Minecraft Launcher by ANSH9BOSS</Description>
    <Company>ANSH9BOSS</Company>
    <Product>VayuClient</Product>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StartupObject>VayuClient.Program</StartupObject>
    <Version>1.5.1</Version>
    <FileVersion>1.5.1.0</FileVersion>
    <AssemblyVersion>1.5.1.0</AssemblyVersion>
    <InformationalVersion>1.5.1</InformationalVersion>
    <ApplicationIcon>Assets\Images\vayu_logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Images\**" />
    <Resource Include="Assets\Fonts\**" />
    <None Update="Assets\Images\vayu_logo.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\Images\vayu_logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

</Project>


















