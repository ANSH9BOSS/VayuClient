<Application x:Class="VayuClient.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:VayuClient.Converters"
             xmlns:vm="clr-namespace:VayuClient.ViewModels"
             xmlns:views="clr-namespace:VayuClient.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml"/>
                <ResourceDictionary Source="Themes/Typography.xaml"/>
                <ResourceDictionary Source="Themes/GlassStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Converters -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
            <converters:EqualValueToVisibilityConverter x:Key="EqualValueToVis"/>
            <converters:EqualValueToBoolConverter x:Key="EqualValueToBool"/>
            <converters:EqualValueToBoolConverter x:Key="StringEqualConverter"/>
            <converters:StringToInitialConverter x:Key="StringToInitial"/>
            <converters:SkinHeadImageConverter x:Key="SkinHeadImage"/>
            <converters:WebImageConverter x:Key="WebImage"/>
            <converters:BoolToOnlineStatusBrushConverter x:Key="BoolToOnlineStatusBrush"/>

            <!-- Implicit View-to-ViewModel Navigation DataTemplates -->
            <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                <views:HomePage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InstallationManagerViewModel}">
                <views:InstallationManagerPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ModsViewModel}">
                <views:ModsPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AccountsViewModel}">
                <views:AccountsPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:VersionsViewModel}">
                <views:VersionsPage/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
