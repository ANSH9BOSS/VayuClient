<UserControl x:Class="VayuClient.Controls.GlobalBottomDock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:VayuClient.Converters"
             xmlns:local="clr-namespace:VayuClient.Controls"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <converters:EqualValueToBoolConverter x:Key="EqualValueToBool"/>
        <converters:SkinHeadImageConverter x:Key="SkinHeadImage"/>
    </UserControl.Resources>

    <!-- Physical chassis container with satin obsidian material -->
    <Border Background="#F20A0D18" BorderThickness="1.2"
            CornerRadius="8" Padding="6,3" Height="38"
            HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#523B70" Offset="0.0"/>
                <GradientStop Color="#1E172B" Offset="0.45"/>
                <GradientStop Color="#0F101A" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.8" RenderingBias="Performance"/>
        </Border.Effect>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        
            <!-- 1. HOME TAB -->
            <RadioButton Style="{StaticResource VayuDockNavButton}"
                         IsChecked="{Binding CurrentPage, Converter={StaticResource EqualValueToBool}, ConverterParameter='Home', Mode=OneWay}"
                         Command="{Binding NavigateToCommand}" CommandParameter="Home" ToolTip="Home Dashboard">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource VayuIconHome}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                          Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="HOME" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>

            <!-- 2. INSTALLATION MANAGER TAB -->
            <RadioButton Style="{StaticResource VayuDockNavButton}"
                         IsChecked="{Binding CurrentPage, Converter={StaticResource EqualValueToBool}, ConverterParameter='InstallationManager', Mode=OneWay}"
                         Command="{Binding NavigateToCommand}" CommandParameter="InstallationManager" ToolTip="Installation Manager &amp; Instances">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource VayuIconInstances}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                          Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="INSTALLATION MANAGER" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>

            <!-- 3. MODS TAB -->
            <RadioButton Style="{StaticResource VayuDockNavButton}"
                         IsChecked="{Binding CurrentPage, Converter={StaticResource EqualValueToBool}, ConverterParameter='Mods', Mode=OneWay}"
                         Command="{Binding NavigateToCommand}" CommandParameter="Mods" ToolTip="Modifications &amp; Add-ons">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource VayuIconMods}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                          Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="MODS" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>

            <!-- 4. SERVERS TAB -->
            <RadioButton Style="{StaticResource VayuDockNavButton}"
                         IsChecked="{Binding CurrentPage, Converter={StaticResource EqualValueToBool}, ConverterParameter='Servers', Mode=OneWay}"
                         Command="{Binding NavigateToCommand}" CommandParameter="Servers" ToolTip="Server Browser &amp; Multiplayer">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource VayuIconServer}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                          Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="SERVERS" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>

            <!-- Subtle Vertical Micro-Divider -->
            <Rectangle Width="1" Height="16" Fill="#232C40" Margin="6,0" VerticalAlignment="Center"/>

            <!-- 5. SETTINGS TAB (Utility) -->
            <RadioButton Style="{StaticResource VayuDockNavButton}"
                         IsChecked="{Binding CurrentPage, Converter={StaticResource EqualValueToBool}, ConverterParameter='Settings', Mode=OneWay}"
                         Command="{Binding NavigateToCommand}" CommandParameter="Settings" ToolTip="Launcher &amp; Game Settings">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource VayuIconSettings}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                          Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="SETTINGS" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>

            <!-- 6. ACCOUNT TAB (Profile Control) -->
            <RadioButton Style="{StaticResource VayuDockNavButton}"
                         IsChecked="{Binding CurrentPage, Converter={StaticResource EqualValueToBool}, ConverterParameter='Accounts', Mode=OneWay}"
                         Command="{Binding NavigateToCommand}" CommandParameter="Accounts" ToolTip="Player Account &amp; Profiles">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="18" Height="18" CornerRadius="4" Background="#141B29" BorderBrush="#2A354C" BorderThickness="1" Margin="0,0,6,0" VerticalAlignment="Center" ClipToBounds="True">
                        <local:PlayerBody3D Profile="{Binding ActiveProfile}" DisplayMode="HeadOnly"/>
                    </Border>
                    <TextBlock Text="{Binding ActiveProfileUsernameDisplay, FallbackValue='ACCOUNT'}" MaxWidth="90" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>

        </StackPanel>
    </Border>
</UserControl>
