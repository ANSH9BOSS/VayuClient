<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- VAYU CLIENT — 3D OBSIDIAN + ELECTRIC PURPLE COLOR SYSTEM         -->
    <!-- Developer: ANSH9BOSS                                            -->
    <!-- ═══════════════════════════════════════════════════════════════ -->

    <!-- Base 3D Dark Obsidian Backgrounds -->
    <Color x:Key="VayuDarkColor">#06070B</Color>
    <Color x:Key="VayuBgAltColor">#0A0D16</Color>
    <Color x:Key="VayuBgDarkColor">#080A10</Color>
    <Color x:Key="VayuSidebarColor">#06070B</Color>

    <!-- Secondary 3D Panels & Layered Surfaces -->
    <Color x:Key="VayuSurfaceColor">#0F0C1B</Color>
    <Color x:Key="VayuSurfaceLightColor">#161228</Color>
    <Color x:Key="VayuSurfaceElevatedColor">#1C1633</Color>

    <!-- Dimensional Glass & Bevel Surfaces -->
    <Color x:Key="VayuGlassColor">#0E0A1A</Color>
    <Color x:Key="VayuGlassHoverColor">#1A1230</Color>
    <Color x:Key="VayuGlassActiveColor">#241445</Color>
    <Color x:Key="VayuGlassCardColor">#0D0918</Color>
    <Color x:Key="VayuGlassBorderColor">#1F1733</Color>
    <Color x:Key="VayuGlassBorderHoverColor">#582C99</Color>
    <Color x:Key="VayuGlassHighlightColor">#40FFFFFF</Color>

    <!-- Electric Purple & Crisp White Brand Accents -->
    <Color x:Key="VayuAccentColor">#A855F7</Color>
    <Color x:Key="VayuBrightBlueColor">#A855F7</Color> <!-- Mapped to Electric Purple -->
    <Color x:Key="VayuLightBlueColor">#C084FC</Color>
    <Color x:Key="VayuWhiteColor">#FFFFFF</Color>
    <Color x:Key="VayuAccentLightColor">#C084FC</Color>
    <Color x:Key="VayuAccentDarkColor">#7C3AED</Color>
    <Color x:Key="VayuAccentGlowColor">#60A855F7</Color>
    <Color x:Key="VayuSecondaryColor">#7C3AED</Color>
    <Color x:Key="VayuOrangeHighlightColor">#D8B4FE</Color>

    <!-- High-Contrast 3D Text Tokens -->
    <Color x:Key="VayuTextColor">#FFFFFF</Color>
    <Color x:Key="VayuTextDimColor">#9E94B8</Color>
    <Color x:Key="VayuTextMutedColor">#6C6382</Color>
    <Color x:Key="VayuBorderColor">#1E1730</Color>
    <Color x:Key="VayuHoverColor">#1A1230</Color>
    <Color x:Key="VayuSelectedColor">#A855F7</Color>

    <!-- Semantic Status Tokens -->
    <Color x:Key="VayuSuccessColor">#10B981</Color>
    <Color x:Key="VayuWarningColor">#F59E0B</Color>
    <Color x:Key="VayuErrorColor">#EF4444</Color>
    <Color x:Key="VayuInfoColor">#A855F7</Color>

    <!-- ═══ Solid Brushes ═══ -->
    <SolidColorBrush x:Key="VayuDarkBrush" Color="{StaticResource VayuDarkColor}"/>
    <SolidColorBrush x:Key="VayuBgAltBrush" Color="{StaticResource VayuBgAltColor}"/>
    <SolidColorBrush x:Key="VayuBgDarkBrush" Color="{StaticResource VayuBgDarkColor}"/>
    <SolidColorBrush x:Key="VayuSurfaceBrush" Color="{StaticResource VayuSurfaceColor}"/>
    <SolidColorBrush x:Key="VayuSurfaceLightBrush" Color="{StaticResource VayuSurfaceLightColor}"/>
    <SolidColorBrush x:Key="VayuSurfaceElevatedBrush" Color="{StaticResource VayuSurfaceElevatedColor}"/>
    <SolidColorBrush x:Key="VayuSidebarBrush" Color="{StaticResource VayuSidebarColor}"/>
    <SolidColorBrush x:Key="VayuBorderBrush" Color="{StaticResource VayuBorderColor}"/>
    <SolidColorBrush x:Key="VayuHoverBrush" Color="{StaticResource VayuHoverColor}"/>
    <SolidColorBrush x:Key="VayuSelectedBrush" Color="{StaticResource VayuSelectedColor}"/>

    <SolidColorBrush x:Key="VayuGlassBrush" Color="{StaticResource VayuGlassColor}"/>
    <SolidColorBrush x:Key="VayuGlassHoverBrush" Color="{StaticResource VayuGlassHoverColor}"/>
    <SolidColorBrush x:Key="VayuGlassActiveBrush" Color="{StaticResource VayuGlassActiveColor}"/>
    <SolidColorBrush x:Key="VayuGlassCardBrush" Color="{StaticResource VayuGlassCardColor}"/>
    <SolidColorBrush x:Key="VayuGlassBorderBrush" Color="{StaticResource VayuGlassBorderColor}"/>
    <SolidColorBrush x:Key="VayuGlassBorderHoverBrush" Color="{StaticResource VayuGlassBorderHoverColor}"/>

    <SolidColorBrush x:Key="VayuAccentBrush" Color="{StaticResource VayuAccentColor}"/>
    <SolidColorBrush x:Key="VayuBrightBlueBrush" Color="{StaticResource VayuBrightBlueColor}"/>
    <SolidColorBrush x:Key="VayuLightBlueBrush" Color="{StaticResource VayuLightBlueColor}"/>
    <SolidColorBrush x:Key="VayuWhiteBrush" Color="{StaticResource VayuWhiteColor}"/>
    <SolidColorBrush x:Key="VayuAccentLightBrush" Color="{StaticResource VayuAccentLightColor}"/>
    <SolidColorBrush x:Key="VayuAccentDarkBrush" Color="{StaticResource VayuAccentDarkColor}"/>
    <SolidColorBrush x:Key="VayuAccentGlowBrush" Color="{StaticResource VayuAccentGlowColor}"/>
    <SolidColorBrush x:Key="VayuSecondaryBrush" Color="{StaticResource VayuSecondaryColor}"/>
    <SolidColorBrush x:Key="VayuOrangeHighlightBrush" Color="{StaticResource VayuOrangeHighlightColor}"/>

    <SolidColorBrush x:Key="VayuTextBrush" Color="{StaticResource VayuTextColor}"/>
    <SolidColorBrush x:Key="VayuTextDimBrush" Color="{StaticResource VayuTextDimColor}"/>
    <SolidColorBrush x:Key="VayuTextMutedBrush" Color="{StaticResource VayuTextMutedColor}"/>

    <SolidColorBrush x:Key="VayuSuccessBrush" Color="{StaticResource VayuSuccessColor}"/>
    <SolidColorBrush x:Key="VayuWarningBrush" Color="{StaticResource VayuWarningColor}"/>
    <SolidColorBrush x:Key="VayuErrorBrush" Color="{StaticResource VayuErrorColor}"/>
    <SolidColorBrush x:Key="VayuInfoBrush" Color="{StaticResource VayuInfoColor}"/>

    <!-- Category tag brushes -->
    <SolidColorBrush x:Key="VayuPurpleAccentBrush" Color="#A855F7"/>
    <SolidColorBrush x:Key="VayuCyanAccentBrush" Color="#38BDF8"/>
    <SolidColorBrush x:Key="VayuGreenAccentBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="VayuBlueAccentBrush" Color="#6366F1"/>

    <!-- ═══ 3D Bevel & Dimensional Gradients ═══ -->
    <LinearGradientBrush x:Key="VayuBackgroundGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#06070B" Offset="0.0"/>
        <GradientStop Color="#0A0D16" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="VayuSidebarGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#06070B" Offset="0.0"/>
        <GradientStop Color="#050508" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="VayuAccentGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#7C3AED" Offset="0.0"/>
        <GradientStop Color="#A855F7" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="VayuPlayGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#4C1D95" Offset="0.0"/>
        <GradientStop Color="#8B5CF6" Offset="0.7"/>
        <GradientStop Color="#A855F7" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="VayuHeroGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#140D26" Offset="0.0"/>
        <GradientStop Color="#0A0D16" Offset="0.6"/>
        <GradientStop Color="#06070B" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- 3D Dimensional Card Surface (Top-lit Bevel) -->
    <LinearGradientBrush x:Key="VayuCardGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#140E24" Offset="0.0"/>
        <GradientStop Color="#0C0817" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Vayu3DButtonTopBevel" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#281A42" Offset="0.0"/>
        <GradientStop Color="#130B22" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Vayu3DButtonAccentBevel" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#C084FC" Offset="0.0"/>
        <GradientStop Color="#8B5CF6" Offset="0.3"/>
        <GradientStop Color="#6D28D9" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Vayu3DBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3E206A" Offset="0.0"/>
        <GradientStop Color="#181128" Offset="1.0"/>
    </LinearGradientBrush>

</ResourceDictionary>
