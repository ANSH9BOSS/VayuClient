    <!-- 1. GLOBAL DEFAULT CONTROL STYLES (Universal Font Inheritance)   -->
    <!-- ═══════════════════════════════════════════════════════════════ -->

    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource VayuFontFamily}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style TargetType="UserControl">
        <Setter Property="FontFamily" Value="{StaticResource VayuFontFamily}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style TargetType="Page">
        <Setter Property="FontFamily" Value="{StaticResource VayuFontFamily}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource VayuFontFamily}"/>
        <Setter Property="Foreground" Value="{StaticResource VayuTextBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource VayuFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="#151F32"/>
        <Setter Property="Foreground" Value="{StaticResource VayuTextBrush}"/>
        <Setter Property="BorderBrush" Value="#243247"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="FontFamily" Value="{StaticResource VayuFontFamily}"/>
        <Setter Property="Background" Value="#151F32"/>
        <Setter Property="Foreground" Value="{StaticResource VayuTextBrush}"/>
        <Setter Property="BorderBrush" Value="#243247"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="FontFamily" Value="{StaticResource VayuFontFamily}"/>
        <Setter Property="Foreground" Value="{StaticResource VayuTextBrush}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="FontFamily" Value="{StaticResource VayuFontFamily}"/>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="FontFamily" Value="{StaticResource VayuFontFamily}"/>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="FontFamily" Value="{StaticResource VayuFontFamily}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- 2. SCROLLBAR & SCROLLVIEWER STYLES              -->
    <!-- ═══════════════════════════════════════════════ -->

    <Style x:Key="VayuScrollBar" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="true">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border CornerRadius="3" Background="#243247"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar" BasedOn="{StaticResource VayuScrollBar}"/>

    <Style x:Key="VayuScrollViewer" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Style.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource VayuScrollBar}"/>
        </Style.Resources>
    </Style>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- 3. BUTTON STYLES                                -->
    <!-- ═══════════════════════════════════════════════ -->

    <!-- Standard Dark Action Button -->
    <Style x:Key="VayuDarkButton" TargetType="Button">
        <Setter Property="Background" Value="#151F32"/>
        <Setter Property="Foreground" Value="{StaticResource VayuTextBrush}"/>
        <Setter Property="BorderBrush" Value="#243247"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="FontFamily" Value="{StaticResource VayuFontFamily}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="4"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1E3A66"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#0F172A"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Blue Accent Button (Save, Create Instance, Add Mod) -->
    <Style x:Key="VayuAccentButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource VayuAccentGradient}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#3B82F6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,7"/>
        <Setter Property="FontFamily" Value="{StaticResource VayuFontFamily}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="4"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#3B82F6"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#60A5FA"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary Button (Alias for Accent Button) -->
    <Style x:Key="VayuPrimaryButton" TargetType="Button" BasedOn="{StaticResource VayuAccentButton}"/>

    <!-- Danger Button (Delete) -->
    <Style x:Key="VayuDangerButton" TargetType="Button">
        <Setter Property="Background" Value="#1C1824"/>
        <Setter Property="Foreground" Value="#EF4444"/>
        <Setter Property="BorderBrush" Value="#3B2028"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="FontFamily" Value="{StaticResource VayuFontFamily}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="4"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#EF4444"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#EF4444"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#B91C1C"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Legacy Button Aliases -->
    <Style x:Key="VayuGlassButton" TargetType="Button" BasedOn="{StaticResource VayuDarkButton}"/>
    <Style x:Key="VayuGhostButton" TargetType="Button" BasedOn="{StaticResource VayuDarkButton}"/>

    <!-- Large Premium Blue PLAY Button (#2563EB -> #3B82F6) -->
    <Style x:Key="VayuPlayButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource VayuPlayGradient}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#3B82F6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="20,12">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#3B82F6"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#60A5FA"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#1E293B"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#334155"/>
                            <Setter Property="Foreground" Value="#64748B"/>
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

