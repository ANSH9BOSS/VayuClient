    <!-- ═══════════════════════════════════════════════ -->
    <!-- 2. SCROLLBAR & SCROLLVIEWER STYLES              -->
    <!-- ═══════════════════════════════════════════════ -->

    <Style x:Key="VayuScrollBar" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="true">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border CornerRadius="3" Background="#243247"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar" BasedOn="{StaticResource VayuScrollBar}"/>

    <Style x:Key="VayuScrollViewer" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Style.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource VayuScrollBar}"/>
        </Style.Resources>
    </Style>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- 3. BUTTON STYLES                                -->
    <!-- ═══════════════════════════════════════════════ -->

    <!-- Standard Dark 3D Action Button -->
    <Style x:Key="VayuDarkButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Vayu3DButtonTopBevel}"/>
        <Setter Property="Foreground" Value="{StaticResource VayuTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Vayu3DBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1.2"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="FontFamily" Value="{StaticResource VayuFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.4"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#25183E"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#A855F7"/>
                            <Setter TargetName="Bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#A855F7" BlurRadius="12" ShadowDepth="1" Opacity="0.45"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="1.5"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Bd" Property="Background" Value="#0E0818"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 3D Electric Purple Accent Button (Save, Create Instance, Add Mod) -->
    <Style x:Key="VayuAccentButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Vayu3DButtonAccentBevel}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#D8B4FE"/>
        <Setter Property="BorderThickness" Value="1.2"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontFamily" Value="{StaticResource VayuFontFamily}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect Color="#7C3AED" BlurRadius="14" ShadowDepth="2" Opacity="0.5"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FFFFFF"/>
                            <Setter TargetName="Bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#A855F7" BlurRadius="20" ShadowDepth="2" Opacity="0.75"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="1.5"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Bd" Property="Background" Value="#581C87"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary Button (Alias for Accent Button) -->
    <Style x:Key="VayuPrimaryButton" TargetType="Button" BasedOn="{StaticResource VayuAccentButton}"/>

    <!-- 3D Reusable Button Styles -->
    <Style x:Key="Vayu3DButton" TargetType="Button" BasedOn="{StaticResource VayuDarkButton}"/>
    <Style x:Key="Vayu3DPrimaryButton" TargetType="Button" BasedOn="{StaticResource VayuAccentButton}"/>

    <!-- Danger Button (Delete) -->
    <Style x:Key="VayuDangerButton" TargetType="Button">
        <Setter Property="Background" Value="#190C14"/>
        <Setter Property="Foreground" Value="#EF4444"/>
        <Setter Property="BorderBrush" Value="#4C1D24"/>
        <Setter Property="BorderThickness" Value="1.2"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="FontFamily" Value="{StaticResource VayuFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect Color="#EF4444" BlurRadius="8" ShadowDepth="1" Opacity="0.25"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#EF4444"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FCA5A5"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter TargetName="Bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#EF4444" BlurRadius="14" ShadowDepth="1" Opacity="0.5"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="1.5"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Bd" Property="Background" Value="#B91C1C"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Legacy Button Aliases -->
    <Style x:Key="VayuGlassButton" TargetType="Button" BasedOn="{StaticResource VayuDarkButton}"/>
    <Style x:Key="VayuGhostButton" TargetType="Button" BasedOn="{StaticResource VayuDarkButton}"/>

    <!-- Icon Button Style (Compact utility buttons for lists) -->
    <Style x:Key="VayuIconButton" TargetType="Button">
        <Setter Property="Background" Value="#100A1D"/>
        <Setter Property="Foreground" Value="{StaticResource VayuTextDimBrush}"/>
        <Setter Property="BorderBrush" Value="#25183E"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="FontFamily" Value="{StaticResource VayuFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="5"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#221338"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#A855F7"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#0D0717"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Large Premium Purple PLAY Button -->
    <Style x:Key="VayuPlayButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource VayuPlayGradient}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#D8B4FE"/>
        <Setter Property="BorderThickness" Value="1.2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="22,12">
                        <Border.Effect>
                            <DropShadowEffect Color="#A855F7" BlurRadius="20" ShadowDepth="2" Opacity="0.55"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FFFFFF"/>
                            <Setter TargetName="Bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#A855F7" BlurRadius="26" ShadowDepth="2" Opacity="0.8"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#581C87"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#140D26"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#2E1B4E"/>
                            <Setter Property="Foreground" Value="#6C6382"/>
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- 4. CHECKBOX / TOGGLE SWITCH STYLES              -->
    <!-- ═══════════════════════════════════════════════ -->

    <Style x:Key="VayuToggleCheckbox" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource VayuFontFamily}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource VayuTextDimBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" Background="#0C0816" BorderBrush="#25183E" BorderThickness="1.2" Margin="0,0,8,0">
                            <Path x:Name="CheckMark" Data="{StaticResource VayuIconCheck}" Fill="#FFFFFF" Width="11" Height="11" Stretch="Uniform" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TxtState" Text="Disabled" FontSize="12" Foreground="{StaticResource VayuTextDimBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="#8B5CF6"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="#A855F7"/>
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="TxtState" Property="Text" Value="Enabled"/>
                            <Setter TargetName="TxtState" Property="Foreground" Value="{StaticResource VayuTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="#A855F7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 3D Tactile Cyber Toggle Switch -->
    <Style x:Key="VayuToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="40" Height="22" Background="Transparent">
                        <Border x:Name="Track" Background="#0F0A1C" BorderBrush="#261640" BorderThickness="1.2" CornerRadius="11">
                            <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="#7D7596" HorizontalAlignment="Left" Margin="2,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.5"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="#2E1254"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="#A855F7"/>
                            <Setter TargetName="Track" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#A855F7" BlurRadius="10" ShadowDepth="0" Opacity="0.55"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="#C084FC"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Vayu3DToggle" TargetType="CheckBox" BasedOn="{StaticResource VayuToggleSwitch}"/>

    <Style x:Key="VayuCheckBox" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource VayuFontFamily}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource VayuTextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" Background="#0C0816" BorderBrush="#25183E" BorderThickness="1.2" Margin="0,0,10,0">
                            <Path x:Name="CheckMark" Data="{StaticResource VayuIconCheck}" Fill="#FFFFFF" Width="11" Height="11" Stretch="Uniform" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="#8B5CF6"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="#A855F7"/>
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="#A855F7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- 5. COMBOBOX DROPDOWN STYLES                     -->
    <!-- ═══════════════════════════════════════════════ -->

    <Style x:Key="VayuComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{StaticResource VayuTextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource VayuFontFamily}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="3" Margin="2,1">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#241445"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#7C3AED"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="VayuComboBoxToggleButton" TargetType="ToggleButton">
        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="4" Padding="{TemplateBinding Padding}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#94A3B8"
                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#A855F7"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#C084FC"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="VayuComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="#0F0A1C"/>
        <Setter Property="Foreground" Value="{StaticResource VayuTextBrush}"/>
        <Setter Property="BorderBrush" Value="#25183E"/>
        <Setter Property="BorderThickness" Value="1.2"/>
        <Setter Property="FontFamily" Value="{StaticResource VayuFontFamily}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource VayuComboBoxItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton"
                                      Template="{StaticResource VayuComboBoxToggleButton}"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Focusable="False"
                                      IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press"/>

                        <ContentPresenter x:Name="ContentSite"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="12,0,28,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"/>

                        <Popup x:Name="Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Grid x:Name="DropDown"
                                  SnapsToDevicePixels="True"
                                  MinWidth="{TemplateBinding ActualWidth}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                  Margin="0,4,0,8">
                                <Border x:Name="DropDownBorder"
                                        Background="#120D22"
                                        BorderBrush="#38205C"
                                        BorderThickness="1.2"
                                        CornerRadius="8"
                                        Padding="4">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.6"/>
                                    </Border.Effect>
                                    <ScrollViewer Style="{StaticResource VayuScrollViewer}" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="DropDownBorder" Property="MinHeight" Value="60"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ToggleButton" Property="BorderBrush" Value="#A855F7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- All normal dropdowns inherit the same 3D material unless a page opts out. -->
    <Style x:Key="Vayu3DComboBox" TargetType="ComboBox" BasedOn="{StaticResource VayuComboBox}"/>
    <Style TargetType="ComboBox" BasedOn="{StaticResource Vayu3DComboBox}"/>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource VayuComboBoxItem}"/>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- 6. TEXTBOX STYLES                               -->
    <!-- ═══════════════════════════════════════════════ -->

    <Style x:Key="VayuGlassTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="#090611"/>
        <Setter Property="Foreground" Value="{StaticResource VayuTextBrush}"/>
        <Setter Property="BorderBrush" Value="#1F1733"/>
        <Setter Property="BorderThickness" Value="1.2"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="{StaticResource VayuFontFamily}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="CaretBrush" Value="#A855F7"/>
        <Setter Property="SelectionBrush" Value="#60A855F7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"
                                      VerticalAlignment="Center"
                                      Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#A855F7"/>
                            <Setter TargetName="Bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#A855F7" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VayuTextBox" TargetType="TextBox" BasedOn="{StaticResource VayuGlassTextBox}"/>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- 7. LISTVIEW STYLES                              -->
    <!-- ═══════════════════════════════════════════════ -->

    <Style x:Key="VayuListView" TargetType="ListView">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource VayuTextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource VayuFontFamily}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListViewItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,3"/>
                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Border x:Name="ItemBorder" CornerRadius="8"
                                        Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="#17102A"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="#251642"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- 8. SLIDER STYLE                                 -->
    <!-- ═══════════════════════════════════════════════ -->

    <Style x:Key="VayuGlassSlider" TargetType="Slider">
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="6" CornerRadius="3" Background="#110A1E" BorderBrush="#261640" BorderThickness="1"/>
                        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Focusable="False" IsTabStop="False" Cursor="Hand">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="6" CornerRadius="3" Background="#7C3AED" BorderBrush="#A855F7" BorderThickness="1"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="20" Height="20" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <Ellipse Fill="#8B5CF6" Stroke="#C084FC" StrokeThickness="1.5" Width="20" Height="20">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="#A855F7" BlurRadius="10" ShadowDepth="0" Opacity="0.75"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                                <Ellipse Fill="#FFFFFF" Width="6" Height="6"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Focusable="False" IsTabStop="False" Cursor="Hand">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="6" Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Vayu3DSlider" TargetType="Slider" BasedOn="{StaticResource VayuGlassSlider}"/>
    <Style TargetType="Slider" BasedOn="{StaticResource Vayu3DSlider}"/>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- 8b. WINDOW TITLE BAR BUTTONS                    -->
    <!-- ═══════════════════════════════════════════════ -->

    <Style x:Key="TitleBarButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource VayuTextDimBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4" Margin="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#1C1430"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#0E0818"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TitleBarCloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Margin="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#EF4444"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#DC2626"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- 9. FLOATING BOTTOM DOCK NAVIGATION BUTTONS      -->
    <!-- ═══════════════════════════════════════════════ -->

    <Style x:Key="VayuDockNavButton" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#7D8B9F"/>
        <Setter Property="FontFamily" Value="{StaticResource VayuFontFamily}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Margin" Value="1,0"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <ControlTemplate.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <Setter Property="FontWeight" Value="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <Setter Property="FontFamily" Value="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </Style>
                    </ControlTemplate.Resources>
                    <Border x:Name="Bd" CornerRadius="4" Background="{TemplateBinding Background}" 
                            BorderBrush="Transparent" BorderThickness="0,0,0,2" 
                            Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#131926"/>
                            <Setter Property="Foreground" Value="#E2E8F0"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#182030" Offset="0.0"/>
                                        <GradientStop Color="#111622" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#A855F7"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="1"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LunarNavButton" TargetType="RadioButton" BasedOn="{StaticResource VayuDockNavButton}"/>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- 9b. VAYU TAB RADIO BUTTON (FOR DIALOGS & PAGES)  -->
    <!-- ═══════════════════════════════════════════════ -->

    <Style x:Key="VayuTabRadioButton" TargetType="RadioButton">
        <Setter Property="Background" Value="#0F0A1C"/>
        <Setter Property="BorderBrush" Value="#1F1733"/>
        <Setter Property="BorderThickness" Value="1.2"/>
        <Setter Property="Foreground" Value="#9E94B8"/>
        <Setter Property="FontFamily" Value="{StaticResource VayuFontFamily}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1A1230"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#5B2EA6"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#281447"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#A855F7"/>
                            <Setter TargetName="Bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#A855F7" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- 10. LUNAR HERO GLOWING PLAY BUTTON              -->
    <!-- ═══════════════════════════════════════════════ -->

    <Style x:Key="LunarHeroPlayButton" TargetType="Button" BasedOn="{StaticResource VayuPlayButton}"/>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- 11. 3D OBSIDIAN CARD                            -->
    <!-- ═══════════════════════════════════════════════ -->

    <Style x:Key="LunarCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource VayuCardGradient}"/>
        <Setter Property="BorderBrush" Value="#1F1733"/>
        <Setter Property="BorderThickness" Value="1.2"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="3" Opacity="0.45"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Vayu3DCard" TargetType="Border" BasedOn="{StaticResource LunarCard}"/>

</ResourceDictionary>
