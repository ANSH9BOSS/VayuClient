<UserControl x:Class="VayuClient.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:VayuClient.Core"
             mc:Ignorable="d"
             d:DesignHeight="780" d:DesignWidth="1200"
             Background="#070B14">

    <Grid>
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- 1. FULL-BLEED CINEMATIC MINECRAFT HERO BACKGROUND               -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid>
            <!-- High-Resolution Minecraft Dynamic Landscape Art -->
            <Image Source="{Binding HeroBackgroundPath}" 
                   Stretch="UniformToFill" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- Layer 1: Dark Vignette Gradient -->
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.75" RadiusY="0.75">
                        <GradientStop Color="#10070B14" Offset="0.0"/>
                        <GradientStop Color="#90070B14" Offset="0.6"/>
                        <GradientStop Color="#F0070B14" Offset="1.0"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Layer 2: Bottom Fade to Deep Dark Navy Base -->
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#30070B14" Offset="0.0"/>
                        <GradientStop Color="#60070B14" Offset="0.45"/>
                        <GradientStop Color="#E6070B14" Offset="0.8"/>
                        <GradientStop Color="#FF070B14" Offset="1.0"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- 2. HERO FOREGROUND CONTENT & CENTERPIECE PLAY EXPERIENCE        -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Margin="36,24,36,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Top Metadata / Quick Tags -->
                <RowDefinition Height="*"/>    <!-- Centerpiece Hero Stack (Name + PLAY CTA) -->
                <RowDefinition Height="Auto"/> <!-- Bottom Floating Instance Dock -->
            </Grid.RowDefinitions>

            <!-- ─── TOP STATUS BADGE & WALLPAPER SWITCHER ─── -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Border Background="#990F172A" BorderBrush="#333B82F6" BorderThickness="1" CornerRadius="14" Padding="10,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{Binding HasActiveInstance, Converter={StaticResource BoolToOnlineStatusBrush}}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ActiveInstanceSubtitle, FallbackValue='No Minecraft installation selected'}" 
                                       FontSize="11.5" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Wallpaper Theme Changer Button -->
                <Button Grid.Column="1" Command="{Binding CycleWallpaperCommand}" 
                        Style="{StaticResource VayuDarkButton}" Padding="10,4" ToolTip="Cycle Minecraft wallpaper theme">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🎨" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Change Theme" FontSize="10.5" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ─── CENTERPIECE HERO STACK (Instance Info + Glowing Play Button) ─── -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,20">

                <!-- Loader & Version Pill Row -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12"
                            Visibility="{Binding HasActiveInstance, Converter={StaticResource BoolToVis}}">
                    
                    <!-- Loader Tag -->
                    <Border Background="#2563EB" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                        <TextBlock Text="{Binding ActiveLoaderDisplay}" FontSize="11" FontWeight="Black" Foreground="#FFFFFF"/>
                    </Border>

                    <!-- Version Tag -->
                    <Border Background="#991E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                        <TextBlock Text="{Binding ActiveVersionDisplay}" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0"/>
                    </Border>

                    <!-- RAM Tag -->
                    <Border Background="#991E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                        <TextBlock Text="{Binding ActiveRamDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                    </Border>

                    <!-- Java Status Tag -->
                    <Border Background="#991E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="8,3">
                        <TextBlock Text="{Binding JavaStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="#22C55E"/>
                    </Border>
                </StackPanel>

                <!-- Instance Name (Large Bold Title) -->
                <TextBlock Text="{Binding ActiveInstanceName, FallbackValue='No Minecraft installation selected'}" 
                           FontSize="32" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center" 
                           TextAlignment="Center" MaxWidth="800" TextTrimming="CharacterEllipsis" Margin="0,0,0,6">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="3" Opacity="0.8"/>
                    </TextBlock.Effect>
                </TextBlock>

                <TextBlock Text="Ready for your next adventure with seamless performance and isolated mods." 
                           FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,24"
                           Visibility="{Binding HasActiveInstance, Converter={StaticResource BoolToVis}}"/>
                
                <TextBlock Text="Create your first isolated Minecraft instance or explore modpacks to get started." 
                           FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,24"
                           Visibility="{Binding HasActiveInstance, Converter={StaticResource InverseBoolToVis}}"/>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!-- HUGE LUNAR GLOWING PLAY BUTTON (The Visual CTA)         -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <Grid HorizontalAlignment="Center">
                    
                    <Button Command="{Binding PlayCommand}" Style="{StaticResource LunarHeroPlayButton}" 
                            Width="320" Height="64" Padding="0">
                        <Button.Effect>
                            <DropShadowEffect Color="#2563EB" BlurRadius="28" ShadowDepth="2" Opacity="0.6"/>
                        </Button.Effect>
                        
                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            
                            <!-- State 1: Ready / Play / In-Game CTA -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}">
                                
                                <Path Data="{StaticResource VayuIconPlay}" Fill="#FFFFFF" Width="16" Height="16" Stretch="Uniform" 
                                      Margin="0,0,12,0" VerticalAlignment="Center"
                                      Visibility="{Binding HasActiveInstance, Converter={StaticResource BoolToVis}}"/>
                                
                                <Path Data="{StaticResource VayuIconPlus}" Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" 
                                      Margin="0,0,12,0" VerticalAlignment="Center"
                                      Visibility="{Binding HasActiveInstance, Converter={StaticResource InverseBoolToVis}}"/>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PlayButtonText, FallbackValue='PLAY'}" 
                                               FontSize="16.5" FontWeight="Black" Foreground="#FFFFFF"/>
                                    <TextBlock Text="{Binding PlayButtonSubText, FallbackValue='READY TO LAUNCH'}" 
                                               FontSize="9.5" FontWeight="Bold" Foreground="#BFDBFE" Margin="0,1,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- State 2: Starting / Initializing Indicator -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding PlayButtonText, FallbackValue='LAUNCHING...'}" 
                                           FontSize="14" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding ProgressStatus, FallbackValue='Preparing engine...'}" 
                                           FontSize="9.5" FontWeight="SemiBold" Foreground="#93C5FD" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>

                        </Grid>
                    </Button>
                </Grid>

                <!-- ═══════════════════════════════════════════════════════════════════════ -->
                <!-- ═══ LIVE LAUNCH & DOWNLOAD PROGRESS CARD (Active During Launch) ═════ -->
                <!-- ═══════════════════════════════════════════════════════════════════════ -->
                <Border Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVis}}"
                        Width="420" CornerRadius="8" Background="#E00B1220" BorderBrush="#2563EB" BorderThickness="1.5"
                        Padding="16,12" Margin="0,16,0,0" HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#2563EB" BlurRadius="18" ShadowDepth="2" Opacity="0.4"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Header & Cancel -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="8" Height="8" CornerRadius="4" Background="#38BDF8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="LAUNCH PROGRESS" FontSize="11" FontWeight="Black" Foreground="#38BDF8" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Grid.Column="1" Command="{Binding CancelLaunchCommand}"
                                    Style="{StaticResource VayuDarkButton}" Padding="8,3" FontSize="10.5" ToolTip="Cancel current launch">
                                <TextBlock Text="Cancel" Foreground="#EF4444" FontWeight="Bold"/>
                            </Button>
                        </Grid>

                        <!-- Operation Text -->
                        <TextBlock Text="{Binding ProgressStatus, FallbackValue='Downloading Minecraft assets...'}" 
                                   FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>

                        <!-- High Quality Progress Bar -->
                        <ProgressBar Value="{Binding ProgressPercentage}" Minimum="0" Maximum="100" 
                                     Height="6" Margin="0,4,0,6" 
                                     Foreground="{StaticResource VayuBrightBlueBrush}" Background="#1E293B" BorderThickness="0"/>

                        <!-- Details & Speed -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding ProgressDetail}" FontSize="10.5" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding ProgressPercentage, StringFormat={}{0:F0}%}" FontSize="11" FontWeight="Black" Foreground="#60A5FA" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding ProgressSpeed}" FontSize="10.5" FontWeight="SemiBold" Foreground="#34D399"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════════════════════ -->
                <!-- ═══ LIVE IN-GAME SESSION CONTROLLER (Active When Game Is Running) ═══ -->
                <!-- ═══════════════════════════════════════════════════════════════════════ -->
                <Border Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}"
                        Width="420" CornerRadius="8" Background="#E00B1824" BorderBrush="#10B981" BorderThickness="1.5"
                        Padding="16,12" Margin="0,16,0,0" HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#10B981" BlurRadius="20" ShadowDepth="2" Opacity="0.4"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <Border Width="8" Height="8" CornerRadius="4" Background="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="GAME IS RUNNING" FontSize="11.5" FontWeight="Black" Foreground="#10B981" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ActiveInstanceName, StringFormat='Active: {0}'}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Instance process active • Logs streaming live" FontSize="10" Foreground="#94A3B8" Margin="0,1,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding ToggleConsoleCommand}" 
                                    Style="{StaticResource VayuDarkButton}" Padding="10,6" Margin="0,0,8,0"
                                    ToolTip="View live output logs">
                                <TextBlock Text="Live Logs" FontSize="11" FontWeight="SemiBold"/>
                            </Button>
                            <Button Command="{Binding StopGameCommand}" 
                                    Style="{StaticResource VayuDangerButton}" Padding="10,6"
                                    ToolTip="Terminate game process">
                                <TextBlock Text="Stop Game" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>

            <!-- ─── BOTTOM FLOATING INSTANCE DOCK / CAROUSEL ─── -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Instance Carousel Bar -->
                <Border Grid.Column="0" CornerRadius="12" Background="#CC0F172A" BorderBrush="#1E293B" BorderThickness="1" 
                        Padding="14,10" Margin="0,0,16,0" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Section Header -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="INSTANCES" FontSize="10" FontWeight="Black" Foreground="{StaticResource VayuBrightBlueBrush}"/>
                            <TextBlock Text="{Binding InstancesCount, StringFormat={}{0} Available}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </StackPanel>

                        <!-- Instances Horizontal Scroll / List -->
                        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Instances}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectInstanceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0" Padding="0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="CardBd" CornerRadius="6" Background="#152033" BorderBrush="#243247" BorderThickness="1" Padding="10,6">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Path Data="{StaticResource VayuIconInstances}" Fill="{StaticResource VayuBrightBlueBrush}" 
                                                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" MaxWidth="140" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding DisplaySubtitle}" FontSize="9.5" Foreground="#94A3B8"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="CardBd" Property="Background" Value="#1E3A66"/>
                                                            <Setter TargetName="CardBd" Property="BorderBrush" Value="#3B82F6"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Quick "+ New" Action Button -->
                        <Button Grid.Column="2" Command="{Binding CreateNewInstanceCommand}" 
                                Style="{StaticResource VayuDarkButton}" Padding="12,6" Margin="10,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource VayuIconPlus}" Fill="{StaticResource VayuBrightBlueBrush}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="New Instance" FontSize="11" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Floating Live Console Toggle Button -->
                <Button Grid.Column="1" Command="{Binding ToggleConsoleCommand}" 
                        Style="{StaticResource VayuDarkButton}" Padding="12,8" VerticalAlignment="Center" ToolTip="Toggle live launcher console logs">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text=">_" FontSize="12" FontWeight="Bold" Foreground="{StaticResource VayuBrightBlueBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="Console" FontSize="11.5" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ─── EXPANDABLE CONSOLE LOG DRAWER ─── -->
            <Border Grid.Row="1" Grid.RowSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                    Height="240" CornerRadius="8" Background="#F0070B14" BorderBrush="#2563EB" BorderThickness="1.5"
                    Padding="16,12" Margin="0,0,0,60" Visibility="{Binding IsConsoleExpanded, Converter={StaticResource BoolToVis}}">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.9"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="LIVE LAUNCHER LOGS" FontSize="11" FontWeight="Black" Foreground="{StaticResource VayuBrightBlueBrush}"/>
                            <TextBlock Text="• Real Process Events" FontSize="10" Foreground="#94A3B8" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Copy" Command="{Binding CopyLogsCommand}" Style="{StaticResource VayuDarkButton}" Padding="8,3" Margin="0,0,6,0"/>
                            <Button Content="Clear" Command="{Binding ClearLogsCommand}" Style="{StaticResource VayuDarkButton}" Padding="8,3" Margin="0,0,6,0"/>
                            <Button Content="✕" Command="{Binding ToggleConsoleCommand}" Style="{StaticResource VayuDarkButton}" Padding="8,3"/>
                        </StackPanel>
                    </Grid>

                    <TextBox Grid.Row="1" Text="{Binding LauncherLogs, Mode=OneWay}" 
                             IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Background="#0A101D" Foreground="#E2E8F0" FontFamily="{StaticResource VayuFontMono}" 
                             FontSize="11" BorderThickness="1" BorderBrush="#1E293B" Padding="10"/>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</UserControl>
