<UserControl x:Class="VayuClient.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:VayuClient.Core"
             xmlns:controls="clr-namespace:VayuClient.Controls"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1200"
             Background="#06070B"
             Loaded="HomePage_Loaded">

    <UserControl.Resources>
        <!-- Slanted Pill Style for Carousel Items -->
        <Style x:Key="CarouselInstanceItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBd" CornerRadius="12" Background="#0C0A14" BorderBrush="#1C172B" BorderThickness="1" Padding="14,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="28" Height="28" CornerRadius="6" Background="#181329" Margin="0,0,10,0" ClipToBounds="True">
                                    <controls:PlayerBody3D Profile="{Binding}" DisplayMode="HeadOnly"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding DisplaySubtitle}" FontSize="10" Foreground="#7D7596" Margin="0,1,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBd" Property="Background" Value="#171229"/>
                                <Setter TargetName="CardBd" Property="BorderBrush" Value="#4C2882"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="CardBd" Property="Background" Value="#1F133B"/>
                                <Setter TargetName="CardBd" Property="BorderBrush" Value="#A855F7"/>
                                <Setter TargetName="CardBd" Property="BorderThickness" Value="1.2"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#A855F7" BlurRadius="18" ShadowDepth="0" Opacity="0.35"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Main Container with Diagonal Geometric Accents & Atmospheric Wallpaper -->
    <Grid Background="#06070B" ClipToBounds="True">

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- DYNAMIC ATMOSPHERIC OBSIDIAN / FROST WHITE BACKGROUND WORLD         -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Grid IsHitTestVisible="False">
            <!-- Layer 1: Primary Crossfade Image -->
            <Image x:Name="BgImagePrimary" Source="{Binding HeroBackgroundPath}" Stretch="UniformToFill" 
                   Opacity="0.55" RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- Layer 2: Secondary Crossfade Image -->
            <Image x:Name="BgImageSecondary" Stretch="UniformToFill" 
                   Opacity="0.0" RenderOptions.BitmapScalingMode="HighQuality"/>
            
            <!-- Dynamic Radial Obsidian / Frost White Vignette for UI Text Contrast -->
            <Rectangle>
                <Rectangle.Style>
                    <Style TargetType="Rectangle">
                        <Setter Property="Fill">
                            <Setter.Value>
                                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.85" RadiusY="0.85">
                                    <GradientStop Color="#4006070B" Offset="0.0"/>
                                    <GradientStop Color="#B506070B" Offset="0.65"/>
                                    <GradientStop Color="#F506070B" Offset="1.0"/>
                                </RadialGradientBrush>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWhiteTheme}" Value="True">
                                <Setter Property="Fill">
                                    <Setter.Value>
                                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.85" RadiusY="0.85">
                                            <GradientStop Color="#20FFFFFF" Offset="0.0"/>
                                            <GradientStop Color="#90FFFFFF" Offset="0.65"/>
                                            <GradientStop Color="#E8F1F8FF" Offset="1.0"/>
                                        </RadialGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Rectangle.Style>
            </Rectangle>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- SUBTLE GEOMETRIC FACETED BACKGROUND ACCENTS                         -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Canvas IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Diagonal translucent purple accent streak 1 -->
            <Path Data="M -100,500 L 400,-100 L 520,-100 L 20,500 Z" Opacity="0.04">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#7C3AED" Offset="0.0"/>
                        <GradientStop Color="#00000000" Offset="1.0"/>
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>

            <!-- Diagonal translucent purple accent streak 2 -->
            <Path Data="M 700,700 L 1200,200 L 1350,200 L 850,700 Z" Opacity="0.035">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#A855F7" Offset="0.0"/>
                        <GradientStop Color="#00000000" Offset="1.0"/>
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>
        </Canvas>

        <!-- Main Home Layout -->
        <Grid Margin="48,18,48,76">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Row 0: Top Controls & System Telemetry -->
                <RowDefinition Height="*"/>    <!-- Row 1: Centerpiece (3D Player + Instance Info + Shortcuts + Drag to Play) -->
                <RowDefinition Height="Auto"/> <!-- Row 2: Bottom Instance Switcher Carousel -->
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- ROW 0: TOP BRAND MANIFESTO, WALLPAPER CONTROLLER & TELEMETRY     -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Brand Manifesto -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle Width="2" Height="32" Fill="#A855F7" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="FASTER" FontSize="9.5" FontWeight="Black" Foreground="#7E7796" Margin="0,0,0,1"/>
                        <TextBlock Text="LIGHTER" FontSize="9.5" FontWeight="Black" Foreground="#7E7796" Margin="0,0,0,1"/>
                        <TextBlock Text="BUILT FOR PVP" FontSize="9.5" FontWeight="Black" Foreground="#7E7796"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center/Right: Wallpaper Controller, Theme Switcher & System Telemetry -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    
                    <!-- 🌌 Dynamic Wallpaper Slideshow Controls Pill -->
                    <Border CornerRadius="8" Background="#0C0A14" BorderBrush="#1C172B" BorderThickness="1" Padding="6,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Prev Wallpaper Button -->
                            <Button Command="{Binding PreviousWallpaperCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4,2" ToolTip="Previous Atmospheric Wallpaper">
                                <TextBlock Text="◀" FontSize="9" Foreground="#A855F7" VerticalAlignment="Center"/>
                            </Button>
                            
                            <!-- Wallpaper Icon & Name -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                <TextBlock Text="🌌" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentWallpaperName}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" MaxWidth="105" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Next Wallpaper Button -->
                            <Button Command="{Binding NextWallpaperCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4,2" ToolTip="Next Atmospheric Wallpaper">
                                <TextBlock Text="▶" FontSize="9" Foreground="#A855F7" VerticalAlignment="Center"/>
                            </Button>

                            <!-- Slideshow Play/Pause Toggle -->
                            <Button Command="{Binding ToggleWallpaperSlideshowCommand}" Background="#161224" BorderThickness="0" Cursor="Hand" Padding="6,2" Margin="4,0,0,0" ToolTip="Toggle Slideshow Auto-Cycle">
                                <TextBlock FontSize="9" Foreground="#C084FC" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="⏸"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWallpaperSlideshowRunning}" Value="False">
                                                    <Setter Property="Text" Value="▶"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- ☀️/🌙 Black & White Theme Toggle Button -->
                    <Button Command="{Binding ToggleThemeCommand}" Style="{StaticResource VayuDarkButton}" Padding="8,5" Margin="0,0,8,0" ToolTip="Toggle Obsidian Dark / Frost White Theme">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontSize="10" Margin="0,0,4,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="🌙"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWhiteTheme}" Value="True">
                                                <Setter Property="Text" Value="☀️"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="#FFFFFF">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Obsidian"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWhiteTheme}" Value="True">
                                                <Setter Property="Text" Value="Frost"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <!-- CPU Chip -->
                    <Border CornerRadius="8" Background="#0C0A14" BorderBrush="#1C172B" BorderThickness="1" Padding="10,5" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔲" FontSize="9" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="CPU" FontSize="9.5" FontWeight="Black" Foreground="#7D7596" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CpuUsageDisplay}" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- RAM Chip -->
                    <Border CornerRadius="8" Background="#0C0A14" BorderBrush="#1C172B" BorderThickness="1" Padding="10,5" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔋" FontSize="9" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="RAM" FontSize="9.5" FontWeight="Black" Foreground="#7D7596" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding RamUsageDisplay}" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- VRAM capacity chip -->
                    <Border CornerRadius="8" Background="#0C0A14" BorderBrush="#1C172B" BorderThickness="1" Padding="10,5" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎮" FontSize="9" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="VRAM" FontSize="9.5" FontWeight="Black" Foreground="#7D7596" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding GpuUsageDisplay}" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Status Indicator -->
                    <Border CornerRadius="8" Background="#0C0A14" BorderBrush="#1C172B" BorderThickness="1" Padding="10,5">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="#A855F7" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#A855F7" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="{Binding SystemStatusText}" FontSize="10.5" FontWeight="Bold" Foreground="#D8B4FE" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- ROW 1: CENTER ACTIVE INSTANCE PRESENTATION & SIGNATURE PLAY     -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">

                    <!-- ─── 1. LEFT: 3D PLAYER SKIN HERO SHOWCASE + FLOATING POSE SELECTOR ─── -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,36,0">
                        
                        <Grid Width="280" Height="320" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Soft Ambient Purple World Floor Halo Underneath Player Feet -->
                            <Ellipse Width="200" Height="36" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6" IsHitTestVisible="False">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#70A855F7" Offset="0.0"/>
                                        <GradientStop Color="#207C3AED" Offset="0.5"/>
                                        <GradientStop Color="#00000000" Offset="1.0"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <!-- Subtle Radial Ambient Backlight for Character Silhouette Definition -->
                            <Ellipse Width="240" Height="260" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.35">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#40A855F7" Offset="0.0"/>
                                        <GradientStop Color="#157C3AED" Offset="0.5"/>
                                        <GradientStop Color="#00000000" Offset="1.0"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <!-- Free-Standing Heroic 3D Player Model (Supports 360° Drag & 7 Animated Poses) -->
                            <controls:PlayerBody3D Profile="{Binding ActiveProfile}" 
                                                   Pose="{Binding CurrentPose, Mode=TwoWay}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Width="280" Height="320"/>
                        </Grid>

                        <!-- Floating 7-Pose Selector Pill Capsule -->
                        <Border Background="#0C0818" BorderBrush="#22173B" BorderThickness="1" 
                                CornerRadius="14" Padding="5,3" Margin="0,4,0,0" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Pose 1: Running -->
                                <Button Command="{Binding SelectPoseCommand}" CommandParameter="Running"
                                        Style="{StaticResource VayuDarkButton}" Padding="5,2" Margin="2,0" ToolTip="Sprint Running Pose">
                                    <TextBlock Text="🏃" FontSize="11"/>
                                </Button>
                                <!-- Pose 2: Idle -->
                                <Button Command="{Binding SelectPoseCommand}" CommandParameter="Idle"
                                        Style="{StaticResource VayuDarkButton}" Padding="5,2" Margin="2,0" ToolTip="Heroic Idle Pose">
                                    <TextBlock Text="🧘" FontSize="11"/>
                                </Button>
                                <!-- Pose 3: Combat -->
                                <Button Command="{Binding SelectPoseCommand}" CommandParameter="Combat"
                                        Style="{StaticResource VayuDarkButton}" Padding="5,2" Margin="2,0" ToolTip="PvP Combat Stance">
                                    <TextBlock Text="⚔️" FontSize="11"/>
                                </Button>
                                <!-- Pose 4: Waving -->
                                <Button Command="{Binding SelectPoseCommand}" CommandParameter="Waving"
                                        Style="{StaticResource VayuDarkButton}" Padding="5,2" Margin="2,0" ToolTip="Greeting Wave">
                                    <TextBlock Text="👋" FontSize="11"/>
                                </Button>
                                <!-- Pose 5: CrossArms -->
                                <Button Command="{Binding SelectPoseCommand}" CommandParameter="CrossArms"
                                        Style="{StaticResource VayuDarkButton}" Padding="5,2" Margin="2,0" ToolTip="Folded Arms Guard">
                                    <TextBlock Text="🛡️" FontSize="11"/>
                                </Button>
                                <!-- Pose 6: Celebration -->
                                <Button Command="{Binding SelectPoseCommand}" CommandParameter="Celebration"
                                        Style="{StaticResource VayuDarkButton}" Padding="5,2" Margin="2,0" ToolTip="Victory Cheer">
                                    <TextBlock Text="🏆" FontSize="11"/>
                                </Button>
                                <!-- Pose 7: Love (Holding Mini Player Companion in Lap) -->
                                <Button Command="{Binding SelectPoseCommand}" CommandParameter="Love"
                                        Background="#2D0A24" BorderBrush="#F43F5E" BorderThickness="1"
                                        Style="{StaticResource VayuDarkButton}" Padding="5,2" Margin="2,0" ToolTip="Love / Mini Companion Lap Cradle">
                                    <TextBlock Text="💕" FontSize="11"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="🖱️ 360° Orbit Drag • Click to Cycle" FontSize="9" Foreground="#645C7D" 
                                   HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- ─── 2. RIGHT: INSTANCE NAME, SPEC CHIPS, GAMER SHORTCUTS & DRAG TO PLAY ─── -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                        
                        <!-- Active Instance Name Header + Status Dot -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                            <TextBlock Text="{Binding ActiveInstanceName}" 
                                       FontSize="30" FontWeight="Black" Foreground="#FFFFFF" 
                                       TextOptions.TextRenderingMode="ClearType"/>
                            <Ellipse Width="9" Height="9" Fill="#A855F7" Margin="12,0,0,0" VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#A855F7" BlurRadius="14" ShadowDepth="0" Opacity="0.95"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </StackPanel>

                        <!-- 5 Technical Information Spec Chips in a Horizontal Row -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,14">
                            
                            <!-- Chip 1: Minecraft Version -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,22,0">
                                <Path Data="M 12,2 L 2,7 L 12,12 L 22,7 Z M 2,17 L 12,22 L 22,17 L 22,14.5 L 12,19.5 L 2,14.5 Z" 
                                      Fill="#A855F7" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ActiveInstanceVersion}" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Version" FontSize="9" Foreground="#7D7596" Margin="0,1,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Chip 2: Mod Loader -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,22,0">
                                <Path Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 Z" 
                                      Fill="#A855F7" Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ActiveInstanceLoaderUpper}" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Loader" FontSize="9" Foreground="#7D7596" Margin="0,1,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Chip 3: Mods Count -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,22,0">
                                <Path Data="{StaticResource VayuIconMods}" Fill="#A855F7" Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ActiveInstanceModCountNumber}" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Mods" FontSize="9" Foreground="#7D7596" Margin="0,1,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Chip 4: RAM -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,22,0">
                                <Path Data="M 17,2 H 7 C 5.9,2 5,2.9 5,4 V 20 C 5,21.1 5.9,22 7,22 H 17 C 18.1,22 19,21.1 19,20 V 4 C 19,2.9 18.1,2 17,2 Z M 17,20 H 7 V 4 H 17 Z" 
                                      Fill="#A855F7" Width="11" Height="11" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ActiveInstanceRamGbDisplay}" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="RAM" FontSize="9" Foreground="#7D7596" Margin="0,1,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Chip 5: Playtime & Last Played -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⏱️" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ActiveInstancePlaytimeDisplay}" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="{Binding ActiveInstanceLastPlayedDisplay}" FontSize="9" Foreground="#7D7596" Margin="0,1,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- 1-Click Gamer Shortcuts Bar -->
                        <Border Background="#0D0A18" BorderBrush="#1C162E" BorderThickness="1" 
                                CornerRadius="12" Padding="6,4" Margin="0,0,0,16" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Open Folder -->
                                <Button Command="{Binding OpenInstanceFolderCommand}" Style="{StaticResource VayuDarkButton}" Padding="9,4" Margin="0,0,6,0" ToolTip="Open Game Directory in File Explorer">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📁" FontSize="10" Margin="0,0,5,0"/>
                                        <TextBlock Text="Folder" FontSize="10" FontWeight="Bold" Foreground="#E2E8F0"/>
                                    </StackPanel>
                                </Button>
                                <!-- Screenshots -->
                                <Button Command="{Binding OpenScreenshotsFolderCommand}" Style="{StaticResource VayuDarkButton}" Padding="9,4" Margin="0,0,6,0" ToolTip="Open Screenshots Gallery">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📸" FontSize="10" Margin="0,0,5,0"/>
                                        <TextBlock Text="Screenshots" FontSize="10" FontWeight="Bold" Foreground="#E2E8F0"/>
                                    </StackPanel>
                                </Button>
                                <!-- Add Mods -->
                                <Button Command="{Binding OpenModsFolderCommand}" Style="{StaticResource VayuDarkButton}" Padding="9,4" Margin="0,0,6,0" ToolTip="Open Mods Folder">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📦" FontSize="10" Margin="0,0,5,0"/>
                                        <TextBlock Text="Mods" FontSize="10" FontWeight="Bold" Foreground="#E2E8F0"/>
                                    </StackPanel>
                                </Button>
                                <!-- Instance Settings -->
                                <Button Command="{Binding OpenInstanceSettingsCommand}" Style="{StaticResource VayuDarkButton}" Padding="9,4" ToolTip="Configure Client &amp; Java Settings">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⚙️" FontSize="10" Margin="0,0,5,0"/>
                                        <TextBlock Text="Settings" FontSize="10" FontWeight="Bold" Foreground="#E2E8F0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <!-- SIGNATURE "DRAG TO PLAY" INTERACTIVE CAPSULE CONTROL        -->
                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <Grid Width="510" HorizontalAlignment="Left">
                            
                            <!-- ─── STATE A: NORMAL DRAG-TO-PLAY CONTROL ─── -->
                            <Border x:Name="PlayTrackBorder" 
                                    Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}"
                                    Height="56" CornerRadius="28" 
                                    Background="#100A20" BorderBrush="#321D50" BorderThickness="1.2"
                                    ClipToBounds="True">
                                <Border.Effect>
                                    <DropShadowEffect Color="#7C3AED" BlurRadius="20" ShadowDepth="0" Opacity="0.25" RenderingBias="Performance"/>
                                </Border.Effect>

                                <Grid>
                                    <!-- Dynamic Expanding Purple Fill (Follows Handle Drag) -->
                                    <Rectangle x:Name="DragProgressFill" Width="0" HorizontalAlignment="Left">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#4C1D95" Offset="0.0"/>
                                                <GradientStop Color="#8B5CF6" Offset="0.8"/>
                                                <GradientStop Color="#A855F7" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>

                                    <!-- Track Center Title: P L A Y -->
                                    <TextBlock Text="P L A Y" FontSize="14" FontWeight="Black" Foreground="#FFFFFF" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    <!-- Track Right Prompt: Drag to launch → -->
                                    <TextBlock x:Name="DragPromptText" Text="Drag to launch →" FontSize="11" FontWeight="SemiBold" 
                                               Foreground="#8E80A8" HorizontalAlignment="Right" VerticalAlignment="Center" 
                                               Margin="0,0,24,0"/>

                                    <!-- Draggable Handle (Left Circle with Chevron >) -->
                                    <Border x:Name="PlayDragHandle" Width="48" Height="48" CornerRadius="24"
                                            Background="#8B5CF6" BorderBrush="#C084FC" BorderThickness="1.5"
                                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="PlayHandle_MouseDown"
                                            MouseMove="PlayHandle_MouseMove"
                                            MouseLeftButtonUp="PlayHandle_MouseUp">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#A855F7" BlurRadius="16" ShadowDepth="0" Opacity="0.75"/>
                                        </Border.Effect>
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="HandleTranslate" X="0" Y="0"/>
                                        </Border.RenderTransform>
                                        
                                        <Path Data="M 8.59,16.59 L 13.17,12 L 8.59,7.41 L 10,6 L 16,12 L 10,18 Z" 
                                              Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- ─── STATE B: LAUNCHING STATUS MORPH (During Ignition) ─── -->
                            <Border Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                    Height="56" CornerRadius="28" 
                                    Background="#120A24" BorderBrush="#A855F7" BorderThickness="1.5"
                                    Padding="16,6">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="⚡ " FontSize="12" Foreground="#A855F7"/>
                                            <TextBlock Text="{Binding ProgressStatus, FallbackValue='Igniting game engine...'}" 
                                                       FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <ProgressBar Value="{Binding ProgressPercentage}" Minimum="0" Maximum="100" 
                                                     Height="4" Margin="0,4,0,0"
                                                     Foreground="#A855F7" Background="#1E1433" BorderThickness="0"/>
                                    </StackPanel>

                                    <Button Grid.Column="1" Command="{Binding CancelLaunchCommand}"
                                            Style="{StaticResource VayuDarkButton}" Padding="10,4" FontSize="10.5">
                                        <TextBlock Text="Cancel" Foreground="#EF4444" FontWeight="Bold"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- ─── STATE C: ACTIVE SESSIONS MORPH (When Game is Running) ─── -->
                            <Border Visibility="{Binding HasRunningSessions, Converter={StaticResource BoolToVis}}"
                                    Height="56" CornerRadius="28" 
                                    Background="#0A1814" BorderBrush="#10B981" BorderThickness="1.5"
                                    Padding="16,6">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,10,0"/>
                                        <TextBlock Text="GAME RUNNING" FontSize="12" FontWeight="Black" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding ActiveInstanceName}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Command="{Binding ToggleConsoleCommand}" Style="{StaticResource VayuDarkButton}" Padding="10,4" Margin="0,0,6,0" FontSize="10">
                                            <TextBlock Text="Logs" Foreground="#FFFFFF"/>
                                        </Button>
                                        <Button Command="{Binding StopGameCommand}" Style="{StaticResource VayuDarkButton}" Padding="12,4" FontSize="10">
                                            <TextBlock Text="Stop" Foreground="#EF4444" FontWeight="Bold"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- ROW 2: BOTTOM INSTANCE SWITCHER CAROUSEL                        -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" 
                    Background="#0B0816" BorderBrush="#1C172E" BorderThickness="1.2" 
                    CornerRadius="16" Padding="10,6" Margin="0,0,0,12">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.4"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Left Chevron -->
                        <ColumnDefinition Width="Auto"/> <!-- Carousel Items -->
                        <ColumnDefinition Width="Auto"/> <!-- Right Chevron -->
                    </Grid.ColumnDefinitions>

                    <!-- Left Chevron Button -->
                    <Button Grid.Column="0" Command="{Binding SelectPreviousInstanceCommand}"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center" Margin="0,0,8,0" Padding="8,4">
                        <TextBlock Text="‹" FontSize="20" FontWeight="Bold" Foreground="#7D7596"/>
                    </Button>

                    <!-- Horizontal Instance Items Carousel -->
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Instances}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource CarouselInstanceItemStyle}"
                                        Command="{Binding DataContext.SelectInstanceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Right Chevron Button -->
                    <Button Grid.Column="2" Command="{Binding SelectNextInstanceCommand}"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center" Margin="8,0,0,0" Padding="8,4">
                        <TextBlock Text="›" FontSize="20" FontWeight="Bold" Foreground="#7D7596"/>
                    </Button>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</UserControl>
