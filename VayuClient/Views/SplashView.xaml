<UserControl x:Class="VayuClient.Views.SplashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:VayuClient.Core"
             Cursor="Arrow">

    <Grid x:Name="Root" Background="#060608" ClipToBounds="True">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScale" ScaleX="1.0" ScaleY="1.0" CenterX="620" CenterY="390"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- 1. TOP MINIMALIST HEADER & WINDOW CONTROLS                    -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid VerticalAlignment="Top" Height="48" Margin="24,14,24,0" Panel.ZIndex="50">
            <!-- Left: Minimalist Logo + Label -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                <Path Data="M 2,12 L 14,2 L 26,12 L 14,22 Z M 8,12 L 14,7 L 20,12 L 14,17 Z" 
                      Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="VAYU CLIENT" FontSize="11" FontWeight="Bold" Foreground="#8E8EA0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Right: Minimalist Window Control Dots -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0">
                <Border Width="9" Height="9" CornerRadius="4.5" Background="#EF4444" Margin="0,0,10,0" Opacity="0.85"/>
                <Border Width="9" Height="9" CornerRadius="4.5" Background="#262632" Margin="0,0,10,0" Opacity="0.8"/>
                <Border Width="9" Height="9" CornerRadius="4.5" Background="#262632" Margin="0,0,10,0" Opacity="0.8"/>
                <Border Width="9" Height="9" CornerRadius="4.5" Background="#262632" Opacity="0.8"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- 2. AMBIENT BACKGROUND GLOW & MESH GRID                        -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- Deep Ambient Purple Radial Illumination behind the center -->
        <Ellipse Width="800" Height="600" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.35">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.52,0.48" GradientOrigin="0.52,0.48" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#406B21A8" Offset="0.0"/>
                    <GradientStop Color="#183B0764" Offset="0.5"/>
                    <GradientStop Color="#00060608" Offset="1.0"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- 3. THE FRACTAL GROWTH: 3D VECTOR CRYSTALLINE POLYHEDRA        -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- Canvas for full precision geometric coordinate mapping -->
        <Viewbox Stretch="Uniform" IsHitTestVisible="False">
            <Canvas Width="1240" Height="780" Background="Transparent">

                <!-- ─── CLUSTER 0: Baseline Wireframe Lattice & Outer Nodes (0%) ─── -->
                <Canvas x:Name="ClusterStage0" Opacity="0.25">
                    <!-- Fine Wireframe Connectivity Struts -->
                    <Line X1="80" Y1="620" X2="240" Y2="540" Stroke="#40FFFFFF" StrokeThickness="0.6"/>
                    <Line X1="240" Y1="540" X2="410" Y2="430" Stroke="#40FFFFFF" StrokeThickness="0.6"/>
                    <Line X1="410" Y1="430" X2="540" Y2="260" Stroke="#40FFFFFF" StrokeThickness="0.6"/>
                    <Line X1="540" Y1="260" X2="760" Y2="190" Stroke="#40FFFFFF" StrokeThickness="0.6"/>
                    <Line X1="760" Y1="190" X2="960" Y2="140" Stroke="#40FFFFFF" StrokeThickness="0.6"/>
                    <Line X1="960" Y1="140" X2="1140" Y2="220" Stroke="#40FFFFFF" StrokeThickness="0.6"/>
                    <Line X1="410" Y1="430" X2="620" Y2="560" Stroke="#40FFFFFF" StrokeThickness="0.6"/>
                    <Line X1="620" Y1="560" X2="880" Y2="500" Stroke="#40FFFFFF" StrokeThickness="0.6"/>
                    <Line X1="880" Y1="500" X2="1080" Y2="380" Stroke="#40FFFFFF" StrokeThickness="0.6"/>
                    
                    <!-- Ambient Micro-nodes -->
                    <Ellipse Canvas.Left="78" Canvas.Top="618" Width="4" Height="4" Fill="#A855F7"/>
                    <Ellipse Canvas.Left="238" Canvas.Top="538" Width="4" Height="4" Fill="#FFFFFF"/>
                    <Ellipse Canvas.Left="538" Canvas.Top="258" Width="4" Height="4" Fill="#A855F7"/>
                    <Ellipse Canvas.Left="758" Canvas.Top="188" Width="4" Height="4" Fill="#FFFFFF"/>
                    <Ellipse Canvas.Left="958" Canvas.Top="138" Width="4" Height="4" Fill="#A855F7"/>
                    <Ellipse Canvas.Left="1138" Canvas.Top="218" Width="4" Height="4" Fill="#FFFFFF"/>
                    <Ellipse Canvas.Left="878" Canvas.Top="498" Width="4" Height="4" Fill="#A855F7"/>
                </Canvas>

                <!-- ─── CLUSTER 1: Left Wing Primary Polyhedra (Emerges at 25%) ─── -->
                <Canvas x:Name="ClusterStage1" Opacity="0" RenderTransformOrigin="0.2,0.7">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="Cluster1Scale" ScaleX="0.5" ScaleY="0.5"/>
                            <TranslateTransform x:Name="Cluster1Translate" X="-40" Y="40"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>

                    <!-- Large Left Base Polyhedron (Peak: 170, 560) -->
                    <!-- Facet A: Top Light Face -->
                    <Polygon Points="170,560 60,630 180,720" Fill="#161622" Stroke="#70FFFFFF" StrokeThickness="0.9"/>
                    <!-- Facet B: Shadow Bottom Face -->
                    <Polygon Points="170,560 180,720 280,660" Fill="#0E0E14" Stroke="#40FFFFFF" StrokeThickness="0.8"/>
                    <!-- Facet C: Inner Illuminated Purple Face -->
                    <Polygon Points="170,560 280,660 250,510">
                        <Polygon.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#807C3AED" Offset="0"/>
                                <GradientStop Color="#101018" Offset="1"/>
                            </LinearGradientBrush>
                        </Polygon.Fill>
                        <Polygon.Stroke>
                            <SolidColorBrush Color="#C084FC" Opacity="0.8"/>
                        </Polygon.Stroke>
                    </Polygon>
                    <!-- Facet D: Top Shard -->
                    <Polygon Points="170,560 250,510 120,490" Fill="#1E1E2C" Stroke="#80FFFFFF" StrokeThickness="0.9"/>
                    <Polygon Points="170,560 120,490 60,630" Fill="#12121A" Stroke="#30FFFFFF" StrokeThickness="0.8"/>

                    <!-- Mid Left Secondary Polyhedron (Peak: 260, 420) -->
                    <!-- Facet A: Top Light -->
                    <Polygon Points="260,420 180,340 310,310" Fill="#242436" Stroke="#90FFFFFF" StrokeThickness="0.9"/>
                    <!-- Facet B: Outer Shadow -->
                    <Polygon Points="260,420 120,490 180,340" Fill="#14141E" Stroke="#50FFFFFF" StrokeThickness="0.8"/>
                    <!-- Facet C: Glowing Purple Seam -->
                    <Polygon Points="260,420 250,510 380,470">
                        <Polygon.Fill>
                            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                <GradientStop Color="#A855F7" Offset="0"/>
                                <GradientStop Color="#12121A" Offset="0.85"/>
                            </LinearGradientBrush>
                        </Polygon.Fill>
                        <Polygon.Stroke>
                            <SolidColorBrush Color="#E9D5FF" Opacity="0.9"/>
                        </Polygon.Stroke>
                    </Polygon>
                    <!-- Facet D: Bridge to Center -->
                    <Polygon Points="260,420 380,470 310,310" Fill="#181824" Stroke="#60FFFFFF" StrokeThickness="0.85"/>
                </Canvas>

                <!-- ─── CLUSTER 2: Upper Left & Spine Bridge (Emerges at 50%) ─── -->
                <Canvas x:Name="ClusterStage2" Opacity="0" RenderTransformOrigin="0.35,0.4">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="Cluster2Scale" ScaleX="0.5" ScaleY="0.5"/>
                            <TranslateTransform x:Name="Cluster2Translate" X="-20" Y="-20"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>

                    <!-- Upper Left Apex Polyhedron (Peak: 390, 260) -->
                    <!-- Facet A: Top Razor Light Face -->
                    <Polygon Points="390,260 310,310 350,170" Fill="#2C2C42" Stroke="#B0FFFFFF" StrokeThickness="1.0"/>
                    <!-- Facet B: Back Ridge Face -->
                    <Polygon Points="390,260 350,170 480,180" Fill="#1C1C2A" Stroke="#60FFFFFF" StrokeThickness="0.85"/>
                    <!-- Facet C: Purple Canyon Crevice -->
                    <Polygon Points="390,260 480,180 500,310">
                        <Polygon.Fill>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#C084FC" Offset="0"/>
                                <GradientStop Color="#101018" Offset="0.9"/>
                            </LinearGradientBrush>
                        </Polygon.Fill>
                        <Polygon.Stroke>
                            <SolidColorBrush Color="#C084FC" Opacity="0.9"/>
                        </Polygon.Stroke>
                    </Polygon>
                    <!-- Facet D: Lower Center Connection -->
                    <Polygon Points="390,260 500,310 380,470" Fill="#14141E" Stroke="#50FFFFFF" StrokeThickness="0.8"/>
                    <Polygon Points="390,260 380,470 310,310" Fill="#0E0E14" Stroke="#35FFFFFF" StrokeThickness="0.75"/>

                    <!-- Lower Center Anchor Shards (X: 380..520, Y: 470..680) -->
                    <Polygon Points="460,580 380,470 420,670" Fill="#12121A" Stroke="#40FFFFFF" StrokeThickness="0.8"/>
                    <Polygon Points="460,580 420,670 540,640" Fill="#0C0C12" Stroke="#30FFFFFF" StrokeThickness="0.8"/>
                    <Polygon Points="460,580 540,640 500,510">
                        <Polygon.Fill>
                            <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                                <GradientStop Color="#7C3AED" Offset="0"/>
                                <GradientStop Color="#0F0F16" Offset="0.8"/>
                            </LinearGradientBrush>
                        </Polygon.Fill>
                        <Polygon.Stroke>
                            <SolidColorBrush Color="#A855F7" Opacity="0.85"/>
                        </Polygon.Stroke>
                    </Polygon>
                    <Polygon Points="460,580 500,510 380,470" Fill="#1A1A26" Stroke="#60FFFFFF" StrokeThickness="0.85"/>
                </Canvas>

                <!-- ─── CLUSTER 3: Right Wing Polyhedral Canopy (Emerges at 75%) ─── -->
                <Canvas x:Name="ClusterStage3" Opacity="0" RenderTransformOrigin="0.7,0.4">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="Cluster3Scale" ScaleX="0.5" ScaleY="0.5"/>
                            <TranslateTransform x:Name="Cluster3Translate" X="30" Y="-20"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>

                    <!-- Central-Right Arch Crystal (Peak: 720, 220) -->
                    <!-- Facet A: Top Prism Light -->
                    <Polygon Points="720,220 600,160 710,90" Fill="#32324A" Stroke="#D0FFFFFF" StrokeThickness="1.0"/>
                    <!-- Facet B: Outer Right Shadow -->
                    <Polygon Points="720,220 710,90 840,150" Fill="#1E1E2C" Stroke="#70FFFFFF" StrokeThickness="0.85"/>
                    <!-- Facet C: Glowing Purple Vertical Ridge -->
                    <Polygon Points="720,220 840,150 820,310">
                        <Polygon.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#C084FC" Offset="0"/>
                                <GradientStop Color="#101018" Offset="0.85"/>
                            </LinearGradientBrush>
                        </Polygon.Fill>
                        <Polygon.Stroke>
                            <SolidColorBrush Color="#E879F9" Opacity="0.95"/>
                        </Polygon.Stroke>
                    </Polygon>
                    <!-- Facet D: Inner Face wrapping over VAYU -->
                    <Polygon Points="720,220 820,310 680,330" Fill="#14141E" Stroke="#50FFFFFF" StrokeThickness="0.8"/>
                    <Polygon Points="720,220 680,330 600,160" Fill="#1A1A26" Stroke="#60FFFFFF" StrokeThickness="0.8"/>

                    <!-- Far Right Wing Mega-Crystal (Peak: 930, 240) -->
                    <!-- Facet A: Sky Light Face -->
                    <Polygon Points="930,240 840,150 960,110" Fill="#2A2A3E" Stroke="#A0FFFFFF" StrokeThickness="0.9"/>
                    <!-- Facet B: Far Right Edge Shadow -->
                    <Polygon Points="930,240 960,110 1080,190" Fill="#161622" Stroke="#60FFFFFF" StrokeThickness="0.85"/>
                    <!-- Facet C: Lower Purple Core -->
                    <Polygon Points="930,240 1080,190 1020,360">
                        <Polygon.Fill>
                            <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                                <GradientStop Color="#9333EA" Offset="0"/>
                                <GradientStop Color="#0D0D14" Offset="0.8"/>
                            </LinearGradientBrush>
                        </Polygon.Fill>
                        <Polygon.Stroke>
                            <SolidColorBrush Color="#C084FC" Opacity="0.85"/>
                        </Polygon.Stroke>
                    </Polygon>
                    <!-- Facet D: Inner Bridge -->
                    <Polygon Points="930,240 1020,360 820,310" Fill="#181826" Stroke="#50FFFFFF" StrokeThickness="0.8"/>
                    <Polygon Points="930,240 820,310 840,150" Fill="#202030" Stroke="#70FFFFFF" StrokeThickness="0.85"/>

                    <!-- Far Right Secondary Shard (Peak: 1110, 320) -->
                    <Polygon Points="1110,320 1080,190 1190,270" Fill="#222234" Stroke="#80FFFFFF" StrokeThickness="0.85"/>
                    <Polygon Points="1110,320 1190,270 1140,420" Fill="#101018" Stroke="#40FFFFFF" StrokeThickness="0.8"/>
                    <Polygon Points="1110,320 1140,420 1020,360" Fill="#14141E" Stroke="#50FFFFFF" StrokeThickness="0.8"/>
                </Canvas>

                <!-- ─── CLUSTER 4: Center Core Origami Frame & Glowing Purple Veins (90-100%) ─── -->
                <Canvas x:Name="ClusterStage4" Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="Cluster4Scale" ScaleX="0.6" ScaleY="0.6"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>

                    <!-- Lower Right Crystal Pod (Peak: 760, 520) -->
                    <!-- Facet A: Top -->
                    <Polygon Points="760,520 680,330 820,310" Fill="#161622" Stroke="#50FFFFFF" StrokeThickness="0.8"/>
                    <!-- Facet B: Right -->
                    <Polygon Points="760,520 820,310 900,480" Fill="#101016" Stroke="#40FFFFFF" StrokeThickness="0.8"/>
                    <!-- Facet C: Bottom Purple Radiant Vein -->
                    <Polygon Points="760,520 900,480 810,630">
                        <Polygon.Fill>
                            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                <GradientStop Color="#A855F7" Offset="0"/>
                                <GradientStop Color="#0B0B10" Offset="0.85"/>
                            </LinearGradientBrush>
                        </Polygon.Fill>
                        <Polygon.Stroke>
                            <SolidColorBrush Color="#C084FC" Opacity="0.9"/>
                        </Polygon.Stroke>
                    </Polygon>
                    <!-- Facet D: Bottom Left -->
                    <Polygon Points="760,520 810,630 670,580" Fill="#0D0D14" Stroke="#30FFFFFF" StrokeThickness="0.75"/>
                    <Polygon Points="760,520 670,580 680,330">
                        <Polygon.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#7C3AED" Offset="0"/>
                                <GradientStop Color="#12121A" Offset="0.8"/>
                            </LinearGradientBrush>
                        </Polygon.Fill>
                        <Polygon.Stroke>
                            <SolidColorBrush Color="#E879F9" Opacity="0.9"/>
                        </Polygon.Stroke>
                    </Polygon>

                    <!-- Micro Prismatic Shards around the VAYU Typography Perimeter -->
                    <Polygon Points="500,310 570,240 600,160" Fill="#181826" Stroke="#60FFFFFF" StrokeThickness="0.8"/>
                    <Polygon Points="500,310 600,160 680,330" Fill="#0F0F16" Stroke="#40FFFFFF" StrokeThickness="0.75"/>
                    <Polygon Points="500,510 610,540 670,580" Fill="#14141E" Stroke="#50FFFFFF" StrokeThickness="0.8"/>
                    <Polygon Points="500,510 670,580 540,640" Fill="#0E0E14" Stroke="#35FFFFFF" StrokeThickness="0.75"/>
                </Canvas>

                <!-- ═══════════════════════════════════════════════════════════════ -->
                <!-- 4. LEADER LINES & TECHNICAL ANNOTATIONS                       -->
                <!-- ═══════════════════════════════════════════════════════════════ -->
                <Canvas x:Name="AnnotationCanvas" Opacity="0">
                    <!-- Leader Line 1: Upper-Left "VAYU CLIENT" Annotation -->
                    <Polyline Points="340,160 380,160 430,220" Stroke="#70FFFFFF" StrokeThickness="0.85"/>
                    <Ellipse Canvas.Left="428" Canvas.Top="218" Width="4" Height="4" Fill="#FFFFFF"/>
                    <TextBlock Text="VAYU CLIENT" Canvas.Left="260" Canvas.Top="152" 
                               FontSize="10" FontWeight="Bold" Foreground="#A855F7"/>

                    <!-- Leader Line 2: Top-Center "VAYU" Annotation -->
                    <Polyline Points="580,120 620,120 620,290" Stroke="#70FFFFFF" StrokeThickness="0.85"/>
                    <Ellipse Canvas.Left="618" Canvas.Top="288" Width="4" Height="4" Fill="#C084FC"/>
                    <TextBlock Text="VAYU" Canvas.Left="540" Canvas.Top="112" 
                               FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>

                    <!-- Leader Line 3: Bottom-Right Status Bracket Annotation -->
                    <Polyline Points="790,520 830,560 880,560" Stroke="#70FFFFFF" StrokeThickness="0.85"/>
                    <Ellipse Canvas.Left="788" Canvas.Top="518" Width="4" Height="4" Fill="#A855F7"/>
                </Canvas>

            </Canvas>
        </Viewbox>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- 5. CENTRAL BRANDING TYPOGRAPHY (CRISP PURE WHITE)              -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-10,0,0">
            <!-- Central "VAYU" Ultra-Clean Logo Typography -->
            <StackPanel x:Name="CenterLogoGroup" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0">
                <StackPanel.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="CenterLogoScale" ScaleX="0.92" ScaleY="0.92" CenterX="140" CenterY="40"/>
                    </TransformGroup>
                </StackPanel.RenderTransform>

                <TextBlock Text="VAYU" 
                           FontSize="64" 
                           FontWeight="Black" 
                           Foreground="#FFFFFF" 
                           HorizontalAlignment="Center" 
                           TextAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#A855F7" BlurRadius="24" ShadowDepth="0" Opacity="0.45"/>
                    </TextBlock.Effect>
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- 6. LOWER-RIGHT STATUS & PROGRESS TELEMETRY                    -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,54,58" Panel.ZIndex="60">
            <StackPanel x:Name="StatusContainer" Opacity="0" HorizontalAlignment="Right">
                <!-- Status Row with Glowing Status Indicator Dot -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusPulseDot" Width="6" Height="6" Fill="#A855F7" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusLabel" 
                               Text="INITIALIZING CORE SYSTEMS" 
                               FontSize="11.5" 
                               FontWeight="Bold" 
                               Foreground="#FFFFFF" 
                               VerticalAlignment="Center"/>
                    <TextBlock Text="—" FontSize="11" Foreground="#5E5E72" Margin="8,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PercentLabel" 
                               Text="0%" 
                               FontSize="12" 
                               FontWeight="Black" 
                               Foreground="#C084FC" 
                               VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- Thin Minimalist Progress Hairline (90px wide) -->
                <Border Width="160" Height="2" Background="#161622" HorizontalAlignment="Right" Margin="0,8,0,0" CornerRadius="1">
                    <Border x:Name="ProgressHairline" Width="0" Height="2" HorizontalAlignment="Left" CornerRadius="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#7C3AED" Offset="0"/>
                                <GradientStop Color="#C084FC" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- 7. SUBTLE BOTTOM SKIP TELEMETRY PROMPT                        -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <TextBlock x:Name="SkipLabel" 
                   Text="PRESS ANY KEY OR CLICK TO SKIP" 
                   FontSize="9.5" 
                   FontWeight="SemiBold"
                   Foreground="#3F3F50" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Bottom" 
                   Margin="0,0,0,24" 
                   Opacity="0"/>
    </Grid>
</UserControl>
