<UserControl x:Class="VayuClient.Views.SplashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             IsHitTestVisible="True"
             Cursor="Arrow">

    <Grid x:Name="Root" Background="#070B14" ClipToBounds="True">
        <!-- Ambient Deep Dark Nebula Background -->
        <Border Background="#070B14"/>

        <!-- Central Glowing Aura -->
        <Ellipse Width="360" Height="360" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#252563EB" Offset="0.0"/>
                    <GradientStop Color="#081E40AF" Offset="0.5"/>
                    <GradientStop Color="#00070B14" Offset="1.0"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Central Launcher Branding -->
        <StackPanel x:Name="MainContent" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Vayu Logo with Glowing Outer Halo -->
            <Grid Width="96" Height="96" HorizontalAlignment="Center" Margin="0,0,0,20" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="LogoScale" ScaleX="1" ScaleY="1"/>
                </Grid.RenderTransform>

                <!-- Glowing Outer Ring -->
                <Border Width="92" Height="92" CornerRadius="46" Background="#0F172A" BorderBrush="#3B82F6" BorderThickness="1.5">
                    <Border.Effect>
                        <DropShadowEffect Color="#3B82F6" BlurRadius="24" ShadowDepth="0" Opacity="0.55"/>
                    </Border.Effect>
                </Border>

                <!-- Inner Logo Container -->
                <Border Width="76" Height="76" CornerRadius="38" Background="#152033" BorderBrush="#1E293B" BorderThickness="1">
                    <Image Source="/Assets/Images/vayu_logo.png" Width="52" Height="52"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
            </Grid>

            <!-- App Title -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="VAYU" FontSize="26" FontWeight="Black" Foreground="#FFFFFF" TextAlignment="Center"/>
                <TextBlock Text="CLIENT" FontSize="26" FontWeight="Black" Foreground="{StaticResource VayuBrightBlueBrush}" Margin="6,0,0,0" TextAlignment="Center"/>
            </StackPanel>

            <!-- Subtitle Badge -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,28">
                <Border Background="#152033" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="8,3">
                    <TextBlock Text="MODERN GAMING CLIENT • ANSH9BOSS" 
                               FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource VayuBrightBlueBrush}" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>

            <!-- Lunar-Style Glowing Progress Bar Track -->
            <Border Width="320" Height="5" CornerRadius="2.5" 
                    Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1"
                    HorizontalAlignment="Center" ClipToBounds="True">
                <Border x:Name="ProgressFill" Width="0" HorizontalAlignment="Left" CornerRadius="2.5"
                        Background="{StaticResource VayuAccentGradient}">
                    <Border.Effect>
                        <DropShadowEffect Color="#3B82F6" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                    </Border.Effect>
                </Border>
            </Border>

            <!-- Real Loading Status & Percentage -->
            <Grid Width="320" Margin="0,12,0,0">
                <TextBlock x:Name="StatusLabel" Text="INITIALIZING VAYU CORE..." 
                           FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource VayuTextDimBrush}" HorizontalAlignment="Left"/>
                <TextBlock x:Name="PercentLabel" Text="0%" 
                           FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource VayuBrightBlueBrush}" HorizontalAlignment="Right"/>
            </Grid>
        </StackPanel>

        <!-- Bottom Hint -->
        <TextBlock Text="Press any key or click to skip" 
                   FontSize="10" Foreground="{StaticResource VayuTextMutedBrush}" 
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"/>
    </Grid>
</UserControl>
