<UserControl x:Class="VayuClient.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="780" d:DesignWidth="1080"
             Background="#06070B">

    <Grid>
        <!-- ═══ AMBIENT OCEAN MONUMENT 3D BACKGROUND ═══ -->
        <Image Source="/Assets/Images/bg_ocean_monument.jpg" 
               Stretch="UniformToFill" 
               HorizontalAlignment="Center" 
               VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality"
               Opacity="0.22"/>

        <!-- Deep Obsidian Gradient Overlay -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#D806070B" Offset="0.0"/>
                    <GradientStop Color="#EB06070B" Offset="0.55"/>
                    <GradientStop Color="#FA06070B" Offset="1.0"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Margin="28,20,28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- 1. TOP 5-TAB NAVIGATION 3D CAPSULE & CLOSE                      -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 3D Segmented Tabs Capsule -->
                <Border Grid.Column="0" CornerRadius="10" Background="#0C101D" BorderBrush="#251C3D" BorderThickness="1.2" Padding="4" HorizontalAlignment="Left">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.45"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Tab 1: Performance -->
                        <Button Content="🚀 Performance &amp; Hardware" 
                                Command="{Binding SelectTabCommand}" CommandParameter="Performance"
                                FontSize="12" FontWeight="Bold" Padding="14,8" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#7D7596"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" CornerRadius="7" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#1A122E"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Performance">
                                                        <Setter TargetName="Bd" Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="#7C3AED" Offset="0.0"/>
                                                                    <GradientStop Color="#9333EA" Offset="1.0"/>
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter TargetName="Bd" Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="#7C3AED" BlurRadius="10" ShadowDepth="1" Opacity="0.6"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Tab 2: Appearance -->
                        <Button Content="🎨 Appearance &amp; Themes" 
                                Command="{Binding SelectTabCommand}" CommandParameter="Appearance"
                                FontSize="12" FontWeight="Bold" Padding="14,8" Margin="4,0,0,0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#7D7596"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" CornerRadius="7" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#1A122E"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Appearance">
                                                        <Setter TargetName="Bd" Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="#7C3AED" Offset="0.0"/>
                                                                    <GradientStop Color="#9333EA" Offset="1.0"/>
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter TargetName="Bd" Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="#7C3AED" BlurRadius="10" ShadowDepth="1" Opacity="0.6"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Tab 3: Game Launch -->
                        <Button Content="🎮 Game Launch &amp; Display" 
                                Command="{Binding SelectTabCommand}" CommandParameter="GameLaunch"
                                FontSize="12" FontWeight="Bold" Padding="14,8" Margin="4,0,0,0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#7D7596"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" CornerRadius="7" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#1A122E"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding ActiveTab}" Value="GameLaunch">
                                                        <Setter TargetName="Bd" Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="#7C3AED" Offset="0.0"/>
                                                                    <GradientStop Color="#9333EA" Offset="1.0"/>
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter TargetName="Bd" Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="#7C3AED" BlurRadius="10" ShadowDepth="1" Opacity="0.6"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Tab 4: Network -->
                        <Button Content="🌐 Network &amp; Engine" 
                                Command="{Binding SelectTabCommand}" CommandParameter="Network"
                                FontSize="12" FontWeight="Bold" Padding="14,8" Margin="4,0,0,0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#7D7596"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" CornerRadius="7" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#1A122E"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Network">
                                                        <Setter TargetName="Bd" Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="#7C3AED" Offset="0.0"/>
                                                                    <GradientStop Color="#9333EA" Offset="1.0"/>
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter TargetName="Bd" Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="#7C3AED" BlurRadius="10" ShadowDepth="1" Opacity="0.6"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Tab 5: About & Specs -->
                        <Button Content="ℹ️ Hardware &amp; Specs" 
                                Command="{Binding SelectTabCommand}" CommandParameter="About"
                                FontSize="12" FontWeight="Bold" Padding="14,8" Margin="4,0,0,0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#7D7596"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" CornerRadius="7" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#1A122E"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding ActiveTab}" Value="About">
                                                        <Setter TargetName="Bd" Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="#7C3AED" Offset="0.0"/>
                                                                    <GradientStop Color="#9333EA" Offset="1.0"/>
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter TargetName="Bd" Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="#7C3AED" BlurRadius="10" ShadowDepth="1" Opacity="0.6"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 3D Close Button in top right -->
                <Button Grid.Column="1" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Command="{Binding CloseSettingsCommand}"
                        Style="{StaticResource VayuIconButton}"
                        Width="34" Height="34" FontSize="14" Foreground="#948EA5" Padding="0"/>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- 2. SETTINGS CONTENT AREA                                        -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource VayuScrollViewer}">
                <Grid>
                    <!-- ─── 1. PERFORMANCE & HARDWARE TAB ─── -->
                    <Grid Visibility="{Binding ActiveTab, Converter={StaticResource EqualValueToVis}, ConverterParameter=Performance}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 3D Live Performance Telemetry Gauge Banner -->
                        <Border Grid.Row="0" CornerRadius="10" Background="{StaticResource VayuCardGradient}" BorderBrush="{StaticResource Vayu3DBorderBrush}" BorderThickness="1.2" Padding="18,14" Margin="0,0,0,16">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.4"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Metric 1: Launcher CPU -->
                                <StackPanel Grid.Column="0" Margin="4,0">
                                    <TextBlock Text="LAUNCHER CPU" FontSize="10" FontWeight="Black" Foreground="#C084FC"/>
                                    <TextBlock Text="{Binding LiveLauncherCpu, StringFormat={}{0:F1}%}" FontSize="16" FontWeight="Black" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                                    <TextBlock Text="Process Time" FontSize="9.5" Foreground="{StaticResource VayuTextMutedBrush}"/>
                                </StackPanel>

                                <!-- Metric 2: Launcher RAM -->
                                <StackPanel Grid.Column="1" Margin="4,0">
                                    <TextBlock Text="LAUNCHER MEMORY" FontSize="10" FontWeight="Black" Foreground="#C084FC"/>
                                    <TextBlock Text="{Binding LiveLauncherMemoryMB, StringFormat={}{0:F0} MB}" FontSize="16" FontWeight="Black" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                                    <TextBlock Text="Working Set (RAM)" FontSize="9.5" Foreground="{StaticResource VayuTextMutedBrush}"/>
                                </StackPanel>

                                <!-- Metric 3: Host Available RAM -->
                                <StackPanel Grid.Column="2" Margin="4,0">
                                    <TextBlock Text="SYSTEM RAM FREE" FontSize="10" FontWeight="Black" Foreground="#C084FC"/>
                                    <TextBlock Text="{Binding LiveHostAvailableRamGB, StringFormat={}{0:F1} GB}" FontSize="16" FontWeight="Black" Foreground="#38BDF8" Margin="0,2,0,0"/>
                                    <TextBlock Text="Physical Free RAM" FontSize="9.5" Foreground="{StaticResource VayuTextMutedBrush}"/>
                                </StackPanel>

                                <!-- Metric 4: Minecraft Process State -->
                                <StackPanel Grid.Column="3" Margin="4,0">
                                    <TextBlock Text="GAME PROCESS" FontSize="10" FontWeight="Black" Foreground="#C084FC"/>
                                    <TextBlock Text="{Binding LiveMinecraftStatus}" FontSize="13" FontWeight="Black" Foreground="#4ADE80" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                    <TextBlock Text="Game Session" FontSize="9.5" Foreground="{StaticResource VayuTextMutedBrush}"/>
                                </StackPanel>

                                <!-- Metric 5: Minecraft Telemetry / FPS -->
                                <StackPanel Grid.Column="4" Margin="4,0">
                                    <TextBlock Text="MINECRAFT FPS" FontSize="10" FontWeight="Black" Foreground="#C084FC"/>
                                    <TextBlock Text="{Binding LiveFpsDisplay}" FontSize="12" FontWeight="Bold" Foreground="#948EA5" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                    <TextBlock Text="Real In-Game Telemetry" FontSize="9.5" Foreground="{StaticResource VayuTextMutedBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Two Column Settings Controls -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Column: Performance Mode & RAM -->
                            <StackPanel Grid.Column="0">
                                <!-- Performance Mode Card -->
                                <Border CornerRadius="10" Background="{StaticResource VayuCardGradient}" BorderBrush="{StaticResource Vayu3DBorderBrush}" BorderThickness="1.2" Padding="18,16" Margin="0,0,0,16">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.35"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="SYSTEM PERFORMANCE MODE" FontSize="11" FontWeight="Black" Foreground="#C084FC" Margin="0,0,0,8"/>
                                        <ComboBox ItemsSource="{Binding PerformanceModes}"
                                                  SelectedItem="{Binding SelectedPerformanceMode}"
                                                  Style="{StaticResource VayuComboBox}" Height="36" Margin="0,0,0,8"/>
                                        <TextBlock Text="Dynamically configures CPU threads, discrete GPU offload, GC flags, and memory limits."
                                                   FontSize="11" Foreground="{StaticResource VayuTextMutedBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Dynamic System Recommendation Tip -->
                                <Border CornerRadius="10" Background="#120E22" BorderBrush="#7C3AED" BorderThickness="1.2" Padding="16,12" Margin="0,0,0,16">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#7C3AED" BlurRadius="12" ShadowDepth="1" Opacity="0.3"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="💡 HARDWARE RECOMMENDATION" FontSize="10.5" FontWeight="Black" Foreground="#C084FC" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding Hardware.RecommendationTip}" FontSize="11" Foreground="#E2E8F0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- ══ Smart RAM Recommendations Card (Feature 14) ══ -->
                                <Border CornerRadius="10" Background="{StaticResource VayuCardGradient}" BorderBrush="{StaticResource Vayu3DBorderBrush}" BorderThickness="1.2" Padding="18,16" Margin="0,0,0,16">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.35"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <!-- Header: Active Instance + Allocation Display -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="INSTANCE RAM ALLOCATION" FontSize="11" FontWeight="Black" Foreground="#C084FC"/>
                                                <TextBlock Text="{Binding ActiveInstanceNameForRam}" FontSize="10.5" Foreground="{StaticResource VayuTextMutedBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding InstanceRamDisplay}" FontSize="13.5" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- 3D Slider (only when instance selected) -->
                                        <Slider Value="{Binding InstanceRamMB}" Minimum="512" Maximum="32768" SmallChange="256" LargeChange="1024"
                                                IsEnabled="{Binding HasActiveInstanceForRam}"
                                                Style="{StaticResource VayuGlassSlider}" Margin="0,0,0,10"/>

                                        <!-- Preset Buttons Row -->
                                        <WrapPanel Margin="0,0,0,10">
                                            <Button Content="2 GB" CommandParameter="2048" Command="{Binding SetInstanceRamCommand}"
                                                    Visibility="{Binding ShowPreset2GB, Converter={StaticResource BoolToVis}}"
                                                    IsEnabled="{Binding HasActiveInstanceForRam}"
                                                    Style="{StaticResource Vayu3DButton}" Padding="10,5" Margin="0,0,6,6" FontSize="11"/>
                                            <Button Content="4 GB" CommandParameter="4096" Command="{Binding SetInstanceRamCommand}"
                                                    Visibility="{Binding ShowPreset4GB, Converter={StaticResource BoolToVis}}"
                                                    IsEnabled="{Binding HasActiveInstanceForRam}"
                                                    Style="{StaticResource Vayu3DButton}" Padding="10,5" Margin="0,0,6,6" FontSize="11"/>
                                            <Button Content="6 GB" CommandParameter="6144" Command="{Binding SetInstanceRamCommand}"
                                                    Visibility="{Binding ShowPreset6GB, Converter={StaticResource BoolToVis}}"
                                                    IsEnabled="{Binding HasActiveInstanceForRam}"
                                                    Style="{StaticResource Vayu3DButton}" Padding="10,5" Margin="0,0,6,6" FontSize="11"/>
                                            <Button Content="8 GB" CommandParameter="8192" Command="{Binding SetInstanceRamCommand}"
                                                    Visibility="{Binding ShowPreset8GB, Converter={StaticResource BoolToVis}}"
                                                    IsEnabled="{Binding HasActiveInstanceForRam}"
                                                    Style="{StaticResource Vayu3DButton}" Padding="10,5" Margin="0,0,6,6" FontSize="11"/>
                                            <Button Content="12 GB" CommandParameter="12288" Command="{Binding SetInstanceRamCommand}"
                                                    Visibility="{Binding ShowPreset12GB, Converter={StaticResource BoolToVis}}"
                                                    IsEnabled="{Binding HasActiveInstanceForRam}"
                                                    Style="{StaticResource Vayu3DButton}" Padding="10,5" Margin="0,0,6,6" FontSize="11"/>
                                            <Button Content="16 GB" CommandParameter="16384" Command="{Binding SetInstanceRamCommand}"
                                                    Visibility="{Binding ShowPreset16GB, Converter={StaticResource BoolToVis}}"
                                                    IsEnabled="{Binding HasActiveInstanceForRam}"
                                                    Style="{StaticResource Vayu3DButton}" Padding="10,5" Margin="0,0,6,6" FontSize="11"/>
                                            <Button Content="⭐ Recommended" Command="{Binding ApplyRecommendedRamCommand}"
                                                    IsEnabled="{Binding HasActiveInstanceForRam}"
                                                    Style="{StaticResource Vayu3DPrimaryButton}" Padding="10,5" Margin="0,0,6,6" FontSize="11"/>
                                        </WrapPanel>

                                        <!-- Hardware Reference Row -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="TOTAL RAM" FontSize="9.5" FontWeight="Black" Foreground="{StaticResource VayuTextMutedBrush}"/>
                                                <TextBlock Text="{Binding SystemTotalRamDisplay}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="AVAILABLE NOW" FontSize="9.5" FontWeight="Black" Foreground="{StaticResource VayuTextMutedBrush}"/>
                                                <TextBlock Text="{Binding SystemAvailableRamDisplay}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="SAFE MAX (75%)" FontSize="9.5" FontWeight="Black" Foreground="{StaticResource VayuTextMutedBrush}"/>
                                                <TextBlock Text="{Binding SafeMaxRamDisplay}" FontSize="11" FontWeight="Bold" Foreground="#4ADE80"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Over-allocation Warning (real-time) -->
                                        <Border CornerRadius="6" Background="#2D1A0A" BorderBrush="#F59E0B" BorderThickness="1" Padding="10,8" Margin="0,0,0,6"
                                                Visibility="{Binding ShowRamWarning, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding RamWarningText}" FontSize="10.5" Foreground="#FCD34D" TextWrapping="Wrap"/>
                                        </Border>

                                        <!-- No-instance hint -->
                                        <TextBlock Text="Select an instance on the Home screen to configure per-instance RAM."
                                                   FontSize="10.5" Foreground="{StaticResource VayuTextMutedBrush}"
                                                   Visibility="{Binding HasActiveInstanceForRam, Converter={StaticResource InverseBoolToVis}}"/>

                                        <TextBlock Text="Changes are persisted immediately to instance.json and injected as -Xmx on next launch."
                                                   FontSize="10.5" Foreground="{StaticResource VayuTextMutedBrush}" Margin="0,4,0,0"
                                                   Visibility="{Binding HasActiveInstanceForRam, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Global Default RAM (for new instances) -->
                                <Border CornerRadius="10" Background="{StaticResource VayuCardGradient}" BorderBrush="{StaticResource Vayu3DBorderBrush}" BorderThickness="1.2" Padding="18,16" Margin="0,0,0,16">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.35"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <TextBlock Text="NEW INSTANCE DEFAULT RAM" FontSize="11" FontWeight="Black" Foreground="#C084FC"/>
                                            <TextBlock Text="{Binding RamDisplay}" FontSize="12" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Slider Value="{Binding DefaultRamMB}" Minimum="1024" Maximum="16384" SmallChange="512" LargeChange="1024"
                                                Style="{StaticResource VayuGlassSlider}" Margin="0,0,0,8"/>
                                        <TextBlock Text="Default -Xmx applied when creating new instances. Does not override existing per-instance settings."
                                                   FontSize="11" Foreground="{StaticResource VayuTextMutedBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Right Column: GPU & JVM Optimization -->
                            <StackPanel Grid.Column="2">
                                <!-- Dedicated GPU & Hardware Toggle -->
                                <Border CornerRadius="10" Background="{StaticResource VayuCardGradient}" BorderBrush="{StaticResource Vayu3DBorderBrush}" BorderThickness="1.2" Padding="18,16" Margin="0,0,0,16">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.35"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="HARDWARE ACCELERATION" FontSize="11" FontWeight="Black" Foreground="#C084FC" Margin="0,0,0,12"/>
                                        <CheckBox IsChecked="{Binding UseDedicatedGpu}" Style="{StaticResource VayuCheckBox}" Margin="0,0,0,10">
                                            <TextBlock Text="Prefer Dedicated High-Performance GPU" FontSize="12.5" Foreground="#FFFFFF"/>
                                        </CheckBox>
                                        <TextBlock Text="Directs Windows graphics scheduler to assign discrete NVIDIA / AMD GPUs to Minecraft."
                                                   FontSize="11" Foreground="{StaticResource VayuTextMutedBrush}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Java Runtime Selector Card -->
                                <Border CornerRadius="10" Background="{StaticResource VayuCardGradient}" BorderBrush="{StaticResource Vayu3DBorderBrush}" BorderThickness="1.2" Padding="18,16" Margin="0,0,0,16">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.35"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="INSTALLED JAVA RUNTIMES" FontSize="11" FontWeight="Black" Foreground="#C084FC" Margin="0,0,0,8"/>
                                        <ComboBox ItemsSource="{Binding AvailableJavaRuntimes}"
                                                  SelectedItem="{Binding SelectedJavaRuntime}"
                                                  Style="{StaticResource VayuComboBox}" Height="36" Margin="0,0,0,8"/>
                                        <TextBlock Text="Auto-Detect LTS strictly matches Java 21 LTS to 1.20.5+ preventing runtime incompatibility crashes."
                                                   FontSize="11" Foreground="{StaticResource VayuTextMutedBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- JVM Preset Card -->
                                <Border CornerRadius="10" Background="{StaticResource VayuCardGradient}" BorderBrush="{StaticResource Vayu3DBorderBrush}" BorderThickness="1.2" Padding="18,16" Margin="0,0,0,16">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.35"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="JVM OPTIMIZER PRESETS" FontSize="11" FontWeight="Black" Foreground="#C084FC" Margin="0,0,0,8"/>
                                        <ComboBox ItemsSource="{Binding JvmPresets}"
                                                  SelectedItem="{Binding SelectedJvmPreset}"
                                                  Style="{StaticResource VayuComboBox}" Height="36" Margin="0,0,0,8"/>
                                        <TextBlock Text="Optimizes garbage collection parameters, heap region sizing, and thread priority for stutter-free gameplay."
                                                   FontSize="11" Foreground="{StaticResource VayuTextMutedBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- System Benchmark Diagnostic Section -->
                        <Border Grid.Row="2" CornerRadius="10" Background="{StaticResource VayuCardGradient}" BorderBrush="{StaticResource Vayu3DBorderBrush}" BorderThickness="1.2" Padding="18,16" Margin="0,0,0,16">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.35"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="SYSTEM &amp; PIPELINE BENCHMARK" FontSize="11" FontWeight="Black" Foreground="#C084FC" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding BenchmarkReport}" FontSize="11" Foreground="#CBD5E1" TextWrapping="Wrap" FontFamily="Consolas, monospace"/>
                                </StackPanel>

                                <Button Grid.Column="1" Content="⚡ Run Benchmark"
                                        Command="{Binding RunBenchmarkCommand}"
                                        Style="{StaticResource Vayu3DPrimaryButton}"
                                        VerticalAlignment="Center" Margin="16,0,0,0" Padding="18,8"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ─── 2. APPEARANCE TAB ─── -->
                    <Grid Visibility="{Binding ActiveTab, Converter={StaticResource EqualValueToVis}, ConverterParameter=Appearance}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Wallpaper Customizer -->
                        <StackPanel Grid.Column="0">
                            <Border CornerRadius="10" Background="{StaticResource VayuCardGradient}" BorderBrush="{StaticResource Vayu3DBorderBrush}" BorderThickness="1.2" Padding="18,16" Margin="0,0,0,16">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.35"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="MINECRAFT WALLPAPER THEME" FontSize="11" FontWeight="Black" Foreground="#C084FC" Margin="0,0,0,8"/>
                                    <ComboBox ItemsSource="{Binding AvailableWallpapers}"
                                              SelectedItem="{Binding SelectedThemeWallpaper}"
                                              Style="{StaticResource VayuComboBox}" Height="36" Margin="0,0,0,14"/>

                                    <TextBlock Text="BACKGROUND OPACITY &amp; VIBRANCY" FontSize="11" FontWeight="Black" Foreground="#C084FC" Margin="0,0,0,6"/>
                                    <Slider Value="{Binding BackgroundDimOpacity}" Minimum="0.10" Maximum="0.80" SmallChange="0.05" LargeChange="0.10"
                                            Style="{StaticResource VayuGlassSlider}" Margin="0,0,0,6"/>
                                    <TextBlock Text="Adjusts ambient landscape background brightness across all launcher views."
                                               FontSize="11" Foreground="{StaticResource VayuTextMutedBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right Column: Visual Effects & Language -->
                        <StackPanel Grid.Column="2">
                            <Border CornerRadius="10" Background="{StaticResource VayuCardGradient}" BorderBrush="{StaticResource Vayu3DBorderBrush}" BorderThickness="1.2" Padding="18,16" Margin="0,0,0,16">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.35"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="VISUAL EFFECTS &amp; ANIMATIONS" FontSize="11" FontWeight="Black" Foreground="#C084FC" Margin="0,0,0,12"/>
                                    
                                    <!-- Animation Quality Selector -->
                                    <TextBlock Text="ANIMATION SYSTEM PROFILE" FontSize="10.5" FontWeight="Bold" Foreground="#948EA5" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding AnimationQualities}" SelectedItem="{Binding SelectedAnimationQuality}"
                                              Style="{StaticResource VayuComboBox}" Height="36" Margin="0,0,0,12"/>

                                    <CheckBox IsChecked="{Binding SmoothAnimations}" Style="{StaticResource VayuCheckBox}" Margin="0,0,0,10">
                                        <TextBlock Text="Enable Smooth Hardware Accelerated Transitions" FontSize="12" Foreground="#FFFFFF"/>
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding DarkTheme}" Style="{StaticResource VayuCheckBox}" Margin="0,0,0,14">
                                        <TextBlock Text="Deep Obsidian Dark Mode &amp; Cyber Glow" FontSize="12" Foreground="#FFFFFF"/>
                                    </CheckBox>

                                    <TextBlock Text="LANGUAGE" FontSize="11" FontWeight="Black" Foreground="#C084FC" Margin="0,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedLanguage}"
                                              Style="{StaticResource VayuComboBox}" Height="36"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ─── 3. GAME LAUNCH TAB ─── -->
                    <Grid Visibility="{Binding ActiveTab, Converter={StaticResource EqualValueToVis}, ConverterParameter=GameLaunch}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Resolution & Auto-Join -->
                        <StackPanel Grid.Column="0">
                            <Border CornerRadius="10" Background="{StaticResource VayuCardGradient}" BorderBrush="{StaticResource Vayu3DBorderBrush}" BorderThickness="1.2" Padding="18,16" Margin="0,0,0,16">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.35"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="DEFAULT GAME RESOLUTION" FontSize="11" FontWeight="Black" Foreground="#C084FC" Margin="0,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding ResolutionPresets}"
                                              SelectedItem="{Binding SelectedResolution}"
                                              Style="{StaticResource VayuComboBox}" Height="36" Margin="0,0,0,14"/>

                                    <TextBlock Text="AUTO-JOIN SERVER ADDRESS (OPTIONAL)" FontSize="11" FontWeight="Black" Foreground="#C084FC" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding AutoJoinServerIp, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource VayuGlassTextBox}" Height="36" Margin="0,0,0,6"/>
                                    <TextBlock Text="e.g., play.hypixel.net (automatically connects upon launching Minecraft)."
                                               FontSize="11" Foreground="{StaticResource VayuTextMutedBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right Column: Discord RPC & Console -->
                        <StackPanel Grid.Column="2">
                            <Border CornerRadius="10" Background="{StaticResource VayuCardGradient}" BorderBrush="{StaticResource Vayu3DBorderBrush}" BorderThickness="1.2" Padding="18,16" Margin="0,0,0,16">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.35"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="INTEGRATIONS &amp; LOGGING" FontSize="11" FontWeight="Black" Foreground="#C084FC" Margin="0,0,0,12"/>
                                    <CheckBox IsChecked="{Binding DiscordRichPresence}" Style="{StaticResource VayuCheckBox}" Margin="0,0,0,10">
                                        <TextBlock Text="Enable Discord Rich Presence Activity Status" FontSize="12.5" Foreground="#FFFFFF"/>
                                    </CheckBox>
                                    
                                    <StackPanel Margin="24,0,0,12" Visibility="{Binding DiscordRichPresence, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="DISCORD APPLICATION CLIENT ID" FontSize="10" FontWeight="Bold" Foreground="{StaticResource VayuTextMutedBrush}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding DiscordClientId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource VayuGlassTextBox}" Height="34" Margin="0,0,0,4"/>
                                        <TextBlock Text="Displays 'Playing VayuClient' / 'In Launcher' status with developer 'ANSH9BOSS' even in background." FontSize="10.5" Foreground="{StaticResource VayuTextMutedBrush}"/>
                                    </StackPanel>

                                    <CheckBox IsChecked="{Binding ShowLauncherConsole}" Style="{StaticResource VayuCheckBox}" Margin="0,0,0,12">
                                        <TextBlock Text="Show Live Minecraft Output &amp; Crash Console" FontSize="12.5" Foreground="#FFFFFF"/>
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding NativeTitleBar}" Style="{StaticResource VayuCheckBox}">
                                        <TextBlock Text="Use Windows Native Window Frame" FontSize="12.5" Foreground="#FFFFFF"/>
                                    </CheckBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ─── 4. NETWORK TAB ─── -->
                    <Grid Visibility="{Binding ActiveTab, Converter={StaticResource EqualValueToVis}, ConverterParameter=Network}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Concurrency & Acceleration -->
                        <StackPanel Grid.Column="0">
                            <Border CornerRadius="10" Background="{StaticResource VayuCardGradient}" BorderBrush="{StaticResource Vayu3DBorderBrush}" BorderThickness="1.2" Padding="18,16" Margin="0,0,0,16">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.35"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="PARALLEL DOWNLOAD THREADS" FontSize="11" FontWeight="Black" Foreground="#C084FC"/>
                                        <TextBlock Text="{Binding DownloadConcurrency, StringFormat={}{0} Connections}" FontSize="12" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider Value="{Binding DownloadConcurrency}" Minimum="1" Maximum="16" SmallChange="1" LargeChange="2"
                                            Style="{StaticResource VayuGlassSlider}" Margin="0,0,0,8"/>
                                    <TextBlock Text="Parallel connection count for downloading asset indexes, libraries, and modpacks."
                                               FontSize="11" Foreground="{StaticResource VayuTextMutedBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right Column: DNS & Protocol Settings -->
                        <StackPanel Grid.Column="2">
                            <Border CornerRadius="10" Background="{StaticResource VayuCardGradient}" BorderBrush="{StaticResource Vayu3DBorderBrush}" BorderThickness="1.2" Padding="18,16" Margin="0,0,0,16">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.35"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="NETWORK &amp; CDN PROTOCOLS" FontSize="11" FontWeight="Black" Foreground="#C084FC" Margin="0,0,0,12"/>
                                    <CheckBox IsChecked="{Binding DnsOverride}" Style="{StaticResource VayuCheckBox}" Margin="0,0,0,10">
                                        <TextBlock Text="Enable Fast Cloudflare / Google DoH Routing" FontSize="12.5" Foreground="#FFFFFF"/>
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding ForceLanOfflineMode}" Style="{StaticResource VayuCheckBox}" Margin="0,0,0,10">
                                        <TextBlock Text="Force Offline LAN Play (Zero Internet Requirement)" FontSize="12.5" Foreground="#FFFFFF"/>
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding ModernForgeInstaller}" Style="{StaticResource VayuCheckBox}">
                                        <TextBlock Text="Use Direct NeoForge / Fabric CDN Mirror" FontSize="12.5" Foreground="#FFFFFF"/>
                                    </CheckBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ─── 5. HARDWARE & SPECS TAB ─── -->
                    <Grid Visibility="{Binding ActiveTab, Converter={StaticResource EqualValueToVis}, ConverterParameter=About}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Detected Hardware Specs -->
                        <StackPanel Grid.Column="0">
                            <Border CornerRadius="10" Background="{StaticResource VayuCardGradient}" BorderBrush="{StaticResource Vayu3DBorderBrush}" BorderThickness="1.2" Padding="18,16" Margin="0,0,0,16">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.35"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="REAL SYSTEM HARDWARE TOPOLOGY" FontSize="11" FontWeight="Black" Foreground="#C084FC" Margin="0,0,0,12"/>

                                    <Border CornerRadius="6" Background="#0C101D" BorderBrush="#251C3D" BorderThickness="1" Padding="10,8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="PROCESSOR (CPU)" FontSize="9.5" FontWeight="Black" Foreground="#7D7596"/>
                                            <TextBlock Text="{Binding SystemCpuInfo}" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border CornerRadius="6" Background="#0C101D" BorderBrush="#251C3D" BorderThickness="1" Padding="10,8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="GRAPHICS ADAPTER (GPU)" FontSize="9.5" FontWeight="Black" Foreground="#7D7596"/>
                                            <TextBlock Text="{Binding SystemGpuInfo}" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border CornerRadius="6" Background="#0C101D" BorderBrush="#251C3D" BorderThickness="1" Padding="10,8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="PHYSICAL MEMORY (RAM)" FontSize="9.5" FontWeight="Black" Foreground="#7D7596"/>
                                            <TextBlock Text="{Binding SystemRamInfo}" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border CornerRadius="6" Background="#0C101D" BorderBrush="#251C3D" BorderThickness="1" Padding="10,8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="DISK CAPACITY" FontSize="9.5" FontWeight="Black" Foreground="#7D7596"/>
                                            <TextBlock Text="{Binding SystemDiskInfo}" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border CornerRadius="6" Background="#0C101D" BorderBrush="#251C3D" BorderThickness="1" Padding="10,8">
                                        <StackPanel>
                                            <TextBlock Text="OPERATING SYSTEM" FontSize="9.5" FontWeight="Black" Foreground="#7D7596"/>
                                            <TextBlock Text="{Binding SystemOsInfo}" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right Column: Software Architecture & Updates -->
                        <StackPanel Grid.Column="2">
                            <Border CornerRadius="10" Background="{StaticResource VayuCardGradient}" BorderBrush="{StaticResource Vayu3DBorderBrush}" BorderThickness="1.2" Padding="18,16" Margin="0,0,0,16">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.35"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="VAYUCLIENT™ ARCHITECTURE" FontSize="11" FontWeight="Black" Foreground="#C084FC" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Client Version:" Foreground="{StaticResource VayuTextMutedBrush}" FontSize="12"/>
                                        <TextBlock Text="{Binding AppVersion}" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Lead Developer:" Foreground="{StaticResource VayuTextMutedBrush}" FontSize="12"/>
                                        <TextBlock Text="{Binding DeveloperName}" Foreground="#C084FC" FontSize="12" FontWeight="Black" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Runtime Architecture:" Foreground="{StaticResource VayuTextMutedBrush}" FontSize="12"/>
                                        <TextBlock Text="{Binding Architecture}" Foreground="#FFFFFF" FontSize="12" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Graphics Engine:" Foreground="{StaticResource VayuTextMutedBrush}" FontSize="12"/>
                                        <TextBlock Text="{Binding GraphicsEngine}" Foreground="#FFFFFF" FontSize="12" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,14">
                                        <TextBlock Text="Distribution:" Foreground="{StaticResource VayuTextMutedBrush}" FontSize="12"/>
                                        <TextBlock Text="{Binding ReleaseInfo}" Foreground="#4ADE80" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- Action Buttons -->
                                    <Button Command="{Binding CheckForUpdatesCommand}"
                                            Style="{StaticResource Vayu3DPrimaryButton}"
                                            Height="40" Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="🔄" Margin="0,0,8,0" FontSize="12"/>
                                            <TextBlock Text="{Binding CheckForUpdatesButtonText}" 
                                                       FontSize="12" FontWeight="Black" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Real-time Update Status Indicator -->
                                    <TextBlock Text="{Binding UpdateStatusText}" 
                                               FontSize="11" Foreground="{StaticResource VayuTextMutedBrush}" 
                                               HorizontalAlignment="Center" Margin="0,0,0,12"/>

                                    <Button Content="📂 Open AppData Directory"
                                            Command="{Binding OpenAppDataFolderCommand}"
                                            Style="{StaticResource Vayu3DButton}"
                                            Height="38"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- 3. BOTTOM ACTION BAR DOCK                                       -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Restore Defaults"
                        Command="{Binding ResetToDefaultsCommand}"
                        Style="{StaticResource Vayu3DButton}"
                        Padding="18,9"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Cancel"
                            Command="{Binding CloseSettingsCommand}"
                            Style="{StaticResource Vayu3DButton}"
                            Margin="0,0,12,0" Padding="20,9"/>

                    <Button Content="Save Preferences"
                            Command="{Binding SaveSettingsCommand}"
                            Style="{StaticResource Vayu3DPrimaryButton}"
                            Padding="24,9"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
