<UserControl x:Class="VayuClient.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1050"
             Background="#070B14">

    <Grid>
        <!-- ═══ AMBIENT OCEAN MONUMENT BACKGROUND ═══ -->
        <Image Source="/Assets/Images/bg_ocean_monument.jpg" 
               Stretch="UniformToFill" 
               HorizontalAlignment="Center" 
               VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality"
               Opacity="0.38"/>

        <!-- Dark Gradient Overlay for Maximum Readability -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#CC070B14" Offset="0.0"/>
                    <GradientStop Color="#E6070B14" Offset="0.6"/>
                    <GradientStop Color="#F8070B14" Offset="1.0"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Margin="28,20,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══ TOP 5-TAB NAVIGATION HEADER & CLOSE ═══ -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Tab 1: Performance -->
                    <Button Content="🚀 Performance &amp; JVM" 
                            Command="{Binding SelectTabCommand}" CommandParameter="Performance"
                            FontSize="13" FontWeight="Bold" Margin="0,0,16,0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource VayuDarkButton}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="{StaticResource VayuTextDimBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Performance">
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                        <Setter Property="BorderBrush" Value="#2563EB"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Tab 2: Appearance -->
                    <Button Content="🎨 Appearance &amp; Themes" 
                            Command="{Binding SelectTabCommand}" CommandParameter="Appearance"
                            FontSize="13" FontWeight="Bold" Margin="0,0,16,0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource VayuDarkButton}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="{StaticResource VayuTextDimBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Appearance">
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                        <Setter Property="BorderBrush" Value="#2563EB"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Tab 3: Game Launch -->
                    <Button Content="🎮 Game Launch &amp; Display" 
                            Command="{Binding SelectTabCommand}" CommandParameter="GameLaunch"
                            FontSize="13" FontWeight="Bold" Margin="0,0,16,0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource VayuDarkButton}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="{StaticResource VayuTextDimBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="GameLaunch">
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                        <Setter Property="BorderBrush" Value="#2563EB"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Tab 4: Network -->
                    <Button Content="🌐 Network &amp; Engine" 
                            Command="{Binding SelectTabCommand}" CommandParameter="Network"
                            FontSize="13" FontWeight="Bold" Margin="0,0,16,0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource VayuDarkButton}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="{StaticResource VayuTextDimBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Network">
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                        <Setter Property="BorderBrush" Value="#2563EB"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Tab 5: About & Specs -->
                    <Button Content="ℹ️ About &amp; System" 
                            Command="{Binding SelectTabCommand}" CommandParameter="About"
                            FontSize="13" FontWeight="Bold" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource VayuDarkButton}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="{StaticResource VayuTextDimBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="About">
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                        <Setter Property="BorderBrush" Value="#2563EB"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Close Button in top right -->
                <Button Grid.Column="1" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Command="{Binding CloseSettingsCommand}"
                        FontSize="14" Foreground="{StaticResource VayuTextDimBrush}"
                        Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="8,4"/>
            </Grid>

            <!-- ═══ CONTENT AREA ═══ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource VayuScrollViewer}">
                <Grid>
                    <!-- ─── 1. PERFORMANCE TAB ─── -->
                    <Grid Visibility="{Binding ActiveTab, Converter={StaticResource EqualValueToVis}, ConverterParameter=Performance}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: RAM & Java Runtime -->
                        <StackPanel Grid.Column="0">
                            <!-- RAM Slider Card -->
                            <Border CornerRadius="8" Background="{StaticResource VayuSurfaceBrush}" BorderBrush="{StaticResource VayuBorderBrush}" BorderThickness="1" Padding="18,16" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="DEFAULT MEMORY ALLOCATION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource VayuBrightBlueBrush}"/>
                                        <TextBlock Text="{Binding RamDisplay}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider Value="{Binding DefaultRamMB}" Minimum="1024" Maximum="16384" SmallChange="512" LargeChange="1024"
                                            Style="{StaticResource VayuGlassSlider}" Margin="0,0,0,8"/>
                                    <TextBlock Text="Allocated maximum heap (-Xmx) for newly created instances and default launches."
                                               FontSize="11" Foreground="{StaticResource VayuTextMutedBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Java Runtime Selector Card -->
                            <Border CornerRadius="8" Background="{StaticResource VayuSurfaceBrush}" BorderBrush="{StaticResource VayuBorderBrush}" BorderThickness="1" Padding="18,16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="INSTALLED JAVA RUNTIMES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource VayuBrightBlueBrush}" Margin="0,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding AvailableJavaRuntimes}"
                                              SelectedItem="{Binding SelectedJavaRuntime}"
                                              Style="{StaticResource VayuComboBox}" Height="36" Margin="0,0,0,8"/>
                                    <TextBlock Text="Auto-Detect automatically chooses the optimal LTS runtime (Java 21 for 1.21+, Java 17 for 1.18-1.20, Java 8 for legacy)."
                                               FontSize="11" Foreground="{StaticResource VayuTextMutedBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right Column: GPU & JVM Optimization -->
                        <StackPanel Grid.Column="2">
                            <!-- Dedicated GPU & Hardware Toggle -->
                            <Border CornerRadius="8" Background="{StaticResource VayuSurfaceBrush}" BorderBrush="{StaticResource VayuBorderBrush}" BorderThickness="1" Padding="18,16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="HARDWARE ACCELERATION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource VayuBrightBlueBrush}" Margin="0,0,0,12"/>
                                    <CheckBox IsChecked="{Binding UseDedicatedGpu}" Style="{StaticResource VayuCheckBox}" Margin="0,0,0,10">
                                        <TextBlock Text="Force Dedicated High-Performance GPU" FontSize="12.5" Foreground="#FFFFFF"/>
                                    </CheckBox>
                                    <TextBlock Text="Forces Windows &amp; Minecraft to utilize the discrete NVIDIA / AMD graphics adapter."
                                               FontSize="11" Foreground="{StaticResource VayuTextMutedBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- JVM Preset Card -->
                            <Border CornerRadius="8" Background="{StaticResource VayuSurfaceBrush}" BorderBrush="{StaticResource VayuBorderBrush}" BorderThickness="1" Padding="18,16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="JVM OPTIMIZER PRESETS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource VayuBrightBlueBrush}" Margin="0,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding JvmPresets}"
                                              SelectedItem="{Binding SelectedJvmPreset}"
                                              Style="{StaticResource VayuComboBox}" Height="36" Margin="0,0,0,8"/>
                                    <TextBlock Text="Optimizes garbage collection parameters, heap region sizing, and thread priority for zero stutter."
                                               FontSize="11" Foreground="{StaticResource VayuTextMutedBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ─── 2. APPEARANCE TAB ─── -->
                    <Grid Visibility="{Binding ActiveTab, Converter={StaticResource EqualValueToVis}, ConverterParameter=Appearance}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Wallpaper Customizer -->
                        <StackPanel Grid.Column="0">
                            <Border CornerRadius="8" Background="{StaticResource VayuSurfaceBrush}" BorderBrush="{StaticResource VayuBorderBrush}" BorderThickness="1" Padding="18,16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="MINECRAFT WALLPAPER THEME" FontSize="11" FontWeight="Bold" Foreground="{StaticResource VayuBrightBlueBrush}" Margin="0,0,0,8"/>
                                    <ComboBox ItemsSource="{Binding AvailableWallpapers}"
                                              SelectedItem="{Binding SelectedThemeWallpaper}"
                                              Style="{StaticResource VayuComboBox}" Height="36" Margin="0,0,0,12"/>

                                    <TextBlock Text="BACKGROUND OPACITY &amp; VIBRANCY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource VayuBrightBlueBrush}" Margin="0,0,0,6"/>
                                    <Slider Value="{Binding BackgroundDimOpacity}" Minimum="0.10" Maximum="0.80" SmallChange="0.05" LargeChange="0.10"
                                            Style="{StaticResource VayuGlassSlider}" Margin="0,0,0,6"/>
                                    <TextBlock Text="Adjusts ambient landscape background brightness across all launcher views."
                                               FontSize="11" Foreground="{StaticResource VayuTextMutedBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right Column: Visual Effects & Language -->
                        <StackPanel Grid.Column="2">
                            <Border CornerRadius="8" Background="{StaticResource VayuSurfaceBrush}" BorderBrush="{StaticResource VayuBorderBrush}" BorderThickness="1" Padding="18,16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="VISUAL EFFECTS &amp; ANIMATIONS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource VayuBrightBlueBrush}" Margin="0,0,0,12"/>
                                    <CheckBox IsChecked="{Binding SmoothAnimations}" Style="{StaticResource VayuCheckBox}" Margin="0,0,0,10">
                                        <TextBlock Text="Enable Smooth 60 FPS Interface Transitions" FontSize="12.5" Foreground="#FFFFFF"/>
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding DarkTheme}" Style="{StaticResource VayuCheckBox}" Margin="0,0,0,12">
                                        <TextBlock Text="Deep OLED Dark Mode &amp; Glassmorphism" FontSize="12.5" Foreground="#FFFFFF"/>
                                    </CheckBox>

                                    <TextBlock Text="LANGUAGE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource VayuBrightBlueBrush}" Margin="0,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedLanguage}"
                                              Style="{StaticResource VayuComboBox}" Height="36"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ─── 3. GAME LAUNCH TAB ─── -->
                    <Grid Visibility="{Binding ActiveTab, Converter={StaticResource EqualValueToVis}, ConverterParameter=GameLaunch}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Resolution & Auto-Join -->
                        <StackPanel Grid.Column="0">
                            <Border CornerRadius="8" Background="{StaticResource VayuSurfaceBrush}" BorderBrush="{StaticResource VayuBorderBrush}" BorderThickness="1" Padding="18,16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="DEFAULT GAME RESOLUTION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource VayuBrightBlueBrush}" Margin="0,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding ResolutionPresets}"
                                              SelectedItem="{Binding SelectedResolution}"
                                              Style="{StaticResource VayuComboBox}" Height="36" Margin="0,0,0,14"/>

                                    <TextBlock Text="AUTO-JOIN SERVER ADDRESS (OPTIONAL)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource VayuBrightBlueBrush}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding AutoJoinServerIp, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource VayuGlassTextBox}" Height="36" Margin="0,0,0,6"/>
                                    <TextBlock Text="e.g., play.hypixel.net (automatically connects upon launching Minecraft)."
                                               FontSize="11" Foreground="{StaticResource VayuTextMutedBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right Column: Discord RPC & Console -->
                        <StackPanel Grid.Column="2">
                            <Border CornerRadius="8" Background="{StaticResource VayuSurfaceBrush}" BorderBrush="{StaticResource VayuBorderBrush}" BorderThickness="1" Padding="18,16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="INTEGRATIONS &amp; LOGGING" FontSize="11" FontWeight="Bold" Foreground="{StaticResource VayuBrightBlueBrush}" Margin="0,0,0,12"/>
                                    <CheckBox IsChecked="{Binding DiscordRichPresence}" Style="{StaticResource VayuCheckBox}" Margin="0,0,0,10">
                                        <TextBlock Text="Enable Discord Rich Presence Activity Status" FontSize="12.5" Foreground="#FFFFFF"/>
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding ShowLauncherConsole}" Style="{StaticResource VayuCheckBox}" Margin="0,0,0,12">
                                        <TextBlock Text="Show Live Minecraft Console Log on Game Launch" FontSize="12.5" Foreground="#FFFFFF"/>
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding NativeTitleBar}" Style="{StaticResource VayuCheckBox}">
                                        <TextBlock Text="Use Standard Windows OS Title Bar" FontSize="12.5" Foreground="#FFFFFF"/>
                                    </CheckBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ─── 4. NETWORK TAB ─── -->
                    <Grid Visibility="{Binding ActiveTab, Converter={StaticResource EqualValueToVis}, ConverterParameter=Network}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Concurrency -->
                        <StackPanel Grid.Column="0">
                            <Border CornerRadius="8" Background="{StaticResource VayuSurfaceBrush}" BorderBrush="{StaticResource VayuBorderBrush}" BorderThickness="1" Padding="18,16" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="DOWNLOAD CONCURRENCY THREADS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource VayuBrightBlueBrush}"/>
                                        <TextBlock Text="{Binding DownloadConcurrency, StringFormat='{}{0} Threads'}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider Value="{Binding DownloadConcurrency}" Minimum="1" Maximum="16" SmallChange="1" LargeChange="2"
                                            Style="{StaticResource VayuGlassSlider}" Margin="0,0,0,8"/>
                                    <TextBlock Text="Controls parallel asset, library, and mod downloading concurrency."
                                               FontSize="11" Foreground="{StaticResource VayuTextMutedBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right Column: Protocol Options -->
                        <StackPanel Grid.Column="2">
                            <Border CornerRadius="8" Background="{StaticResource VayuSurfaceBrush}" BorderBrush="{StaticResource VayuBorderBrush}" BorderThickness="1" Padding="18,16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="NETWORK PROTOCOLS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource VayuBrightBlueBrush}" Margin="0,0,0,12"/>
                                    <CheckBox IsChecked="{Binding DnsOverride}" Style="{StaticResource VayuCheckBox}" Margin="0,0,0,10">
                                        <TextBlock Text="DNS-over-HTTPS (Cloudflare / Google Secure DNS)" FontSize="12.5" Foreground="#FFFFFF"/>
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding ModernForgeInstaller}" Style="{StaticResource VayuCheckBox}" Margin="0,0,0,10">
                                        <TextBlock Text="High-Speed Parallel Modrinth CDN Mirror" FontSize="12.5" Foreground="#FFFFFF"/>
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding ForceLanOfflineMode}" Style="{StaticResource VayuCheckBox}">
                                        <TextBlock Text="Enable Local LAN Offline Discovery" FontSize="12.5" Foreground="#FFFFFF"/>
                                    </CheckBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ─── 5. ABOUT & SYSTEM TAB ─── -->
                    <Grid Visibility="{Binding ActiveTab, Converter={StaticResource EqualValueToVis}, ConverterParameter=About}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: System Hardware Specs -->
                        <StackPanel Grid.Column="0">
                            <Border CornerRadius="8" Background="{StaticResource VayuSurfaceBrush}" BorderBrush="{StaticResource VayuBorderBrush}" BorderThickness="1" Padding="18,16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="HOST SYSTEM SPECIFICATIONS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource VayuBrightBlueBrush}" Margin="0,0,0,12"/>
                                    
                                    <TextBlock Text="PROCESSOR (CPU)" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource VayuTextDimBrush}"/>
                                    <TextBlock Text="{Binding SystemCpuInfo}" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,2,0,10"/>

                                    <TextBlock Text="SYSTEM MEMORY (RAM)" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource VayuTextDimBrush}"/>
                                    <TextBlock Text="{Binding SystemRamInfo}" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,2,0,10"/>

                                    <TextBlock Text="OPERATING SYSTEM" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource VayuTextDimBrush}"/>
                                    <TextBlock Text="{Binding SystemOsInfo}" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,2,0,10"/>

                                    <TextBlock Text="GRAPHICS ARCHITECTURE" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource VayuTextDimBrush}"/>
                                    <TextBlock Text="{Binding GraphicsEngine}" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </StackPanel>
                            </Border>

                            <!-- Data & Logs Actions -->
                            <Border CornerRadius="8" Background="{StaticResource VayuSurfaceBrush}" BorderBrush="{StaticResource VayuBorderBrush}" BorderThickness="1" Padding="18,16">
                                <StackPanel>
                                    <TextBlock Text="DIAGNOSTICS &amp; DIRECTORIES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource VayuBrightBlueBrush}" Margin="0,0,0,12"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource VayuDarkButton}" Padding="14,7" Command="{Binding OpenAppDataFolderCommand}" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource VayuIconFolder}" Fill="#94A3B8" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Open %AppData% Folder" FontSize="11.5"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource VayuDarkButton}" Padding="14,7" Command="{Binding ResetToDefaultsAsyncCommand}">
                                            <TextBlock Text="Reset Settings" FontSize="11.5" Foreground="#EF4444"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right Column: GitHub Updater & Developer -->
                        <StackPanel Grid.Column="2">
                            <!-- Live GitHub Auto-Updater Card -->
                            <Border CornerRadius="8" Background="#111A2C" BorderBrush="#2563EB" BorderThickness="1" Padding="18,16" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="GITHUB 1-CLICK AUTO-UPDATER" FontSize="11" FontWeight="Bold" Foreground="{StaticResource VayuBrightBlueBrush}"/>
                                        <Border CornerRadius="3" Background="#10251C" Padding="6,2" HorizontalAlignment="Right">
                                            <TextBlock Text="Online" FontSize="10" FontWeight="Bold" Foreground="#22C55E"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="Check for official releases, bug fixes, and client updates directly from GitHub."
                                               FontSize="11.5" Foreground="{StaticResource VayuTextDimBrush}" Margin="0,0,0,14" TextWrapping="Wrap"/>
                                    <Button Style="{StaticResource VayuAccentButton}" Padding="16,8"
                                            Command="{Binding CheckForUpdatesAsyncCommand}" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource VayuIconVersions}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Check for Updates Now" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Developer Credits Card -->
                            <Border CornerRadius="8" Background="{StaticResource VayuSurfaceBrush}" BorderBrush="{StaticResource VayuBorderBrush}" BorderThickness="1" Padding="18,16">
                                <StackPanel>
                                    <TextBlock Text="DEVELOPER TEAM &amp; CREDITS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource VayuBrightBlueBrush}" Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#152033" BorderBrush="#2563EB" BorderThickness="1.5" Margin="0,0,12,0">
                                            <TextBlock Text="A" FontSize="20" FontWeight="Black" Foreground="{StaticResource VayuBrightBlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DeveloperName}" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            <TextBlock Text="Lead Creator &amp; Systems Architect" FontSize="11.5" Foreground="{StaticResource VayuTextMutedBrush}"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock FontSize="11.5" Foreground="{StaticResource VayuTextDimBrush}" TextWrapping="Wrap" Margin="0,0,0,8">
                                        <Run Text="VayuClient™ is a registered high-performance native Minecraft desktop launcher engineered for maximum FPS, multi-instance isolation, and seamless mod management."/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding AppVersion}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource VayuTextMutedBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <!-- ═══ BOTTOM ACTION BAR ═══ -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Command="{Binding CloseSettingsCommand}"
                            Style="{StaticResource VayuDarkButton}" Padding="16,8" Margin="0,0,10,0"/>
                    <Button Content="Save Preferences" Command="{Binding SaveSettingsAsyncCommand}"
                            Style="{StaticResource VayuAccentButton}" Padding="20,8"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
