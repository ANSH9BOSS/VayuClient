<Window x:Class="VayuClient.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VayuClient.Views"
        xmlns:controls="clr-namespace:VayuClient.Controls"
        xmlns:core="clr-namespace:VayuClient.Core"
        xmlns:vm="clr-namespace:VayuClient.ViewModels"
        Title="VayuClient" Height="780" Width="1240"
        MinHeight="680" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource VayuFontFamily}"
        StateChanged="Window_StateChanged">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomePage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InstallationManagerViewModel}">
            <views:InstallationManagerPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModsViewModel}">
            <views:ModsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AccountsViewModel}">
            <views:AccountsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VersionsViewModel}">
            <views:VersionsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ServerViewModel}">
            <views:ServerPage/>
        </DataTemplate>
    </Window.Resources>

    <!-- Outer Window Frame with Dark Navy Background & Thin Border -->
    <Border Background="#070B14" 
            BorderBrush="#1E293B" 
            BorderThickness="1" 
            CornerRadius="10"
            SnapsToDevicePixels="True"
            ClipToBounds="True">
        
        <Grid>
            <!-- Lightweight Ambient Background Canvas -->
            <controls:AnimatedBackground x:Name="AnimBg" IsHitTestVisible="False"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="54"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ═══════════════════════════════════════════════ -->
                <!-- 1. TOP LUNAR-STYLE GAMING HEADER BAR            -->
                <!-- ═══════════════════════════════════════════════ -->
                <Grid Grid.Row="0" Background="#0A101D" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Brand Title & Official Logo -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <Image Source="/Assets/Images/vayu_logo.png" Width="26" Height="26" 
                               RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="VAYU" FontSize="14" FontWeight="Black" Foreground="#FFFFFF"/>
                                <TextBlock Text="CLIENT" FontSize="14" FontWeight="Black" Foreground="{StaticResource VayuBrightBlueBrush}" Margin="4,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{x:Static core:AppInfo.DisplayVersion}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource VayuTextMutedBrush}" Margin="0,-1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Center: Floating Gaming Navigation Pill Bar -->
                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="20" Padding="4,3">
                        <StackPanel Orientation="Horizontal">
                            
                            <!-- HOME TAB -->
                            <RadioButton Style="{StaticResource LunarNavButton}" 
                                         IsChecked="{Binding CurrentPage, Converter={StaticResource StringEqualConverter}, ConverterParameter='Home', Mode=OneWay}"
                                         Command="{Binding NavigateToCommand}" CommandParameter="Home" ToolTip="Home Screen">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource VayuIconHome}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                          Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="HOME" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- INSTANCES TAB -->
                            <RadioButton Style="{StaticResource LunarNavButton}" 
                                         IsChecked="{Binding CurrentPage, Converter={StaticResource StringEqualConverter}, ConverterParameter='InstallationManager', Mode=OneWay}"
                                         Command="{Binding NavigateToCommand}" CommandParameter="InstallationManager" ToolTip="Instances &amp; Modpacks">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource VayuIconInstances}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                          Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="INSTANCES" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- MODS TAB -->
                            <RadioButton Style="{StaticResource LunarNavButton}" 
                                         IsChecked="{Binding CurrentPage, Converter={StaticResource StringEqualConverter}, ConverterParameter='Mods', Mode=OneWay}"
                                         Command="{Binding NavigateToCommand}" CommandParameter="Mods" ToolTip="Mods Management">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource VayuIconMods}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                          Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="MODS" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- SERVERS TAB -->
                            <RadioButton Style="{StaticResource LunarNavButton}"
                                         IsChecked="{Binding CurrentPage, Converter={StaticResource StringEqualConverter}, ConverterParameter='Servers', Mode=OneWay}"
                                         Command="{Binding NavigateToCommand}" CommandParameter="Servers" ToolTip="Server Manager — Real-time SLP Ping">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource VayuIconServer}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                          Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="SERVERS" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- ACCOUNTS TAB -->
                            <RadioButton Style="{StaticResource LunarNavButton}" 
                                         IsChecked="{Binding CurrentPage, Converter={StaticResource StringEqualConverter}, ConverterParameter='Accounts', Mode=OneWay}"
                                         Command="{Binding NavigateToCommand}" CommandParameter="Accounts" ToolTip="Player Profiles &amp; Microsoft Accounts">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource VayuIconAccounts}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                          Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="ACCOUNTS" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- SETTINGS TAB -->
                            <RadioButton Style="{StaticResource LunarNavButton}" 
                                         IsChecked="{Binding CurrentPage, Converter={StaticResource StringEqualConverter}, ConverterParameter='Settings', Mode=OneWay}"
                                         Command="{Binding NavigateToCommand}" CommandParameter="Settings" ToolTip="Launcher &amp; Game Settings">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource VayuIconSettings}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                          Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="SETTINGS" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                        </StackPanel>
                    </Border>

                    <!-- Right: Active Profile Pill + Window Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                        
                        <!-- Profile Card Pill Button -->
                        <Button Command="{Binding NavigateToCommand}" CommandParameter="Accounts"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,12,0" Padding="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="PillBd" CornerRadius="16" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" Padding="6,4,12,4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Avatar / Minotar Head -->
                                            <Border Width="22" Height="22" CornerRadius="11" Background="#1E293B" Margin="0,0,8,0" ClipToBounds="True">
                                                <Image Source="{Binding ActiveProfile, Converter={StaticResource SkinHeadImage}}" 
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                            </Border>
                                            
                                            <!-- Username & Status Dot -->
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ActiveProfileUsernameDisplay, FallbackValue='No Profile'}" 
                                                           FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" MaxWidth="110" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="5" Height="5" Fill="{Binding HasActiveProfile, Converter={StaticResource BoolToOnlineStatusBrush}}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding ActiveProfileAccountTypeDisplay, FallbackValue='Not Logged In'}" 
                                                               FontSize="9.5" Foreground="{StaticResource VayuTextDimBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="PillBd" Property="Background" Value="#152033"/>
                                            <Setter TargetName="PillBd" Property="BorderBrush" Value="#3B82F6"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Window Controls -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource TitleBarButton}" Click="Minimize_Click" ToolTip="Minimize">
                                <TextBlock Text="—" FontSize="11" Foreground="{StaticResource VayuTextDimBrush}"/>
                            </Button>
                            <Button Style="{StaticResource TitleBarButton}" Click="Maximize_Click" ToolTip="Maximize / Restore">
                                <TextBlock x:Name="MaximizeIcon" Text="□" FontSize="12" Foreground="{StaticResource VayuTextDimBrush}"/>
                            </Button>
                            <Button Style="{StaticResource TitleBarCloseButton}" Click="Close_Click" ToolTip="Close">
                                <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource VayuTextDimBrush}"/>
                            </Button>
                        </StackPanel>

                    </StackPanel>
                </Grid>

                <!-- ═══════════════════════════════════════════════ -->
                <!-- 2. FULLSCREEN VIEW HOST CONTAINER               -->
                <!-- ═══════════════════════════════════════════════ -->
                <Grid Grid.Row="1" Background="#070B14">
                    
                    <ContentControl x:Name="PageHost" Content="{Binding CurrentPageViewModel}">
                        <ContentControl.RenderTransform>
                            <TranslateTransform x:Name="PageTranslate" Y="0"/>
                        </ContentControl.RenderTransform>
                    </ContentControl>

                    <!-- ═══════════════════════════════════════════════ -->
                    <!-- LIVE GITHUB AUTO-UPDATE BANNER                  -->
                    <!-- ═══════════════════════════════════════════════ -->
                    <Border Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}"
                            VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,12,0,0"
                            Background="#F00F172A" BorderBrush="#3B82F6" BorderThickness="1.5"
                            CornerRadius="8" Padding="14,8" Panel.ZIndex="100">
                        <Border.Effect>
                            <DropShadowEffect Color="#2563EB" BlurRadius="12" ShadowDepth="0" Opacity="0.45" RenderingBias="Performance"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#38BDF8" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="✨ UPDATE AVAILABLE:" FontSize="11.5" FontWeight="Black" Foreground="#60A5FA" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding LatestUpdateVersion, StringFormat='v{0}'}" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <Button Command="{Binding ApplyUpdateCommand}" Style="{StaticResource VayuPrimaryButton}" Padding="12,4" FontSize="11" FontWeight="Bold">
                                <TextBlock Text="Update Directly Now" Foreground="#FFFFFF"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- ═══════════════════════════════════════════════ -->
                    <!-- LIVE UPDATE DOWNLOAD OVERLAY                    -->
                    <!-- ═══════════════════════════════════════════════ -->
                    <Border Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVis}}"
                            Background="#CC070B14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            Panel.ZIndex="150">
                        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="#0F172A" BorderBrush="#3B82F6" BorderThickness="1.5"
                                CornerRadius="10" Padding="24,20" Width="380">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="DOWNLOADING UPDATE" FontSize="14" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding UpdateStatus, FallbackValue='Downloading latest setup installer...'}" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <ProgressBar Value="{Binding UpdateProgress}" Minimum="0" Maximum="100" Height="8" Width="320"
                                             Foreground="{StaticResource VayuBrightBlueBrush}" Background="#1E293B" BorderThickness="0" Margin="0,0,0,8"/>
                                <TextBlock Text="The installer will launch and restart VayuClient automatically." FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- Floating Toast Notifications (Top Right) -->
                    <ItemsControl ItemsSource="{Binding Notifications}" 
                                  HorizontalAlignment="Right" VerticalAlignment="Top" 
                                  Margin="0,16,20,0" IsHitTestVisible="True" Panel.ZIndex="50">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Background="#0F172A" BorderBrush="{StaticResource VayuAccentBrush}" BorderThickness="1.5"
                                        Padding="14,10" Margin="0,0,0,10" Width="320">
                                    <!-- Shadow removed from toast items: each item gets its own software raster — costly when animating in/out. The BorderBrush provides sufficient visual depth. -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{StaticResource VayuBrightBlueBrush}" 
                                                 VerticalAlignment="Top" Margin="0,4,10,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{StaticResource VayuTextDimBrush}" 
                                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </Grid>
            </Grid>

            <!-- First-Time Welcome / Onboarding Overlay -->
            <views:OnboardingView DataContext="{Binding OnboardingVM}" Visibility="{Binding IsOnboardingVisible, Converter={StaticResource BoolToVis}}" Panel.ZIndex="90"/>

            <!-- Splash Screen Transition Overlay -->
            <views:SplashView x:Name="SplashOverlay" Visibility="{Binding IsSplashVisible, Converter={StaticResource BoolToVis}}" Panel.ZIndex="100"/>
        </Grid>
    </Border>
</Window>
