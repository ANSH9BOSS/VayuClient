<Window x:Class="VayuClient.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VayuClient.Views"
        xmlns:controls="clr-namespace:VayuClient.Controls"
        xmlns:core="clr-namespace:VayuClient.Core"
        xmlns:vm="clr-namespace:VayuClient.ViewModels"
        Title="VayuClient" Height="780" Width="1240"
        MinHeight="680" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource VayuFontFamily}"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomePage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InstallationManagerViewModel}">
            <views:InstallationManagerPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModsViewModel}">
            <views:ModsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AccountsViewModel}">
            <views:AccountsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VersionsViewModel}">
            <views:VersionsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ServerViewModel}">
            <views:ServerPage/>
        </DataTemplate>
    </Window.Resources>

    <!-- Outer Window Frame: one obsidian shell around every page. -->
    <Border Background="{StaticResource VayuBackgroundGradient}"
            BorderBrush="{StaticResource Vayu3DBorderBrush}"
            BorderThickness="1" 
            CornerRadius="10"
            SnapsToDevicePixels="True"
            ClipToBounds="True">
        
        <Grid>
            <!-- Lightweight Ambient Background Canvas -->
            <controls:AnimatedBackground x:Name="AnimBg" IsHitTestVisible="False"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ═══════════════════════════════════════════════ -->
                <!-- 1. SLEEK MINIMALIST WINDOW HEADER (DRAGGABLE)   -->
                <!-- ═══════════════════════════════════════════════ -->
                <Grid Grid.Row="0" Background="#0C0817" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Brand Title & Official Logo -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Image Source="/Assets/Images/vayu_logo.png" Width="24" Height="24" 
                               RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="VAYU" FontSize="13.5" FontWeight="Black" Foreground="#FFFFFF"/>
                                <TextBlock Text="CLIENT" FontSize="13.5" FontWeight="Black" Foreground="#A855F7" Margin="4,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{x:Static core:AppInfo.DisplayVersion}" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource VayuTextMutedBrush}" Margin="0,-1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Center: Clear Draggable Title Bar Space -->
                    <Grid Grid.Column="1" Background="Transparent"/>

                    <!-- Right: Active Profile Pill + Window Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                        
                        <!-- Profile Card Pill Button -->
                        <Button Command="{Binding NavigateToCommand}" CommandParameter="Accounts"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,12,0" Padding="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="PillBd" CornerRadius="16" Background="#100B1D" BorderBrush="#2B1B46" BorderThickness="1" Padding="6,4,12,4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Avatar / Minotar Head -->
                                            <Border Width="22" Height="22" CornerRadius="11" Background="#211335" Margin="0,0,8,0" ClipToBounds="True">
                                                <controls:PlayerBody3D Profile="{Binding ActiveProfile}" DisplayMode="HeadOnly"/>
                                            </Border>
                                            
                                            <!-- Username & Status Dot -->
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ActiveProfileUsernameDisplay, FallbackValue='No Profile'}" 
                                                           FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" MaxWidth="110" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="5" Height="5" Fill="{Binding HasActiveProfile, Converter={StaticResource BoolToOnlineStatusBrush}}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding ActiveProfileAccountTypeDisplay, FallbackValue='Not Logged In'}" 
                                                               FontSize="9" Foreground="{StaticResource VayuTextDimBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="PillBd" Property="Background" Value="#1C1430"/>
                                            <Setter TargetName="PillBd" Property="BorderBrush" Value="#A855F7"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Window Controls -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource TitleBarButton}" Click="Minimize_Click" ToolTip="Minimize">
                                <TextBlock Text="—" FontSize="11" Foreground="{StaticResource VayuTextDimBrush}"/>
                            </Button>
                            <Button Style="{StaticResource TitleBarButton}" Click="Maximize_Click" ToolTip="Maximize / Restore">
                                <TextBlock x:Name="MaximizeIcon" Text="□" FontSize="12" Foreground="{StaticResource VayuTextDimBrush}"/>
                            </Button>
                            <Button Style="{StaticResource TitleBarCloseButton}" Click="Close_Click" ToolTip="Close">
                                <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource VayuTextDimBrush}"/>
                            </Button>
                        </StackPanel>

                    </StackPanel>
                </Grid>

                <!-- ═══════════════════════════════════════════════ -->
                <!-- 2. FULLSCREEN VIEW HOST CONTAINER               -->
                <!-- ═══════════════════════════════════════════════ -->
                <Grid Grid.Row="1" Background="Transparent">
                    
                    <ContentControl x:Name="PageHost" Content="{Binding CurrentPageViewModel}">
                        <ContentControl.RenderTransform>
                            <TranslateTransform x:Name="PageTranslate" Y="0"/>
                        </ContentControl.RenderTransform>
                    </ContentControl>

                    <!-- ═══════════════════════════════════════════════ -->
                    <!-- LIVE GITHUB AUTO-UPDATE BANNER                  -->
                    <!-- ═══════════════════════════════════════════════ -->
                    <Border Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}"
                            VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,12,0,0"
                            Background="#F0140D26" BorderBrush="#7C3AED" BorderThickness="1.5"
                            CornerRadius="8" Padding="14,8" Panel.ZIndex="100">
                        <Border.Effect>
                            <DropShadowEffect Color="#7C3AED" BlurRadius="12" ShadowDepth="0" Opacity="0.45" RenderingBias="Performance"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#A855F7" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="✨ UPDATE AVAILABLE:" FontSize="11.5" FontWeight="Black" Foreground="#C084FC" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding LatestUpdateVersion, StringFormat='v{0}'}" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <Button Command="{Binding ApplyUpdateCommand}" Style="{StaticResource VayuPrimaryButton}" Padding="12,4" FontSize="11" FontWeight="Bold">
                                <TextBlock Text="Update Directly Now" Foreground="#FFFFFF"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- ═══════════════════════════════════════════════ -->
                    <!-- LIVE UPDATE DOWNLOAD OVERLAY                    -->
                    <!-- ═══════════════════════════════════════════════ -->
                    <Border Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVis}}"
                            Background="#CC070B14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            Panel.ZIndex="150">
                        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="#120D22" BorderBrush="#7C3AED" BorderThickness="1.5"
                                CornerRadius="10" Padding="24,20" Width="380">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="DOWNLOADING UPDATE" FontSize="14" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding UpdateStatus, FallbackValue='Downloading latest setup installer...'}" FontSize="12" Foreground="#B7AECC" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <ProgressBar Value="{Binding UpdateProgress}" Minimum="0" Maximum="100" Height="8" Width="320"
                                             Foreground="{StaticResource VayuAccentBrush}" Background="#271842" BorderThickness="0" Margin="0,0,0,8"/>
                                <TextBlock Text="The installer will launch and restart VayuClient automatically." FontSize="10.5" Foreground="#8E84A6" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- Floating Toast Notifications (Top Right, Below Header) -->
                    <ItemsControl ItemsSource="{Binding Notifications}" 
                                  HorizontalAlignment="Right" VerticalAlignment="Top" 
                                  Margin="0,56,24,0" IsHitTestVisible="True" Panel.ZIndex="99">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Background="#140D26" BorderBrush="#4C2882" BorderThickness="1.2"
                                        Padding="14,10" Margin="0,0,0,10" Width="300">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#7C3AED" BlurRadius="16" ShadowDepth="0" Opacity="0.35" RenderingBias="Performance"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#A855F7" 
                                                 VerticalAlignment="Top" Margin="0,4,10,0">
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="#A855F7" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            <TextBlock Text="{Binding Message}" FontSize="11" Foreground="#A89FC0" 
                                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ═══════════════════════════════════════════════ -->
                    <!-- PERMANENT FLOATING BOTTOM DOCK NAVIGATION       -->
                    <!-- ═══════════════════════════════════════════════ -->
                    <controls:GlobalBottomDock VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                               Margin="0,0,0,16" Panel.ZIndex="120" IsHitTestVisible="True"/>

                </Grid>

            </Grid>

            <!-- First-Time Welcome / Onboarding Overlay -->
            <Grid Visibility="{Binding IsOnboardingVisible, Converter={StaticResource BoolToVis}}"
                  IsHitTestVisible="{Binding IsOnboardingVisible}"
                  Panel.ZIndex="100">
                <views:OnboardingView DataContext="{Binding OnboardingVM}"/>
            </Grid>

            <!-- Splash Screen Transition Overlay -->
            <views:SplashView x:Name="SplashOverlay"
                             Visibility="{Binding IsSplashVisible, Converter={StaticResource BoolToVis}}"
                             IsHitTestVisible="{Binding IsSplashVisible}"
                             Panel.ZIndex="200"/>
        </Grid>
    </Border>
</Window>
