<Window x:Class="VayuClient.Views.ErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VayuClient — Runtime Diagnostics"
        FontFamily="{StaticResource VayuFontFamily}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Width="640" Height="440"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Border CornerRadius="6" Background="#0B1220" BorderBrush="{StaticResource VayuBorderBrush}" BorderThickness="1">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Header -->
                <RowDefinition Height="Auto"/>  <!-- Message -->
                <RowDefinition Height="*"/>     <!-- Details -->
                <RowDefinition Height="Auto"/>  <!-- Actions -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="4"
                        Background="#25EF4444" BorderBrush="#EF4444" BorderThickness="1"
                        Margin="0,0,10,0">
                    <Path Data="{StaticResource VayuIconTrash}" Fill="#EF4444" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="VayuClient Diagnostics Notice" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="An exception occurred during execution." FontSize="11.5" Foreground="{StaticResource VayuTextDimBrush}"/>
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource TitleBarCloseButton}" Click="Close_Click">
                    <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource VayuTextDimBrush}"/>
                </Button>
            </Grid>

            <!-- Crash log location info -->
            <Border Grid.Row="1" CornerRadius="4" Background="#151F32" BorderBrush="#243247" BorderThickness="1"
                    Padding="12,10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock x:Name="TxtSummary" Text="VayuClient encountered an unexpected issue." 
                               FontWeight="SemiBold" FontSize="12.5" Foreground="#FFFFFF" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtLogLocation" Text="Log location: %APPDATA%\VayuClient\Logs\crash.log" 
                               FontSize="11" Foreground="{StaticResource VayuBrightBlueBrush}" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <!-- Error Details Box -->
            <Border Grid.Row="2" CornerRadius="4" Background="#0F172A" BorderBrush="#243247" BorderThickness="1"
                    Padding="10" Margin="0,0,0,14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                              Style="{StaticResource VayuScrollViewer}">
                    <TextBox x:Name="TxtDetails" IsReadOnly="True" TextWrapping="Wrap"
                             Background="Transparent" BorderThickness="0"
                             Foreground="#E2E8F0" FontFamily="{StaticResource VayuFontMono}" FontSize="11.5"/>
                </ScrollViewer>
            </Border>

            <!-- Actions -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtCopyStatus" Text="VayuClient will continue running safely." 
                           FontSize="11.5" Foreground="{StaticResource VayuSuccessBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource VayuDarkButton}" Padding="14,6" Margin="0,0,8,0" Click="CopyDetails_Click">
                        <TextBlock Text="Copy Details" FontSize="11.5"/>
                    </Button>
                    <Button Style="{StaticResource VayuAccentButton}" Padding="16,6" Click="Close_Click">
                        <TextBlock Text="Dismiss" FontSize="11.5" FontWeight="Bold" Foreground="White"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
