<Window x:Class="VayuClient.Views.ErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VayuClient — Game Crash Diagnostics"
        FontFamily="{StaticResource VayuFontFamily}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Width="740" Height="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseDown"
        WindowStartupLocation="CenterScreen">

    <Border CornerRadius="8" Background="#090E17" BorderBrush="#DC2626" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="4" Opacity="0.8"/>
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Header -->
                <RowDefinition Height="Auto"/>  <!-- Instance Info / Summary -->
                <RowDefinition Height="*"/>     <!-- Log Box -->
                <RowDefinition Height="Auto"/>  <!-- Actions -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6"
                        Background="#33EF4444" BorderBrush="#EF4444" BorderThickness="1.5"
                        Margin="0,0,12,0">
                    <TextBlock Text="⚠" FontSize="18" FontWeight="Bold" Foreground="#EF4444" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtHeader" Text="Minecraft Crashed Unexpectedly" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock x:Name="TxtSubHeader" Text="Game process terminated with a non-zero exit code. Live crash analysis below:" FontSize="11.5" Foreground="{StaticResource VayuTextDimBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource TitleBarCloseButton}" Click="Close_Click" Width="28" Height="28">
                    <TextBlock Text="✕" FontSize="12" Foreground="{StaticResource VayuTextDimBrush}"/>
                </Button>
            </Grid>

            <!-- Crash Analysis & Diagnostic Card -->
            <Border Grid.Row="1" CornerRadius="6" Background="#111B2B" BorderBrush="#243247" BorderThickness="1"
                    Padding="14,12" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#26DC2626" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                            <TextBlock Text="DIAGNOSTIC SUMMARY" FontSize="9.5" FontWeight="Bold" Foreground="#F87171"/>
                        </Border>
                        <TextBlock Grid.Column="1" x:Name="TxtSummary" Text="Minecraft exited unexpectedly." 
                                   FontWeight="SemiBold" FontSize="12.5" Foreground="#FFFFFF" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </Grid>
                    
                    <TextBlock x:Name="TxtLogLocation" Text="Log location: %APPDATA%\VayuClient\Logs\crash.log" 
                               FontSize="11" Foreground="{StaticResource VayuBrightBlueBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- Monospace Crash Log Details Box -->
            <Border Grid.Row="2" CornerRadius="6" Background="#060A10" BorderBrush="#1E293B" BorderThickness="1"
                    Padding="10" Margin="0,0,0,16">
                <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                              Style="{StaticResource VayuScrollViewer}">
                    <TextBox x:Name="TxtDetails" IsReadOnly="True" TextWrapping="Wrap"
                             Background="Transparent" BorderThickness="0"
                             Foreground="#94A3B8" FontFamily="{StaticResource VayuFontMono}" FontSize="11.5"/>
                </ScrollViewer>
            </Border>

            <!-- Actions Bar -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtCopyStatus" Text="VayuClient recovered safely. Review the logs above to resolve mod/Java issues." 
                           FontSize="11.5" Foreground="{StaticResource VayuTextDimBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource VayuDarkButton}" Padding="12,7" Margin="0,0,8,0" Click="OpenFolder_Click">
                        <TextBlock Text="📂 Open Folder" FontSize="11.5"/>
                    </Button>
                    <Button Style="{StaticResource VayuDarkButton}" Padding="12,7" Margin="0,0,8,0" Click="OpenLog_Click">
                        <TextBlock Text="📄 Open Log" FontSize="11.5"/>
                    </Button>
                    <Button Style="{StaticResource VayuDarkButton}" Padding="12,7" Margin="0,0,8,0" Click="CopyDetails_Click">
                        <TextBlock Text="📋 Copy Log" FontSize="11.5"/>
                    </Button>
                    <Button Style="{StaticResource VayuAccentButton}" Padding="18,7" Click="Close_Click">
                        <TextBlock Text="Close" FontSize="11.5" FontWeight="Bold" Foreground="White"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
