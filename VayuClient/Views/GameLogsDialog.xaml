<Window x:Class="VayuClient.Views.GameLogsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VayuClient — Live Game Output"
        FontFamily="{StaticResource VayuFontFamily}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Width="860" Height="580"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseDown"
        WindowStartupLocation="CenterScreen">

    <Border CornerRadius="10" Background="#080D18" BorderBrush="#1E3A8A" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="6" Opacity="0.85"/>
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Header -->
                <RowDefinition Height="Auto"/>  <!-- Toolbar / Status -->
                <RowDefinition Height="*"/>     <!-- Live Logs Text Box -->
                <RowDefinition Height="Auto"/>  <!-- Footer Action Buttons -->
            </Grid.RowDefinitions>

            <!-- ═══ 1. HEADER ═══ -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                        Background="#152238" BorderBrush="#38BDF8" BorderThickness="1.2"
                        Margin="0,0,12,0">
                    <Path Data="{StaticResource VayuIconTerminal}" Fill="#38BDF8" Width="18" Height="18" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="LIVE GAME OUTPUT" FontSize="15" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        <Border Background="#1E3A8A" CornerRadius="4" Padding="6,1.5" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtInstanceBadge" Text="ACTIVE SESSION" FontSize="9.5" FontWeight="Black" Foreground="#38BDF8"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtStatusSubtitle" Text="Streaming live game console logs &amp; performance metrics..." 
                               FontSize="11.5" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource TitleBarCloseButton}" Click="Close_Click" Width="30" Height="30">
                    <TextBlock Text="✕" FontSize="12" Foreground="#94A3B8"/>
                </Button>
            </Grid>

            <!-- ═══ 2. TOOLBAR & FILTER ═══ -->
            <Border Grid.Row="1" CornerRadius="6" Background="#0C1424" BorderBrush="#1B2942" BorderThickness="1"
                    Padding="10,8" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Filter Box -->
                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <TextBox x:Name="TxtSearchFilter" 
                                 Background="#060A12" Foreground="#FFFFFF" 
                                 BorderBrush="#1E293B" BorderThickness="1"
                                 Padding="8,4" FontSize="11.5"
                                 TextChanged="TxtSearchFilter_TextChanged"/>
                        <TextBlock Text="Filter logs (e.g. error, warning, fps, fabric)..." 
                                   Foreground="#64748B" FontSize="11" 
                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding Text.IsEmpty, ElementName=TxtSearchFilter, Converter={StaticResource BoolToVis}}"/>
                    </Grid>

                    <!-- Auto Scroll Toggle -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="ChkAutoScroll" Content="Auto-Scroll" IsChecked="True" 
                                  Foreground="#CBD5E1" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Click="ClearView_Click" Padding="8,4" Background="#131F33" BorderBrush="#25354F" BorderThickness="1"
                                Foreground="#94A3B8" FontSize="10.5" FontWeight="Bold" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            CLEAR
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ 3. LIVE CONSOLE LOG VIEWER ═══ -->
            <Border Grid.Row="2" CornerRadius="6" Background="#03060C" BorderBrush="#152033" BorderThickness="1">
                <ScrollViewer x:Name="LogScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="8">
                    <TextBox x:Name="TxtLogs" 
                             Background="Transparent" Foreground="#38BDF8" 
                             BorderThickness="0" 
                             FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11.5"
                             IsReadOnly="True" 
                             TextWrapping="NoWrap"
                             AcceptsReturn="True"/>
                </ScrollViewer>
            </Border>

            <!-- ═══ 4. FOOTER ACTIONS ═══ -->
            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="CopyLogs_Click" Style="{StaticResource SecondaryGlassButton}" Height="32" Padding="14,0" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="COPY ALL LOGS" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="OpenFolder_Click" Style="{StaticResource SecondaryGlassButton}" Height="32" Padding="14,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="OPEN LOGS FOLDER" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Button Grid.Column="2" Click="Close_Click" Style="{StaticResource PrimaryActionBtn}" Height="32" Padding="18,0">
                    <TextBlock Text="CLOSE MENU" FontSize="11" FontWeight="Black" VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
