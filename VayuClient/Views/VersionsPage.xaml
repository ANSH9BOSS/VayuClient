<UserControl x:Class="VayuClient.Views.VersionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:VayuClient.Converters"
             Background="#06070B">

    <Grid>
        <!-- ═══ AMBIENT CHERRY GROVE 3D BACKGROUND ═══ -->
        <Image Source="/Assets/Images/bg_cherry_grove.jpg" 
               Stretch="UniformToFill" 
               HorizontalAlignment="Center" 
               VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality"
               Opacity="0.22"/>

        <!-- Deep Obsidian Atmospheric Gradient Overlay -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#D806070B" Offset="0.0"/>
                    <GradientStop Color="#EB06070B" Offset="0.55"/>
                    <GradientStop Color="#FA06070B" Offset="1.0"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ═══ MAIN VERSIONS BROWSER ═══ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource VayuScrollViewer}">
            <StackPanel Margin="28,20,28,32">
                <!-- Header with official branding -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#161028" BorderBrush="#3B2A60" BorderThickness="1.2" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect Color="#7C3AED" BlurRadius="10" ShadowDepth="1" Opacity="0.4"/>
                                </Border.Effect>
                                <Path Data="{StaticResource VayuIconVersions}" Fill="#C084FC" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Minecraft Versions" FontSize="20" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Official Mojang Java Edition Manifest — Explore releases, snapshots &amp; legacy versions"
                                   FontSize="12" Foreground="{StaticResource VayuTextMutedBrush}"/>
                    </StackPanel>

                    <!-- Sort Order Toggle Button -->
                    <Button Grid.Column="1" Style="{StaticResource Vayu3DButton}" Padding="15,8" VerticalAlignment="Center"
                            Command="{Binding ToggleSortOrderCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Sort: " FontSize="12" Foreground="{StaticResource VayuTextMutedBrush}"/>
                            <TextBlock Text="{Binding SortOrder}" FontSize="12" FontWeight="Black" Foreground="#C084FC"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Filter & Search Toolbar -->
                <Border CornerRadius="10" Background="{StaticResource VayuCardGradient}" BorderBrush="{StaticResource Vayu3DBorderBrush}" BorderThickness="1.2" Padding="14,10" Margin="0,0,0,18">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.35"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Filter Chips -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="FILTER" FontSize="10.5" FontWeight="Black" Foreground="#7D7596" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button Style="{StaticResource Vayu3DButton}" Padding="12,5" Margin="0,0,6,0" Command="{Binding SetFilterCommand}" CommandParameter="All">
                                <TextBlock Text="ALL" FontSize="11" FontWeight="Bold"/>
                            </Button>
                            <Button Style="{StaticResource Vayu3DButton}" Padding="12,5" Margin="0,0,6,0" Command="{Binding SetFilterCommand}" CommandParameter="release">
                                <TextBlock Text="RELEASES" FontSize="11" FontWeight="Bold" Foreground="#C084FC"/>
                            </Button>
                            <Button Style="{StaticResource Vayu3DButton}" Padding="12,5" Margin="0,0,6,0" Command="{Binding SetFilterCommand}" CommandParameter="snapshot">
                                <TextBlock Text="SNAPSHOTS" FontSize="11" FontWeight="Bold" Foreground="#F59E0B"/>
                            </Button>
                            <Button Style="{StaticResource Vayu3DButton}" Padding="12,5" Margin="0,0,6,0" Command="{Binding SetFilterCommand}" CommandParameter="old_beta">
                                <TextBlock Text="OLD BETA" FontSize="11" FontWeight="Bold" Foreground="#A855F7"/>
                            </Button>
                            <Button Style="{StaticResource Vayu3DButton}" Padding="12,5" Command="{Binding SetFilterCommand}" CommandParameter="old_alpha">
                                <TextBlock Text="OLD ALPHA" FontSize="11" FontWeight="Bold" Foreground="#7D7596"/>
                            </Button>
                        </StackPanel>

                        <!-- Search Input -->
                        <TextBox Grid.Column="1" Style="{StaticResource VayuGlassTextBox}" Margin="16,0,0,0"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Height="34"/>
                    </Grid>
                </Border>

                <!-- Error Fallback State -->
                <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                        CornerRadius="10" Background="#1C0E18" BorderBrush="#4C1D28" BorderThickness="1.2" Padding="28" Margin="0,16">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Unable to load Minecraft version manifest." FontSize="14" FontWeight="Black" Foreground="#EF4444" HorizontalAlignment="Center"/>
                        <TextBlock Text="The Mojang version service could not be reached or an error occurred." FontSize="12" Foreground="{StaticResource VayuTextMutedBrush}" Margin="0,4,0,16" HorizontalAlignment="Center"/>
                        <Button Style="{StaticResource Vayu3DPrimaryButton}" Padding="20,8" Command="{Binding LoadVersionsAsyncCommand}">
                            <TextBlock Text="RETRY" FontSize="12" FontWeight="Black" Foreground="White"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Versions Cards List -->
                <ItemsControl ItemsSource="{Binding DisplayVersions}"
                              Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Background="{StaticResource VayuCardGradient}" BorderBrush="{StaticResource Vayu3DBorderBrush}" BorderThickness="1.2"
                                    Padding="16,12" Margin="0,0,0,8">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.35"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Version Icon -->
                                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="8"
                                            Background="#161028" BorderBrush="#3B2A60" BorderThickness="1" Margin="0,0,14,0">
                                        <Path Data="{StaticResource VayuIconVersions}" Fill="#C084FC" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Details -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Id}" FontSize="13.5" FontWeight="Black" Foreground="#FFFFFF" Margin="0,0,10,0"/>
                                            <Border CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Background="#16102A" BorderBrush="#3B2A60" BorderThickness="0.8">
                                                <TextBlock Text="{Binding TypeDisplay}" FontSize="9.5" FontWeight="Black" Foreground="#C084FC"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ReleaseDateDisplay}" FontSize="11" Foreground="{StaticResource VayuTextMutedBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Actions: Create Instance Wizard -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource Vayu3DPrimaryButton}" Padding="16,6"
                                                Command="{Binding DataContext.StartCreateInstanceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Id}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource VayuIconPlus}" Fill="#FFFFFF" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Create Instance" FontSize="11.5" FontWeight="Black" Foreground="White"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- ═══ 5-STEP INSTANCE CREATION WIZARD 3D MODAL ══════════════════ -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Visibility="{Binding IsWizardOpen, Converter={StaticResource BoolToVis}}"
              Background="#E606070B">
            <Border Width="680" CornerRadius="12" 
                    Background="{StaticResource VayuCardGradient}" BorderBrush="{StaticResource Vayu3DBorderBrush}" BorderThickness="1.5"
                    Padding="28,24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.CacheMode>
                    <BitmapCache/>
                </Border.CacheMode>
                <Border.Effect>
                    <DropShadowEffect Color="#7C3AED" BlurRadius="24" ShadowDepth="4" Opacity="0.45" RenderingBias="Performance"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Create Minecraft Instance" FontSize="18" FontWeight="Black" Foreground="#FFFFFF"/>
                                <Border Background="#1E1438" BorderBrush="#7C3AED" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StepNumberDisplay}" FontSize="10.5" FontWeight="Black" Foreground="#C084FC"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Configure version, mod loader, RAM allocation, and instance details" FontSize="11.5" Foreground="{StaticResource VayuTextMutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1" Command="{Binding CloseWizardCommand}"
                                Content="✕" FontSize="14" Foreground="{StaticResource VayuTextMutedBrush}"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6"/>
                    </Grid>

                    <!-- Horizontal 5-Step Progress Indicator -->
                    <Border Background="#0C101D" BorderBrush="#251C3D" BorderThickness="1.2" CornerRadius="8" Padding="12,8" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Command="{Binding GoToStepCommand}" CommandParameter="1" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <TextBlock Text="1. VERSION" FontSize="10" FontWeight="Bold" 
                                           Foreground="{Binding IsStep1, Converter={StaticResource BoolToAccentBrushConverter}}" HorizontalAlignment="Center"/>
                            </Button>
                            <TextBlock Grid.Column="1" Text="─" Foreground="#251C3D" HorizontalAlignment="Center"/>
                            <Button Grid.Column="2" Command="{Binding GoToStepCommand}" CommandParameter="2" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <TextBlock Text="2. LOADER" FontSize="10" FontWeight="Bold" 
                                           Foreground="{Binding IsStep2, Converter={StaticResource BoolToAccentBrushConverter}}" HorizontalAlignment="Center"/>
                            </Button>
                            <TextBlock Grid.Column="3" Text="─" Foreground="#251C3D" HorizontalAlignment="Center"/>
                            <Button Grid.Column="4" Command="{Binding GoToStepCommand}" CommandParameter="3" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <TextBlock Text="3. RAM" FontSize="10" FontWeight="Bold" 
                                           Foreground="{Binding IsStep3, Converter={StaticResource BoolToAccentBrushConverter}}" HorizontalAlignment="Center"/>
                            </Button>
                            <TextBlock Grid.Column="5" Text="─" Foreground="#251C3D" HorizontalAlignment="Center"/>
                            <Button Grid.Column="6" Command="{Binding GoToStepCommand}" CommandParameter="4" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <TextBlock Text="4. MODPACK" FontSize="10" FontWeight="Bold" 
                                           Foreground="{Binding IsStep4, Converter={StaticResource BoolToAccentBrushConverter}}" HorizontalAlignment="Center"/>
                            </Button>
                            <TextBlock Grid.Column="7" Text="─" Foreground="#251C3D" HorizontalAlignment="Center"/>
                            <Button Grid.Column="8" Command="{Binding GoToStepCommand}" CommandParameter="5" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <TextBlock Text="5. SUMMARY" FontSize="10" FontWeight="Bold" 
                                           Foreground="{Binding IsStep5, Converter={StaticResource BoolToAccentBrushConverter}}" HorizontalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- STEP 1: VERSION & NAME -->
                    <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16">
                        <TextBlock Text="SELECTED MINECRAFT VERSION" FontSize="11" FontWeight="Black" Foreground="#C084FC" Margin="0,0,0,6"/>
                        <Border Background="#0C101D" BorderBrush="#251C3D" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Minecraft Version:" FontSize="12.5" Foreground="{StaticResource VayuTextMutedBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding SelectedMinecraftVersion}" FontSize="13" FontWeight="Bold" Foreground="#C084FC"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="INSTANCE NAME" FontSize="11" FontWeight="Black" Foreground="#C084FC" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding InstanceName, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource VayuGlassTextBox}" Height="38" Margin="0,0,0,14"/>

                        <TextBlock Text="CHOOSE INSTANCE ICON" FontSize="11" FontWeight="Black" Foreground="#C084FC" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding AvailableIcons}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectIconCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource Vayu3DButton}"
                                            Width="42" Height="42" Margin="0,0,8,8" Cursor="Hand" Padding="0">
                                        <TextBlock Text="{Binding}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- STEP 2: MOD LOADER -->
                    <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16">
                        <TextBlock Text="SELECT MOD LOADER" FontSize="11" FontWeight="Black" Foreground="#C084FC" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding AvailableLoaders}" 
                                  SelectedItem="{Binding SelectedLoader}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource VayuComboBox}" Height="38" Margin="0,0,0,14"/>

                        <TextBlock Text="LOADER VERSION" FontSize="11" FontWeight="Black" Foreground="#C084FC" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding AvailableLoaderVersions}" 
                                  SelectedItem="{Binding SelectedLoaderVersion}"
                                  Style="{StaticResource VayuComboBox}" Height="38" Margin="0,0,0,14"/>

                        <Border Background="#0C101D" BorderBrush="#251C3D" BorderThickness="1" CornerRadius="6" Padding="14,10">
                            <TextBlock Text="Fabric and NeoForge are recommended for high performance and modern mods." 
                                       FontSize="11.5" Foreground="{StaticResource VayuTextMutedBrush}"/>
                        </Border>
                    </StackPanel>

                    <!-- STEP 3: RAM ALLOCATION -->
                    <StackPanel Visibility="{Binding IsStep3, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="MEMORY (RAM) ALLOCATION" FontSize="11" FontWeight="Black" Foreground="#C084FC"/>
                            <TextBlock Text="{Binding SelectedRamDisplay}" FontSize="13" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                        </Grid>

                        <Slider Value="{Binding SelectedRamMB}" Minimum="1024" Maximum="{Binding SystemRamMB}" SmallChange="512" LargeChange="1024"
                                Style="{StaticResource VayuGlassSlider}" Margin="0,0,0,14"/>

                        <TextBlock Text="QUICK ALLOCATION PRESETS" FontSize="11" FontWeight="Black" Foreground="#C084FC" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Button Content="2 GB" Command="{Binding SetRamPresetCommand}" CommandParameter="2048" Style="{StaticResource Vayu3DButton}" Padding="14,6" Margin="0,0,8,0"/>
                            <Button Content="4 GB (Default)" Command="{Binding SetRamPresetCommand}" CommandParameter="4096" Style="{StaticResource Vayu3DButton}" Padding="14,6" Margin="0,0,8,0"/>
                            <Button Content="6 GB (Modded)" Command="{Binding SetRamPresetCommand}" CommandParameter="6144" Style="{StaticResource Vayu3DButton}" Padding="14,6" Margin="0,0,8,0"/>
                            <Button Content="8 GB" Command="{Binding SetRamPresetCommand}" CommandParameter="8192" Style="{StaticResource Vayu3DButton}" Padding="14,6" Margin="0,0,8,0"/>
                            <Button Content="12 GB" Command="{Binding SetRamPresetCommand}" CommandParameter="12288" Style="{StaticResource Vayu3DButton}" Padding="14,6"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- STEP 4: MODPACK SELECTION -->
                    <StackPanel Visibility="{Binding IsStep4, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16">
                        <TextBlock Text="OPTIONAL MODPACK (MODRINTH)" FontSize="11" FontWeight="Black" Foreground="#C084FC" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding ModpackSearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource VayuGlassTextBox}" Height="36"/>
                            <Button Grid.Column="1" Command="{Binding SearchModpacksCommand}" Content="Search" 
                                    Style="{StaticResource Vayu3DPrimaryButton}" Padding="16,6" Margin="8,0,0,0"/>
                        </Grid>

                        <ListBox ItemsSource="{Binding ModrinthModpacks}" SelectedItem="{Binding SelectedModpack}"
                                 MaxHeight="140" Background="#0C101D" BorderBrush="#251C3D" BorderThickness="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,2">
                                        <TextBlock Text="{Binding Title}" FontSize="12" Foreground="#FFFFFF"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <!-- STEP 5: SUMMARY & CONFIRMATION -->
                    <StackPanel Visibility="{Binding IsStep5, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16">
                        <TextBlock Text="INSTANCE OVERVIEW &amp; CONFIRMATION" FontSize="11" FontWeight="Black" Foreground="#C084FC" Margin="0,0,0,10"/>
                        <Border Background="#0C101D" BorderBrush="#251C3D" BorderThickness="1" CornerRadius="8" Padding="16,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Name:" Foreground="{StaticResource VayuTextMutedBrush}"/>
                                    <TextBlock Text="{Binding InstanceName}" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Minecraft Version:" Foreground="{StaticResource VayuTextMutedBrush}"/>
                                    <TextBlock Text="{Binding SelectedMinecraftVersion}" FontWeight="Black" Foreground="#C084FC" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Mod Loader:" Foreground="{StaticResource VayuTextMutedBrush}"/>
                                    <TextBlock Text="{Binding SelectedLoader.Name}" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Allocated RAM:" Foreground="{StaticResource VayuTextMutedBrush}"/>
                                    <TextBlock Text="{Binding SelectedRamDisplay}" FontWeight="Black" Foreground="#4ADE80" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Location:" Foreground="{StaticResource VayuTextMutedBrush}"/>
                                    <TextBlock Text="%APPDATA%\VayuClient\Instances" Foreground="{StaticResource VayuTextMutedBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <Grid Margin="0,10,0,0">
                        <Button Content="Cancel" Command="{Binding CloseWizardCommand}"
                                Style="{StaticResource Vayu3DButton}" Padding="16,8" HorizontalAlignment="Left"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="← Back" Command="{Binding PreviousStepCommand}"
                                    Visibility="{Binding IsPreviousVisible, Converter={StaticResource BoolToVis}}"
                                    Style="{StaticResource Vayu3DButton}" Padding="16,8" Margin="0,0,10,0"/>
                            <Button Content="{Binding NextButtonText}" Command="{Binding NextStepCommand}"
                                    Style="{StaticResource Vayu3DPrimaryButton}" Padding="20,8"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
