<UserControl x:Class="VayuClient.Views.ServerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="780" d:DesignWidth="1080"
             Background="#070B14">

    <Grid>
        <!-- Background -->
        <Image Source="/Assets/Images/bg_ocean_monument.jpg"
               Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality" Opacity="0.22"/>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#D0070B14" Offset="0.0"/>
                    <GradientStop Color="#F5070B14" Offset="1.0"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Margin="28,20,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Page header -->
                <RowDefinition Height="Auto"/>  <!-- VayuClient Network panel -->
                <RowDefinition Height="Auto"/>  <!-- Add-server form (collapsible) -->
                <RowDefinition Height="*"/>     <!-- Minecraft server list -->
                <RowDefinition Height="Auto"/>  <!-- Status bar -->
            </Grid.RowDefinitions>

            <!-- ═══ HEADER ═══ -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource VayuIconServer}" Fill="{StaticResource VayuBrightBlueBrush}"
                              Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="PARTNERED SERVERS" FontSize="20" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Live status for official and partnered community Minecraft servers supported by VayuClient."
                               FontSize="12" Foreground="{StaticResource VayuTextMutedBrush}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="↻ Refresh All"
                            Command="{Binding RefreshAllCommand}"
                            IsEnabled="{Binding IsPingingAll, Converter={StaticResource InverseBoolConverter}}"
                            Style="{StaticResource VayuDarkButton}" Padding="14,8" Margin="0,0,10,0"
                            FontSize="12" Cursor="Hand"/>
                    <Button Content="＋ Add Server"
                            Command="{Binding BeginAddServerCommand}"
                            Style="{StaticResource VayuPrimaryButton}" Padding="14,8"
                            FontSize="12" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- ═══ VAYUCLIENT NETWORK DASHBOARD (real-time presence) ═══ -->
            <Border Grid.Row="1" Margin="0,0,0,14" CornerRadius="10"
                    BorderThickness="1" Padding="0">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#2563EB" Offset="0.0"/>
                        <GradientStop Color="#7C3AED" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0F1629" Offset="0.0"/>
                        <GradientStop Color="#0D1220" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: Header + player count + player list -->
                    <StackPanel Grid.Column="0" Margin="18,14,14,14">

                        <!-- Title + connection indicator -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <!-- Pulsing status dot -->
                            <Grid VerticalAlignment="Center" Margin="0,0,8,0">
                                <Ellipse Width="8" Height="8">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#4ADE80"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPresenceAvailable}" Value="False">
                                                    <Setter Property="Fill" Value="#EF4444"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Grid>
                            <TextBlock Text="VAYUCLIENT NETWORK" FontSize="11" FontWeight="Bold"
                                       Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            <TextBlock Text=" · " Foreground="#334155" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding VayuNetworkStatus}" FontSize="10"
                                       Foreground="{StaticResource VayuTextMutedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Player count headline -->
                        <TextBlock FontSize="28" FontWeight="Black" Margin="0,0,0,10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="{Binding VayuPresenceSummary}">
                                <Run.Style>
                                    <Style TargetType="Run">
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPresenceAvailable}" Value="False">
                                                <Setter Property="Foreground" Value="#64748B"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Run.Style>
                            </Run>
                        </TextBlock>

                        <!-- ─── Online players list ─── -->

                        <!-- Empty state (connected but 0 players) -->
                        <TextBlock Text="No players connected yet."
                                   FontSize="11" Foreground="#475569"
                                   Margin="0,0,0,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsPresenceAvailable}" Value="True"/>
                                                <Condition Binding="{Binding VayuOnlineCount}" Value="0"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Unavailable state -->
                        <TextBlock Text="⚡ Backend unreachable — presence data unavailable"
                                   FontSize="11" Foreground="#EF4444" Margin="0,0,0,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPresenceAvailable}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Real player list from backend (max 8 rows visible; rest scroll) -->
                        <ItemsControl ItemsSource="{Binding VayuOnlinePlayers}"
                                      Visibility="{Binding IsPresenceAvailable, Converter={StaticResource BoolToVis}}"
                                      MaxHeight="148">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  Focusable="False">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                        <!-- Status dot -->
                                        <Ellipse Width="7" Height="7" Fill="#4ADE80"
                                                 VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <!-- Username -->
                                        <TextBlock Text="{Binding Username}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                        <!-- Account type badge -->
                                        <Border CornerRadius="3" Padding="4,1" Margin="6,0,0,0"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1E293B"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMicrosoft}" Value="True">
                                                            <Setter Property="Background" Value="#1D4ED8"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="9" FontWeight="Bold" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text"       Value="OFFLINE"/>
                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMicrosoft}" Value="True">
                                                                <Setter Property="Text"       Value="MSA"/>
                                                                <Setter Property="Foreground" Value="#93C5FD"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Updated timestamp -->
                        <TextBlock Margin="0,8,0,0" FontSize="10" Foreground="#334155">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Updated in real time"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PresenceLastUpdated}" Value="">
                                            <Setter Property="Text" Value="Updated in real time"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="Last updated: "/>
                            <Run Text="{Binding PresenceLastUpdated, FallbackValue='—'}"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- RIGHT: decorative accent column with icon -->
                    <Border Grid.Column="1" Width="6" CornerRadius="0,10,10,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#2563EB" Offset="0.0"/>
                                <GradientStop Color="#7C3AED" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ ADD SERVER PANEL (inline, collapsible) ═══ -->
            <Border Grid.Row="2"
                    Visibility="{Binding IsAddingServer, Converter={StaticResource BoolToVis}}"
                    CornerRadius="8" Background="#181E2E"
                    BorderBrush="#2563EB" BorderThickness="1"
                    Padding="18,14" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.ColumnSpan="4" Text="ADD NEW SERVER" FontSize="10.5" FontWeight="Bold"
                               Foreground="{StaticResource VayuBrightBlueBrush}" Margin="0,0,0,10"/>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Display Name" FontSize="10.5" Foreground="{StaticResource VayuTextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewServerName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource VayuTextBox}" Height="34"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Address (e.g. mc.hypixel.net)" FontSize="10.5" Foreground="{StaticResource VayuTextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewServerAddress, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource VayuTextBox}" Height="34"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="Port" FontSize="10.5" Foreground="{StaticResource VayuTextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewServerPort, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource VayuTextBox}" Height="34"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Content="Add"    Command="{Binding ConfirmAddServerCommand}"
                                Style="{StaticResource VayuPrimaryButton}" Padding="16,8" Margin="0,0,8,0"
                                FontSize="12" Cursor="Hand"/>
                        <Button Content="Cancel" Command="{Binding CancelAddServerCommand}"
                                Style="{StaticResource VayuDarkButton}" Padding="12,8"
                                FontSize="12" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ MINECRAFT SERVER LIST ═══ -->
            <Border Grid.Row="3" CornerRadius="8" Background="{StaticResource VayuSurfaceBrush}"
                    BorderBrush="{StaticResource VayuBorderBrush}" BorderThickness="1">
                <Grid>
                    <!-- Empty state -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding Servers.Count, Converter={StaticResource ZeroToVis}}">
                        <Path Data="{StaticResource VayuIconServer}" Fill="{StaticResource VayuTextMutedBrush}"
                              Width="44" Height="44" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                        <TextBlock Text="No servers saved yet" FontSize="16" FontWeight="Bold"
                                   Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                        <TextBlock Text="Click '＋ Add Server' to add a Minecraft Java Edition server."
                                   FontSize="12" Foreground="{StaticResource VayuTextMutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,6,0,16"/>
                        <Button Content="＋ Add Server" Command="{Binding BeginAddServerCommand}"
                                Style="{StaticResource VayuPrimaryButton}" Padding="16,10"
                                HorizontalAlignment="Center" FontSize="13" Cursor="Hand"/>
                    </StackPanel>

                    <!-- Server list with UI Virtualization -->
                    <ListView ItemsSource="{Binding Servers}"
                              SelectedItem="{Binding SelectedServer}"
                              Style="{StaticResource VayuListView}"
                              Visibility="{Binding Servers.Count, Converter={StaticResource NonZeroToVis}}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6" Padding="12,10" Margin="0,0,0,1" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Status Dot -->
                                        <Grid Grid.Column="0" VerticalAlignment="Center">
                                            <Ellipse Width="12" Height="12" Fill="#4ADE80"
                                                     Visibility="{Binding IsOnline, Converter={StaticResource BoolToVis}}"/>
                                            <Ellipse Width="12" Height="12" Fill="#F59E0B"
                                                     Visibility="{Binding IsPinging, Converter={StaticResource BoolToVis}}"/>
                                            <Ellipse Width="12" Height="12" Fill="#EF4444">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsOnline}"  Value="False"/>
                                                                    <Condition Binding="{Binding IsPinging}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </Grid>

                                        <!-- Server Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                <TextBlock Text="★" FontSize="11" Foreground="#F59E0B" Margin="6,0,0,0" VerticalAlignment="Center"
                                                           Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding AddressDisplay}" FontSize="10.5" Foreground="{StaticResource VayuTextMutedBrush}"/>
                                            <TextBlock Text="{Binding Motd}" FontSize="10.5" Foreground="#94A3B8"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding IsOnline, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>

                                        <!-- Players + Version -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding StatusDisplay}" FontSize="11"
                                                       Foreground="{Binding IsOnline, Converter={StaticResource BoolToOnlineStatusBrush}}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ServerVersion}" FontSize="10"
                                                       Foreground="{StaticResource VayuTextMutedBrush}"/>
                                        </StackPanel>

                                        <!-- Ping -->
                                        <TextBlock Grid.Column="3" Text="{Binding PingDisplay}"
                                                   FontSize="12" FontWeight="Bold" VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{Binding PingMs, Converter={StaticResource PingToColorBrush}}"/>

                                        <!-- Action Buttons -->
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="⟳"
                                                    Command="{Binding DataContext.PingServerCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Ping Server" Style="{StaticResource VayuIconButton}"
                                                    Padding="8,4" Margin="2,0" Cursor="Hand"/>
                                            <Button Content="{Binding IsFavorite, Converter={StaticResource BoolToString}, ConverterParameter='★|☆'}"
                                                    Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Toggle Favourite" Style="{StaticResource VayuIconButton}"
                                                    Padding="8,4" Margin="2,0" Cursor="Hand"/>
                                            <Button Content="⎘"
                                                    Command="{Binding DataContext.CopyAddressCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Copy Address" Style="{StaticResource VayuIconButton}"
                                                    Padding="8,4" Margin="2,0" Cursor="Hand"/>
                                            <Button Content="🗑"
                                                    Command="{Binding DataContext.DeleteServerCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Remove Server" Style="{StaticResource VayuIconButton}"
                                                    Padding="8,4" Margin="2,0" Cursor="Hand"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- ═══ STATUS BAR ═══ -->
            <Border Grid.Row="4" Margin="0,10,0,0" Padding="4,2">
                <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                           Foreground="{StaticResource VayuTextMutedBrush}"
                           TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
