<UserControl x:Class="VayuClient.Views.ServerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="780" d:DesignWidth="1080"
             Background="#070B14">

    <Grid>
        <!-- Background -->
        <Image Source="/Assets/Images/bg_ocean_monument.jpg"
               Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality" Opacity="0.25"/>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#CC070B14" Offset="0.0"/>
                    <GradientStop Color="#F0070B14" Offset="1.0"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Margin="28,20,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══ HEADER ═══ -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="🖥️  SERVER MANAGER" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Real-time Server List Ping (SLP) — add, monitor, and quick-connect to Java Edition servers."
                               FontSize="12" Foreground="{StaticResource VayuTextMutedBrush}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="↻ Refresh All"
                            Command="{Binding RefreshAllCommand}"
                            IsEnabled="{Binding IsPingingAll, Converter={StaticResource InverseBoolConverter}}"
                            Style="{StaticResource VayuDarkButton}" Padding="14,8" Margin="0,0,10,0"
                            FontSize="12" Cursor="Hand"/>
                    <Button Content="＋ Add Server"
                            Command="{Binding BeginAddServerCommand}"
                            Style="{StaticResource VayuPrimaryButton}" Padding="14,8"
                            FontSize="12" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- ═══ ADD SERVER PANEL (inline, collapsible) ═══ -->
            <Border Grid.Row="1"
                    Visibility="{Binding IsAddingServer, Converter={StaticResource BoolToVis}}"
                    CornerRadius="8" Background="#181E2E"
                    BorderBrush="#2563EB" BorderThickness="1"
                    Padding="18,14" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.ColumnSpan="4" Text="ADD NEW SERVER" FontSize="10.5" FontWeight="Bold"
                               Foreground="{StaticResource VayuBrightBlueBrush}" Margin="0,0,0,10"/>

                    <!-- Name -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Display Name" FontSize="10.5" Foreground="{StaticResource VayuTextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewServerName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource VayuTextBox}" Height="34"/>
                    </StackPanel>

                    <!-- Address -->
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Address" FontSize="10.5" Foreground="{StaticResource VayuTextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewServerAddress, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource VayuTextBox}" Height="34"/>
                    </StackPanel>

                    <!-- Port -->
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="Port" FontSize="10.5" Foreground="{StaticResource VayuTextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewServerPort, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource VayuTextBox}" Height="34"/>
                    </StackPanel>

                    <!-- Buttons -->
                    <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Content="Add" Command="{Binding ConfirmAddServerCommand}"
                                Style="{StaticResource VayuPrimaryButton}" Padding="16,8" Margin="0,0,8,0"
                                FontSize="12" Cursor="Hand"/>
                        <Button Content="Cancel" Command="{Binding CancelAddServerCommand}"
                                Style="{StaticResource VayuDarkButton}" Padding="12,8"
                                FontSize="12" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ SERVER LIST ═══ -->
            <Border Grid.Row="2" CornerRadius="8" Background="{StaticResource VayuSurfaceBrush}"
                    BorderBrush="{StaticResource VayuBorderBrush}" BorderThickness="1">
                <Grid>
                    <!-- Empty state -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding Servers.Count, Converter={StaticResource ZeroToVis}}">
                        <TextBlock Text="🖧" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="No servers yet" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                        <TextBlock Text="Click '＋ Add Server' to add a Minecraft Java Edition server." FontSize="12"
                                   Foreground="{StaticResource VayuTextMutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,16"/>
                        <Button Content="＋ Add Server" Command="{Binding BeginAddServerCommand}"
                                Style="{StaticResource VayuPrimaryButton}" Padding="16,10" HorizontalAlignment="Center"
                                FontSize="13" Cursor="Hand"/>
                    </StackPanel>

                    <!-- Server list -->
                    <ListView ItemsSource="{Binding Servers}"
                              SelectedItem="{Binding SelectedServer}"
                              Style="{StaticResource VayuListView}"
                              Visibility="{Binding Servers.Count, Converter={StaticResource NonZeroToVis}}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6" Padding="12,10" Margin="0,0,0,1"
                                        Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Status Dot -->
                                        <Grid Grid.Column="0" VerticalAlignment="Center">
                                            <!-- Online dot -->
                                            <Ellipse Width="12" Height="12" Fill="#4ADE80"
                                                     Visibility="{Binding IsOnline, Converter={StaticResource BoolToVis}}"/>
                                            <!-- Pinging spinner (just a colored dot for simplicity) -->
                                            <Ellipse Width="12" Height="12" Fill="#F59E0B"
                                                     Visibility="{Binding IsPinging, Converter={StaticResource BoolToVis}}"/>
                                            <!-- Offline dot -->
                                            <Ellipse Width="12" Height="12" Fill="#EF4444"
                                                     Visibility="{Binding IsOnline, Converter={StaticResource InverseBoolToVis}}">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPinging}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </Grid>

                                        <!-- Server Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                <TextBlock Text="⭐" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                                                           Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding AddressDisplay}" FontSize="10.5" Foreground="{StaticResource VayuTextMutedBrush}"/>
                                            <TextBlock Text="{Binding Motd}" FontSize="10.5" Foreground="#94A3B8"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding IsOnline, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>

                                        <!-- Players + Version -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding StatusDisplay}" FontSize="11"
                                                       Foreground="{Binding IsOnline, Converter={StaticResource BoolToOnlineStatusBrush}}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ServerVersion}" FontSize="10" Foreground="{StaticResource VayuTextMutedBrush}"/>
                                        </StackPanel>

                                        <!-- Ping -->
                                        <TextBlock Grid.Column="3" Text="{Binding PingDisplay}"
                                                   FontSize="12" FontWeight="Bold" VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{Binding PingMs, Converter={StaticResource PingToColorBrush}}"/>

                                        <!-- Action Buttons -->
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="⟳"
                                                    Command="{Binding DataContext.PingServerCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Ping" Style="{StaticResource VayuIconButton}"
                                                    Padding="8,4" Margin="2,0" Cursor="Hand"/>
                                            <Button Content="{Binding IsFavorite, Converter={StaticResource BoolToString}, ConverterParameter='★|☆'}"
                                                    Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Toggle Favourite" Style="{StaticResource VayuIconButton}"
                                                    Padding="8,4" Margin="2,0" Cursor="Hand"/>
                                            <Button Content="⎘"
                                                    Command="{Binding DataContext.CopyAddressCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Copy Address" Style="{StaticResource VayuIconButton}"
                                                    Padding="8,4" Margin="2,0" Cursor="Hand"/>
                                            <Button Content="🗑"
                                                    Command="{Binding DataContext.DeleteServerCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Remove" Style="{StaticResource VayuIconButton}"
                                                    Padding="8,4" Margin="2,0" Cursor="Hand"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- ═══ STATUS BAR ═══ -->
            <Border Grid.Row="3" Margin="0,10,0,0" Padding="4,2">
                <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                           Foreground="{StaticResource VayuTextMutedBrush}"
                           TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
