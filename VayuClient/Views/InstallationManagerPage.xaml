<UserControl x:Class="VayuClient.Views.InstallationManagerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1200"
             Background="#06070B"
             FontFamily="{StaticResource VayuFontFamily}">

    <UserControl.Resources>
        <!-- 3D Pod Cyber Glow Effect -->
        <DropShadowEffect x:Key="ActivePodGlow" Color="#A855F7" BlurRadius="28" ShadowDepth="0" Opacity="0.35"/>
        <DropShadowEffect x:Key="InactivePodGlow" Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.6"/>
        <DropShadowEffect x:Key="PurpleNeonGlow" Color="#C084FC" BlurRadius="12" ShadowDepth="0" Opacity="0.8"/>
        <DropShadowEffect x:Key="PlayButtonGlow" Color="#7C3AED" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>

        <!-- Inactive Card Scale & Perspective Transform -->
        <ScaleTransform x:Key="InactiveCardScale" ScaleX="0.84" ScaleY="0.84"/>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <!-- ═══ AMBIENT RESTORATIVE 3D OBSIDIAN ENVIRONMENT ═══ -->
        <!-- Deep obsidian background with very subtle radial purple vignettes -->
        <Rectangle Fill="#06070B"/>

        <!-- Top Right Ambient Purple Glow -->
        <Ellipse Width="700" Height="500" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-120,-160,0" IsHitTestVisible="False" Opacity="0.06">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#A855F7" Offset="0.0"/>
                    <GradientStop Color="#7C3AED" Offset="0.4"/>
                    <GradientStop Color="Transparent" Offset="1.0"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Center Stage Subtle Atmosphere Glow -->
        <Ellipse Width="850" Height="600" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Margin="0,40,0,0" IsHitTestVisible="False" Opacity="0.045">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#9333EA" Offset="0.0"/>
                    <GradientStop Color="#581C87" Offset="0.5"/>
                    <GradientStop Color="Transparent" Offset="1.0"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Main Content Area -->
        <Grid Margin="32,20,32,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Top Header + Action Buttons -->
                <RowDefinition Height="Auto"/> <!-- Sub-Navigation Tabs Row -->
                <RowDefinition Height="Auto"/> <!-- Search & Filter & Sort Toolbar -->
                <RowDefinition Height="*"/>    <!-- 3D Installation Manager Stage / Modrinth View -->
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- 1. TOP HEADER & PRIMARY ACTION BUTTONS                          -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title Hierarchy -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <!-- Kicker -->
                    <TextBlock Text="INSTALLATION MANAGER" FontSize="11" FontWeight="Bold" Foreground="#8B8FA3" Margin="0,0,0,3">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.5"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <!-- Main Title -->
                    <TextBlock Text="GAME LIBRARY" FontSize="28" FontWeight="Black" Foreground="#FFFFFF" Margin="0,0,0,3">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="2" Opacity="0.5"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <!-- Subtitle -->
                    <TextBlock Text="Manage your Minecraft installations. Play. Customize. Dominate." FontSize="12.5" Foreground="#64748B"/>
                </StackPanel>

                <!-- Right: Top 3D Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- + NEW INSTALLATION Button (Glowing Purple Gradient Pill) -->
                    <Button Command="{Binding NewInstallationCommand}"
                            Cursor="Hand" Margin="0,0,10,0" ToolTip="Create a new isolated Minecraft instance">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BtnBorder" CornerRadius="8" Padding="16,9" BorderThickness="1.2">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#8B5CF6" Offset="0.0"/>
                                            <GradientStop Color="#6D28D9" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.BorderBrush>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#C084FC" Offset="0.0"/>
                                            <GradientStop Color="#7C3AED" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.BorderBrush>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#7C3AED" BlurRadius="16" ShadowDepth="0" Opacity="0.6"/>
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource VayuIconPlus}" Fill="#FFFFFF" Width="11" Height="11" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="NEW INSTALLATION" FontSize="11.5" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#A855F7" BlurRadius="22" ShadowDepth="0" Opacity="0.85"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="BtnBorder" Property="RenderTransform">
                                            <Setter.Value>
                                                <TranslateTransform Y="1"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- ↑ IMPORT Button -->
                    <Button Command="{Binding ImportModpackCommand}"
                            Cursor="Hand" Margin="0,0,8,0" ToolTip="Import .mrpack or .zip Modpack">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BtnBorder" Background="#12131C" BorderBrush="#261E38" BorderThickness="1.2" CornerRadius="8" Padding="14,9">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.4"/>
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource VayuIconUpload}" Fill="#94A3B8" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="BtnText" Text="IMPORT" FontSize="11.5" FontWeight="Bold" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#7C3AED"/>
                                        <Setter TargetName="BtnBorder" Property="Background" Value="#1A1829"/>
                                        <Setter TargetName="BtnText" Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="BtnBorder" Property="RenderTransform">
                                            <Setter.Value>
                                                <TranslateTransform Y="1"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- ⇄ CONVERT VERSION Button -->
                    <Button Command="{Binding OpenConvertModalCommand}"
                            Cursor="Hand" Margin="0,0,8,0" ToolTip="Convert instance or modpack to any Minecraft version">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BtnBorder" Background="#12131C" BorderBrush="#261E38" BorderThickness="1.2" CornerRadius="8" Padding="14,9">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.4"/>
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource VayuIconConvert}" Fill="#C084FC" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="BtnText" Text="CONVERT VERSION" FontSize="11.5" FontWeight="Bold" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#A855F7"/>
                                        <Setter TargetName="BtnBorder" Property="Background" Value="#1A1829"/>
                                        <Setter TargetName="BtnText" Property="Foreground" Value="#C084FC"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="BtnBorder" Property="RenderTransform">
                                            <Setter.Value>
                                                <TranslateTransform Y="1"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 📁 GAME FOLDER Button -->
                    <Button Command="{Binding OpenGameDirectoryCommand}"
                            Cursor="Hand" ToolTip="Open Instances folder in File Explorer">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BtnBorder" Background="#12131C" BorderBrush="#261E38" BorderThickness="1.2" CornerRadius="8" Padding="14,9">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.4"/>
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource VayuIconFolder}" Fill="#94A3B8" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="BtnText" Text="GAME FOLDER" FontSize="11.5" FontWeight="Bold" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#7C3AED"/>
                                        <Setter TargetName="BtnBorder" Property="Background" Value="#1A1829"/>
                                        <Setter TargetName="BtnText" Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="BtnBorder" Property="RenderTransform">
                                            <Setter.Value>
                                                <TranslateTransform Y="1"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- 2. SUB-NAVIGATION TABS ROW                                      -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="1" Margin="0,0,0,16" BorderBrush="#161326" BorderThickness="0,0,0,1" Padding="0,0,0,6">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- GAME LIBRARY (Active Indicator) -->
                    <Button Content="GAME LIBRARY" Command="{Binding SelectTabCommand}" CommandParameter="Installations"
                            Cursor="Hand" Margin="0,0,24,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TabLabel" Text="{TemplateBinding Content}" FontSize="12.5" FontWeight="Black" Foreground="#94A3B8" Margin="0,0,0,6"/>
                                    <Rectangle x:Name="TabIndicator" Height="2.5" Fill="#A855F7" Visibility="Collapsed">
                                        <Rectangle.Effect>
                                            <DropShadowEffect Color="#A855F7" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                                        </Rectangle.Effect>
                                    </Rectangle>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Installations">
                                        <Setter TargetName="TabLabel" Property="Foreground" Value="#FFFFFF"/>
                                        <Setter TargetName="TabIndicator" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabLabel" Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- EXPLORE MODPACKS -->
                    <Button Content="EXPLORE MODPACKS" Command="{Binding SelectTabCommand}" CommandParameter="Modpacks"
                            Cursor="Hand" Margin="0,0,24,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TabLabel" Text="{TemplateBinding Content}" FontSize="12.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                                    <Rectangle x:Name="TabIndicator" Height="2.5" Fill="#A855F7" Visibility="Collapsed">
                                        <Rectangle.Effect>
                                            <DropShadowEffect Color="#A855F7" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                                        </Rectangle.Effect>
                                    </Rectangle>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Modpacks">
                                        <Setter TargetName="TabLabel" Property="Foreground" Value="#FFFFFF"/>
                                        <Setter TargetName="TabIndicator" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabLabel" Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- ADD-ON MODS -->
                    <Button Content="ADD-ON MODS" Command="{Binding SelectTabCommand}" CommandParameter="Mods"
                            Cursor="Hand" Margin="0,0,24,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TabLabel" Text="{TemplateBinding Content}" FontSize="12.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                                    <Rectangle x:Name="TabIndicator" Height="2.5" Fill="#A855F7" Visibility="Collapsed">
                                        <Rectangle.Effect>
                                            <DropShadowEffect Color="#A855F7" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                                        </Rectangle.Effect>
                                    </Rectangle>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Mods">
                                        <Setter TargetName="TabLabel" Property="Foreground" Value="#FFFFFF"/>
                                        <Setter TargetName="TabIndicator" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabLabel" Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- RESOURCE PACKS -->
                    <Button Content="RESOURCE PACKS" Command="{Binding SelectTabCommand}" CommandParameter="Resource Packs"
                            Cursor="Hand" Margin="0,0,24,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TabLabel" Text="{TemplateBinding Content}" FontSize="12.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                                    <Rectangle x:Name="TabIndicator" Height="2.5" Fill="#A855F7" Visibility="Collapsed">
                                        <Rectangle.Effect>
                                            <DropShadowEffect Color="#A855F7" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                                        </Rectangle.Effect>
                                    </Rectangle>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Resource Packs">
                                        <Setter TargetName="TabLabel" Property="Foreground" Value="#FFFFFF"/>
                                        <Setter TargetName="TabIndicator" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabLabel" Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- SHADER PACKS -->
                    <Button Content="SHADER PACKS" Command="{Binding SelectTabCommand}" CommandParameter="Shaders"
                            Cursor="Hand" Margin="0,0,24,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TabLabel" Text="{TemplateBinding Content}" FontSize="12.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                                    <Rectangle x:Name="TabIndicator" Height="2.5" Fill="#A855F7" Visibility="Collapsed">
                                        <Rectangle.Effect>
                                            <DropShadowEffect Color="#A855F7" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                                        </Rectangle.Effect>
                                    </Rectangle>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Shaders">
                                        <Setter TargetName="TabLabel" Property="Foreground" Value="#FFFFFF"/>
                                        <Setter TargetName="TabIndicator" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabLabel" Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- DATA PACKS -->
                    <Button Content="DATA PACKS" Command="{Binding SelectTabCommand}" CommandParameter="Data Packs"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TabLabel" Text="{TemplateBinding Content}" FontSize="12.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                                    <Rectangle x:Name="TabIndicator" Height="2.5" Fill="#A855F7" Visibility="Collapsed">
                                        <Rectangle.Effect>
                                            <DropShadowEffect Color="#A855F7" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                                        </Rectangle.Effect>
                                    </Rectangle>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Data Packs">
                                        <Setter TargetName="TabLabel" Property="Foreground" Value="#FFFFFF"/>
                                        <Setter TargetName="TabIndicator" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabLabel" Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- 3. SEARCH & FILTER & SORT TOOLBAR                               -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <!-- Installations Filter Bar (Shown when ActiveTab == 'Installations') -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="Installations">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Input Pill -->
                    <Border Grid.Column="0" Background="#0C0D15" BorderBrush="#201A30" BorderThickness="1.2" CornerRadius="16" Height="34" Padding="12,0" Margin="0,0,16,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource VayuIconSearch}" Fill="#94A3B8" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding LibrarySearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontFamily="{StaticResource VayuFontFamily}" FontSize="12"
                                     VerticalAlignment="Center">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Style.Resources>
                                            <VisualBrush x:Key="CueBannerBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="Search installations..." Foreground="#525266" FontSize="12" FontFamily="{StaticResource VayuFontFamily}"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Style.Resources>
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="{x:Null}">
                                                <Setter Property="Background" Value="{StaticResource CueBannerBrush}"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Background" Value="{StaticResource CueBannerBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>
                    </Border>

                    <!-- Filter Pills (All, Fabric, Forge, NeoForge, Vanilla, Favorites) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding LibraryLoaders}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Content="{Binding}" 
                                                 GroupName="LibraryLoaderFilters"
                                                 IsChecked="{Binding Path=DataContext.LibraryFilterLoader, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource StringEqualConverter}, ConverterParameter={Binding}}"
                                                 Command="{Binding Path=DataContext.ApplyLibraryFilterAndSortCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 FontSize="11" FontWeight="Bold" Margin="0,0,6,0"
                                                 Cursor="Hand">
                                        <RadioButton.Style>
                                            <Style TargetType="RadioButton">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="RadioButton">
                                                            <Border x:Name="ChipBorder" Background="#0C0D15" BorderBrush="#201A30" BorderThickness="1.2" CornerRadius="14" Padding="12,5">
                                                                <TextBlock x:Name="ChipText" Text="{TemplateBinding Content}" FontSize="11" FontWeight="Bold" Foreground="#8E8E9E"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="ChipBorder" Property="Background" Value="#251644"/>
                                                                    <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#A855F7"/>
                                                                    <Setter TargetName="ChipText" Property="Foreground" Value="#FFFFFF"/>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#7C3AED"/>
                                                                    <Setter TargetName="ChipText" Property="Foreground" Value="#FFFFFF"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </RadioButton.Style>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Sort Dropdown -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="SORT:" FontSize="10.5" FontWeight="Black" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding LibrarySortOptions}" SelectedItem="{Binding LibrarySortBy}"
                                  Style="{StaticResource VayuComboBox}" Width="135" Height="32"/>
                    </StackPanel>
                </Grid>

                <!-- Project Hub (Modpacks / Add-ons) Search Bar (Shown when ActiveTab != 'Installations') -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="Installations">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#0C0D15" BorderBrush="#201A30" BorderThickness="1.2" CornerRadius="8" Padding="12,7" Margin="0,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource VayuIconSearch}" Fill="#A855F7" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontFamily="{StaticResource VayuFontFamily}" FontSize="12.5"
                                     VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Button Grid.Column="1" Content="Search Modrinth" Command="{Binding SearchModrinthCommand}"
                            Style="{StaticResource VayuDarkButton}" Padding="16,8"/>
                </Grid>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- 4. 3D INSTALLATION MANAGER STAGE ARENA                          -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="3">
                <!-- ─── TAB: INSTALLATIONS (THE NEW 3D GAME LIBRARY STAGE) ─── -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="Installations">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <!-- Empty State (When 0 Installations) -->
                    <Border Visibility="{Binding HasInstallations, Converter={StaticResource InverseBoolToVis}}"
                            CornerRadius="16" Background="#0C0D16" BorderBrush="#2D2248" BorderThickness="1.5"
                            Padding="48,48" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                        <Border.Effect>
                            <DropShadowEffect Color="#7C3AED" BlurRadius="24" ShadowDepth="0" Opacity="0.3"/>
                        </Border.Effect>
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{StaticResource VayuIconInstances}" Fill="#A855F7" Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                            <TextBlock Text="No Installations Found" FontSize="20" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                            <TextBlock Text="Create your first isolated Minecraft installation or explore popular modpacks." FontSize="13" Foreground="#94A3B8" Margin="0,8,0,24" HorizontalAlignment="Center" TextAlignment="Center"/>
                            <Button Style="{StaticResource VayuAccentButton}" Padding="22,11" Command="{Binding NewInstallationCommand}" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource VayuIconPlus}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Create New Installation" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- 3D Stage Arena (When 1+ Installations) -->
                    <Grid Visibility="{Binding HasInstallations, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>      <!-- Left Inactive Stage Area -->
                            <ColumnDefinition Width="Auto"/>   <!-- Center Active 3D Pod (Hero) -->
                            <ColumnDefinition Width="*"/>      <!-- Right Inactive Stage Area -->
                        </Grid.ColumnDefinitions>

                        <!-- Left Navigation Chevron Arrow -->
                        <Button Grid.Column="0" Command="{Binding SelectPreviousInstallationCommand}"
                                Visibility="{Binding HasPreviousInstallation, Converter={StaticResource BoolToVis}}"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"
                                Cursor="Hand" ToolTip="Previous Installation (◀)">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ArrowBorder" Width="38" Height="38" CornerRadius="19" Background="#11121C" BorderBrush="#251E38" BorderThickness="1.2">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.6"/>
                                        </Border.Effect>
                                        <TextBlock x:Name="ArrowText" Text="❮" FontSize="14" FontWeight="Black" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-2,0,0,0"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ArrowBorder" Property="BorderBrush" Value="#A855F7"/>
                                            <Setter TargetName="ArrowBorder" Property="Background" Value="#25183E"/>
                                            <Setter TargetName="ArrowText" Property="Foreground" Value="#FFFFFF"/>
                                            <Setter TargetName="ArrowBorder" Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#A855F7" BlurRadius="16" ShadowDepth="0" Opacity="0.7"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Left Flanking Inactive 3D Pods -->
                        <ItemsControl Grid.Column="0" ItemsSource="{Binding FlankingLeftInstallations}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,24,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Inactive 3D Pod Chassis -->
                                    <Grid Width="250" Height="220" Margin="0,8,0,8" Cursor="Hand">
                                        <!-- Outer Glowing Purple Cyber Bracket Side Fins -->
                                        <!-- Left Fin Light Slit -->
                                        <Border Width="4" Height="70" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                CornerRadius="2" Background="#A855F7" Margin="-5,0,0,0"
                                                Effect="{StaticResource PurpleNeonGlow}" Opacity="0.75"/>
                                        <!-- Right Fin Light Slit -->
                                        <Border Width="4" Height="70" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                CornerRadius="2" Background="#A855F7" Margin="0,0,-5,0"
                                                Effect="{StaticResource PurpleNeonGlow}" Opacity="0.75"/>

                                        <!-- Pod Main Chassis -->
                                        <Border CornerRadius="14" BorderThickness="1.2" Padding="14,12" Effect="{StaticResource InactivePodGlow}">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#12131F" Offset="0.0"/>
                                                    <GradientStop Color="#090A10" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Border.BorderBrush>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#362952" Offset="0.0"/>
                                                    <GradientStop Color="#161324" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Border.BorderBrush>

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/> <!-- Title & Favorite Star -->
                                                    <RowDefinition Height="*"/>    <!-- Compact Specs -->
                                                    <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                                                </Grid.RowDefinitions>

                                                <!-- 1. Header: Installation Name & Star -->
                                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Black" Foreground="#CBD5E1" 
                                                               TextTrimming="CharacterEllipsis" MaxWidth="180" VerticalAlignment="Center"/>
                                                    <!-- Star Button -->
                                                    <Button Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <TextBlock Text="★" FontSize="13">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="#525266"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                                    <Setter Property="Foreground" Value="#F59E0B"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>

                                                <!-- 2. Compact Spec Rows -->
                                                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                                    <!-- Version Row -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <Path Data="{StaticResource VayuIconCube}" Fill="#64748B" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding MinecraftVersion, StringFormat='MC {0}'}" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8"/>
                                                    </StackPanel>

                                                    <!-- Loader Row -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <Path Data="{StaticResource VayuIconWrench}" Fill="#64748B" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Loader}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding LoaderAccentColor}"/>
                                                    </StackPanel>

                                                    <!-- Mods Row -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <Path Data="{StaticResource VayuIconMods}" Fill="#64748B" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding DisplayModCount}" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8"/>
                                                    </StackPanel>

                                                    <!-- RAM Row -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <Path Data="{StaticResource VayuIconMemory}" Fill="#64748B" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding DisplayRam}" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8"/>
                                                    </StackPanel>

                                                    <!-- Last Played -->
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource VayuIconClock}" Fill="#64748B" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding DisplayLastPlayedRelative}" FontSize="10" Foreground="#64748B"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- 3. Bottom Action Row: ▶ SELECT and ••• -->
                                                <Grid Grid.Row="2" Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- SELECT Button -->
                                                    <Button Grid.Column="0" Command="{Binding DataContext.SelectInstallationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Cursor="Hand" Margin="0,0,6,0">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="SelBorder" Background="#161524" BorderBrush="#2C2442" BorderThickness="1" CornerRadius="6" Padding="0,5">
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <Path Data="{StaticResource VayuIconPlay}" Fill="#CBD5E1" Width="8" Height="8" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="SELECT" FontSize="10" FontWeight="Black" Foreground="#CBD5E1"/>
                                                                    </StackPanel>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="SelBorder" Property="Background" Value="#251644"/>
                                                                        <Setter TargetName="SelBorder" Property="BorderBrush" Value="#A855F7"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>

                                                    <!-- ••• Context Button -->
                                                    <Button Grid.Column="1" Command="{Binding DataContext.InspectInstanceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Cursor="Hand">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="MenuBorder" Width="28" Height="26" Background="#12131C" BorderBrush="#201A30" BorderThickness="1" CornerRadius="6">
                                                                    <Path Data="{StaticResource VayuIconMore}" Fill="#94A3B8" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="MenuBorder" Property="BorderBrush" Value="#7C3AED"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- ═══ CENTER ACTIVE 3D HERO POD ═══ -->
                        <Grid Grid.Column="1" Width="390" Height="430" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Outer Glowing Cyber Bracket Side Fins -->
                            <!-- Left Fin Bracket with Glowing Purple Slits -->
                            <Grid HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-16,0,0,0">
                                <Path Data="M 0,20 L 12,0 L 12,140 L 0,120 Z" Fill="#0D0E16" Stroke="#2D2248" StrokeThickness="1.2"/>
                                <!-- Neon Slit Light Strip -->
                                <Border Width="4.5" Height="90" Background="#A855F7" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Effect="{StaticResource PurpleNeonGlow}"/>
                            </Grid>

                            <!-- Right Fin Bracket with Glowing Purple Slits -->
                            <Grid HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-16,0">
                                <Path Data="M 12,20 L 0,0 L 0,140 L 12,120 Z" Fill="#0D0E16" Stroke="#2D2248" StrokeThickness="1.2"/>
                                <!-- Neon Slit Light Strip -->
                                <Border Width="4.5" Height="90" Background="#A855F7" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Effect="{StaticResource PurpleNeonGlow}"/>
                            </Grid>

                            <!-- Center Active 3D Pod Body -->
                            <Border CornerRadius="18" BorderThickness="1.5" Padding="22,18" Effect="{StaticResource ActivePodGlow}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#141525" Offset="0.0"/>
                                        <GradientStop Color="#0D0E17" Offset="0.4"/>
                                        <GradientStop Color="#07080F" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#523B75" Offset="0.0"/>
                                        <GradientStop Color="#251C3B" Offset="0.5"/>
                                        <GradientStop Color="#13101E" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/> <!-- Top Badges (ACTIVE pill + Star) -->
                                        <RowDefinition Height="Auto"/> <!-- Instance Title -->
                                        <RowDefinition Height="*"/>    <!-- Detailed Iconic Spec Rows -->
                                        <RowDefinition Height="Auto"/> <!-- Bottom Action Row (PLAY + Context Menu) -->
                                    </Grid.RowDefinitions>

                                    <!-- 1. Top Badges Row -->
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <!-- Left: ● ACTIVE Badge -->
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Background="#2C124D" BorderBrush="#A855F7" BorderThickness="1.2" CornerRadius="10" Padding="10,4">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Fill="#C084FC" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="#C084FC" BlurRadius="6" ShadowDepth="0" Opacity="0.9"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                                <TextBlock Text="ACTIVE" FontSize="10.5" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Right: Favorite Star Button -->
                                        <Button Command="{Binding ToggleFavoriteCommand}" CommandParameter="{Binding SelectedInstallation}"
                                                HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" ToolTip="Toggle Favorite">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="StarBorder" Width="32" Height="32" CornerRadius="16" Background="#11121C" BorderBrush="#251E38" BorderThickness="1">
                                                        <TextBlock x:Name="StarGlyph" Text="★" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#64748B"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SelectedInstallation.IsFavorite}" Value="True">
                                                                            <Setter Property="Foreground" Value="#F59E0B"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="StarBorder" Property="BorderBrush" Value="#A855F7"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>

                                    <!-- 2. Instance Title -->
                                    <TextBlock Grid.Row="1" Text="{Binding SelectedInstallation.Name, FallbackValue='Selected Installation'}" 
                                               FontSize="20" FontWeight="Black" Foreground="#FFFFFF"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,0,16">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.6"/>
                                        </TextBlock.Effect>
                                    </TextBlock>

                                    <!-- 3. Iconic Spec Rows -->
                                    <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="0,0,0,18">
                                        <!-- Row 1: Minecraft Version -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0" Data="{StaticResource VayuIconCube}" Fill="#94A3B8" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Minecraft Version" FontSize="12.5" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Background="#161726" BorderBrush="#2A243D" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                                <TextBlock Text="{Binding SelectedInstallation.MinecraftVersion, FallbackValue='1.21.11'}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            </Border>
                                        </Grid>

                                        <!-- Row 2: Mod Loader -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0" Data="{StaticResource VayuIconWrench}" Fill="#94A3B8" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Mod Loader" FontSize="12.5" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Background="#161726" BorderBrush="#2A243D" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                                <TextBlock Text="{Binding SelectedInstallation.Loader, FallbackValue='Fabric'}" FontSize="12" FontWeight="Bold" Foreground="{Binding SelectedInstallation.LoaderAccentColor}"/>
                                            </Border>
                                        </Grid>

                                        <!-- Row 3: Mods -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0" Data="{StaticResource VayuIconMods}" Fill="#94A3B8" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Mods" FontSize="12.5" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Background="#161726" BorderBrush="#2A243D" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                                <TextBlock Text="{Binding SelectedInstallation.DisplayModCount, FallbackValue='0 Mods'}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            </Border>
                                        </Grid>

                                        <!-- Row 4: Allocated Memory -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0" Data="{StaticResource VayuIconMemory}" Fill="#94A3B8" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Allocated Memory" FontSize="12.5" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Background="#161726" BorderBrush="#2A243D" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                                <TextBlock Text="{Binding SelectedInstallation.DisplayRam, FallbackValue='4096 MB'}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            </Border>
                                        </Grid>

                                        <!-- Row 5: Last Played -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0" Data="{StaticResource VayuIconClock}" Fill="#94A3B8" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Last Played" FontSize="12.5" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Background="#161726" BorderBrush="#2A243D" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                                <TextBlock Text="{Binding SelectedInstallation.DisplayLastPlayedRelative, FallbackValue='Never played'}" FontSize="12" FontWeight="Bold" Foreground="#CBD5E1"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>

                                    <!-- 4. Bottom Action Row (Large ▶ PLAY Pill Button + ••• Context Menu Button) -->
                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Large ▶ PLAY Button -->
                                        <Button Grid.Column="0" Command="{Binding PlayInstanceDirectlyCommand}" CommandParameter="{Binding SelectedInstallation}"
                                                Cursor="Hand" Margin="0,0,10,0" ToolTip="Launch Active Installation">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="PlayBorder" CornerRadius="10" Height="44" BorderThickness="1.2" Effect="{StaticResource PlayButtonGlow}">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#7C3AED" Offset="0.0"/>
                                                                <GradientStop Color="#6366F1" Offset="1.0"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <Border.BorderBrush>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#D8B4FE" Offset="0.0"/>
                                                                <GradientStop Color="#7C3AED" Offset="1.0"/>
                                                            </LinearGradientBrush>
                                                        </Border.BorderBrush>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Path Data="{StaticResource VayuIconPlay}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="PLAY" FontSize="14" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedInstallation.IsRunning}" Value="True">
                                                            <Setter TargetName="PlayBorder" Property="Background">
                                                                <Setter.Value>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                        <GradientStop Color="#DC2626" Offset="0.0"/>
                                                                        <GradientStop Color="#991B1B" Offset="1.0"/>
                                                                    </LinearGradientBrush>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Setter TargetName="PlayBorder" Property="BorderBrush" Value="#FCA5A5"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="PlayBorder" Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect Color="#A855F7" BlurRadius="26" ShadowDepth="0" Opacity="0.85"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="PlayBorder" Property="RenderTransform">
                                                                <Setter.Value>
                                                                    <TranslateTransform Y="1.5"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- ••• Context Menu Button -->
                                        <Button Grid.Column="1" Cursor="Hand" ToolTip="More Options">
                                            <Button.ContextMenu>
                                                <ContextMenu Background="#11121C" BorderBrush="#7C3AED" BorderThickness="1.2">
                                                    <MenuItem Header="✏ Edit Installation" Command="{Binding EditInstanceCommand}" CommandParameter="{Binding SelectedInstallation}"/>
                                                    <MenuItem Header="⧉ Clone Installation" Command="{Binding OpenCloneModalCommand}" CommandParameter="{Binding SelectedInstallation}"/>
                                                    <MenuItem Header="📁 Open Game Folder" Command="{Binding OpenInstanceFolderCommand}" CommandParameter="{Binding SelectedInstallation}"/>
                                                    <MenuItem Header="🔄 Convert Version" Command="{Binding OpenConvertModalCommand}" CommandParameter="{Binding SelectedInstallation}"/>
                                                    <MenuItem Header="⚡ Launch Custom Name" Command="{Binding OpenCustomLaunchModalCommand}" CommandParameter="{Binding SelectedInstallation}"/>
                                                    <MenuItem Header="🔍 Inspect Specifications" Command="{Binding InspectInstanceCommand}" CommandParameter="{Binding SelectedInstallation}"/>
                                                    <Separator Background="#261E38"/>
                                                    <MenuItem Header="🗑 Delete Installation" Command="{Binding DeleteInstanceCommand}" CommandParameter="{Binding SelectedInstallation}" Foreground="#EF4444"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="MenuBorder" Width="46" Height="44" Background="#161726" BorderBrush="#2E2A44" BorderThickness="1.2" CornerRadius="10">
                                                        <Path Data="{StaticResource VayuIconMore}" Fill="#CBD5E1" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="MenuBorder" Property="BorderBrush" Value="#A855F7"/>
                                                            <Setter TargetName="MenuBorder" Property="Background" Value="#25183E"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Right Flanking Inactive 3D Pods -->
                        <ItemsControl Grid.Column="2" ItemsSource="{Binding FlankingRightInstallations}"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="24,0,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Inactive 3D Pod Chassis -->
                                    <Grid Width="250" Height="220" Margin="0,8,0,8" Cursor="Hand">
                                        <!-- Outer Glowing Purple Cyber Bracket Side Fins -->
                                        <!-- Left Fin Light Slit -->
                                        <Border Width="4" Height="70" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                CornerRadius="2" Background="#A855F7" Margin="-5,0,0,0"
                                                Effect="{StaticResource PurpleNeonGlow}" Opacity="0.75"/>
                                        <!-- Right Fin Light Slit -->
                                        <Border Width="4" Height="70" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                CornerRadius="2" Background="#A855F7" Margin="0,0,-5,0"
                                                Effect="{StaticResource PurpleNeonGlow}" Opacity="0.75"/>

                                        <!-- Pod Main Chassis -->
                                        <Border CornerRadius="14" BorderThickness="1.2" Padding="14,12" Effect="{StaticResource InactivePodGlow}">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#12131F" Offset="0.0"/>
                                                    <GradientStop Color="#090A10" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Border.BorderBrush>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#362952" Offset="0.0"/>
                                                    <GradientStop Color="#161324" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Border.BorderBrush>

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/> <!-- Title & Favorite Star -->
                                                    <RowDefinition Height="*"/>    <!-- Compact Specs -->
                                                    <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                                                </Grid.RowDefinitions>

                                                <!-- 1. Header: Installation Name & Star -->
                                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Black" Foreground="#CBD5E1" 
                                                               TextTrimming="CharacterEllipsis" MaxWidth="180" VerticalAlignment="Center"/>
                                                    <!-- Star Button -->
                                                    <Button Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <TextBlock Text="★" FontSize="13">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="#525266"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                                    <Setter Property="Foreground" Value="#F59E0B"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>

                                                <!-- 2. Compact Spec Rows -->
                                                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                                    <!-- Version Row -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <Path Data="{StaticResource VayuIconCube}" Fill="#64748B" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding MinecraftVersion, StringFormat='MC {0}'}" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8"/>
                                                    </StackPanel>

                                                    <!-- Loader Row -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <Path Data="{StaticResource VayuIconWrench}" Fill="#64748B" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Loader}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding LoaderAccentColor}"/>
                                                    </StackPanel>

                                                    <!-- Mods Row -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <Path Data="{StaticResource VayuIconMods}" Fill="#64748B" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding DisplayModCount}" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8"/>
                                                    </StackPanel>

                                                    <!-- RAM Row -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <Path Data="{StaticResource VayuIconMemory}" Fill="#64748B" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding DisplayRam}" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8"/>
                                                    </StackPanel>

                                                    <!-- Last Played -->
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource VayuIconClock}" Fill="#64748B" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding DisplayLastPlayedRelative}" FontSize="10" Foreground="#64748B"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- 3. Bottom Action Row: ▶ SELECT and ••• -->
                                                <Grid Grid.Row="2" Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- SELECT Button -->
                                                    <Button Grid.Column="0" Command="{Binding DataContext.SelectInstallationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Cursor="Hand" Margin="0,0,6,0">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="SelBorder" Background="#161524" BorderBrush="#2C2442" BorderThickness="1" CornerRadius="6" Padding="0,5">
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <Path Data="{StaticResource VayuIconPlay}" Fill="#CBD5E1" Width="8" Height="8" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="SELECT" FontSize="10" FontWeight="Black" Foreground="#CBD5E1"/>
                                                                    </StackPanel>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="SelBorder" Property="Background" Value="#251644"/>
                                                                        <Setter TargetName="SelBorder" Property="BorderBrush" Value="#A855F7"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>

                                                    <!-- ••• Context Button -->
                                                    <Button Grid.Column="1" Command="{Binding DataContext.InspectInstanceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Cursor="Hand">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="MenuBorder" Width="28" Height="26" Background="#12131C" BorderBrush="#201A30" BorderThickness="1" CornerRadius="6">
                                                                    <Path Data="{StaticResource VayuIconMore}" Fill="#94A3B8" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="MenuBorder" Property="BorderBrush" Value="#7C3AED"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Right Navigation Chevron Arrow -->
                        <Button Grid.Column="2" Command="{Binding SelectNextInstallationCommand}"
                                Visibility="{Binding HasNextInstallation, Converter={StaticResource BoolToVis}}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                Cursor="Hand" ToolTip="Next Installation (▶)">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ArrowBorder" Width="38" Height="38" CornerRadius="19" Background="#11121C" BorderBrush="#251E38" BorderThickness="1.2">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.6"/>
                                        </Border.Effect>
                                        <TextBlock x:Name="ArrowText" Text="❯" FontSize="14" FontWeight="Black" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ArrowBorder" Property="BorderBrush" Value="#A855F7"/>
                                            <Setter TargetName="ArrowBorder" Property="Background" Value="#25183E"/>
                                            <Setter TargetName="ArrowText" Property="Foreground" Value="#FFFFFF"/>
                                            <Setter TargetName="ArrowBorder" Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#A855F7" BlurRadius="16" ShadowDepth="0" Opacity="0.7"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>

                <!-- ─── TAB: MODPACKS & ADD-ONS (MODRINTH EXPLORER) ─── -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="Installations">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource VayuScrollViewer}">
                        <StackPanel Margin="0,0,0,20">
                            <!-- Modrinth Search Results -->
                            <ItemsControl ItemsSource="{Binding ModrinthProjects}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,12" Padding="16,14" CornerRadius="12" Background="#0C0D16" BorderBrush="#261E38" BorderThickness="1.2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Project Icon -->
                                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="8" Background="#141021" BorderBrush="#3B2E58" BorderThickness="1" Margin="0,0,16,0" ClipToBounds="True">
                                                    <Image Source="{Binding IconUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Border>

                                                <!-- Info -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Black" Foreground="#FFFFFF" Margin="0,0,8,0"/>
                                                        <Border Background="#1C1335" BorderBrush="#7C3AED" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ProjectType}" FontSize="10" FontWeight="Bold" Foreground="#C084FC"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding Downloads, StringFormat='⬇ {0:N0} downloads • Author: '}" FontSize="11" Foreground="#64748B"/>
                                                </StackPanel>

                                                <!-- Install Action Button -->
                                                <Button Grid.Column="2" Content="Install" 
                                                        Command="{Binding DataContext.InstallProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource VayuAccentButton}" Padding="16,8" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- 5. INSTANCE INSPECT 3D MODAL DRAWER                             -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Visibility="{Binding IsInspectOpen, Converter={StaticResource BoolToVis}}" Background="#D0000000">
            <Border Width="480" MaxHeight="600" Background="#0D0C18" BorderBrush="#7C3AED" BorderThickness="1.5" CornerRadius="14" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#7C3AED" BlurRadius="30" ShadowDepth="0" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Modal Header -->
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="Instance Specifications" FontSize="17" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        <Button Command="{Binding CloseInspectCommand}" Style="{StaticResource VayuDarkButton}" Width="28" Height="28" Padding="0" HorizontalAlignment="Right">
                            <Path Data="{StaticResource VayuIconClose}" Fill="#94A3B8" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- Details Box -->
                    <Border Background="#07060D" BorderBrush="#2A1F40" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding InspectingInstance.Name}" FontSize="16" FontWeight="Black" Foreground="#C084FC" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding InspectingInstance.DisplaySubtitle, StringFormat='Loader: {0}'}" FontSize="12.5" FontWeight="Bold" Foreground="#E2E8F0" Margin="0,0,0,10"/>
                            
                            <TextBlock Text="Allocated Memory:" FontSize="11" Foreground="#64748B"/>
                            <TextBlock Text="{Binding InspectingInstance.DisplayRam}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8"/>

                            <TextBlock Text="Performance Profile:" FontSize="11" Foreground="#64748B"/>
                            <TextBlock Text="{Binding InspectingInstance.PerformanceProfile}" FontSize="12" FontWeight="Bold" Foreground="#A855F7" Margin="0,0,0,8"/>

                            <TextBlock Text="Installed Mods Count:" FontSize="11" Foreground="#64748B"/>
                            <TextBlock Text="{Binding InspectingInstance.DisplayModCount}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8"/>

                            <TextBlock Text="Game Directory:" FontSize="11" Foreground="#64748B"/>
                            <TextBlock Text="{Binding InspectingInstance.GameDirectory}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        </StackPanel>
                    </Border>

                    <!-- Close Button -->
                    <Button Content="Close" Command="{Binding CloseInspectCommand}" Style="{StaticResource VayuAccentButton}" Padding="16,8" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- 6. EDIT INSTANCE 3D MODAL                                       -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Visibility="{Binding IsEditModalOpen, Converter={StaticResource BoolToVis}}" Background="#D0000000">
            <Border Width="480" Background="#0D0C18" BorderBrush="#7C3AED" BorderThickness="1.5" CornerRadius="14" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#7C3AED" BlurRadius="30" ShadowDepth="0" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Edit Installation Configuration" FontSize="17" FontWeight="Black" Foreground="#FFFFFF" Margin="0,0,0,16"/>

                    <TextBlock Text="INSTALLATION NAME" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <Border Background="#07060D" BorderBrush="#261E38" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,12">
                        <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="12.5"/>
                    </Border>

                    <TextBlock Text="MINECRAFT VERSION" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding ModpackVersions}" SelectedItem="{Binding EditVersion}" Style="{StaticResource VayuComboBox}" Margin="0,0,0,12"/>

                    <TextBlock Text="MOD LOADER" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding ModpackLoaders}" SelectedItem="{Binding EditLoader}" Style="{StaticResource VayuComboBox}" Margin="0,0,0,12"/>

                    <TextBlock Text="{Binding EditRamMB, StringFormat='ALLOCATED RAM: {0} MB'}" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <Slider Minimum="2048" Maximum="16384" SmallChange="1024" LargeChange="2048" TickFrequency="1024" IsSnapToTickEnabled="True"
                            Value="{Binding EditRamMB}" Margin="0,0,0,16"/>

                    <!-- Modal Actions -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CancelEditCommand}" Style="{StaticResource VayuDarkButton}" Padding="16,8" Margin="0,0,8,0"/>
                        <Button Content="Save Changes" Command="{Binding SaveInstanceEditCommand}" Style="{StaticResource VayuAccentButton}" Padding="18,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- 7. MODPACK CREATION / INSTALLATION 3D MODAL                     -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Visibility="{Binding IsModpackModalOpen, Converter={StaticResource BoolToVis}}" Background="#D0000000">
            <Border Width="500" Background="#0D0C18" BorderBrush="#7C3AED" BorderThickness="1.5" CornerRadius="14" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#7C3AED" BlurRadius="30" ShadowDepth="0" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource VayuIconDownload}" Fill="#C084FC" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Install Modpack Instance" FontSize="17" FontWeight="Black" Foreground="#FFFFFF"/>
                        </StackPanel>
                        <Button Command="{Binding CancelModpackInstallCommand}" Style="{StaticResource VayuDarkButton}" Width="28" Height="28" Padding="0" HorizontalAlignment="Right">
                            <Path Data="{StaticResource VayuIconClose}" Fill="#94A3B8" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="NEW INSTANCE NAME" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <Border Background="#07060D" BorderBrush="#261E38" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,12">
                        <TextBox Text="{Binding ModpackInstanceName, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="12.5"/>
                    </Border>

                    <TextBlock Text="MINECRAFT VERSION" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding ModpackVersions}" SelectedItem="{Binding SelectedModpackVersion}" Style="{StaticResource VayuComboBox}" Margin="0,0,0,12"/>

                    <TextBlock Text="MOD LOADER" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding ModpackLoaders}" SelectedItem="{Binding SelectedModpackLoader}" Style="{StaticResource VayuComboBox}" Margin="0,0,0,12"/>

                    <TextBlock Text="{Binding ModpackRamMB, StringFormat='ALLOCATED RAM: {0} MB'}" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <Slider Minimum="2048" Maximum="16384" SmallChange="1024" LargeChange="2048" TickFrequency="1024" IsSnapToTickEnabled="True"
                            Value="{Binding ModpackRamMB}" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CancelModpackInstallCommand}" Style="{StaticResource VayuDarkButton}" Padding="16,8" Margin="0,0,8,0"/>
                        <Button Content="Create &amp; Install" Command="{Binding ConfirmModpackInstallCommand}" Style="{StaticResource VayuAccentButton}" Padding="20,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- 8. TARGET INSTANCE SELECTOR 3D MODAL                            -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Visibility="{Binding IsTargetInstanceModalOpen, Converter={StaticResource BoolToVis}}" Background="#D0000000">
            <Border Width="500" Background="#0D0C18" BorderBrush="#7C3AED" BorderThickness="1.5" CornerRadius="14" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#7C3AED" BlurRadius="30" ShadowDepth="0" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource VayuIconMods}" Fill="#C084FC" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TargetContentType, StringFormat='Install {0}'}" FontSize="17" FontWeight="Black" Foreground="#FFFFFF"/>
                        </StackPanel>
                        <Button Command="{Binding CancelTargetInstanceCommand}" Style="{StaticResource VayuDarkButton}" Width="28" Height="28" Padding="0" HorizontalAlignment="Right">
                            <Path Data="{StaticResource VayuIconClose}" Fill="#94A3B8" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <Border Background="#07060D" BorderBrush="#261E38" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding PendingContentProject.Title}" FontSize="15" FontWeight="Black" Foreground="#C084FC" Margin="0,0,0,3"/>
                            <TextBlock Text="{Binding PendingContentProject.Description}" FontSize="11.5" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="SELECT TARGET INSTANCE" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding Installations}" SelectedItem="{Binding SelectedTargetInstance}" Style="{StaticResource VayuComboBox}" Margin="0,0,0,20">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="{Binding Loader, StringFormat=' ({0}'}" Foreground="#C084FC" Margin="4,0,0,0"/>
                                    <TextBlock Text="{Binding MinecraftVersion, StringFormat=' {0})'}" Foreground="#94A3B8"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CancelTargetInstanceCommand}" Style="{StaticResource VayuDarkButton}" Padding="16,8" Margin="0,0,8,0"/>
                        <Button Content="Install Now" Command="{Binding ConfirmTargetInstanceCommand}" Style="{StaticResource VayuAccentButton}" Padding="20,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- 9. CLONE INSTANCE 3D MODAL                                      -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Visibility="{Binding IsCloneModalOpen, Converter={StaticResource BoolToVis}}" Background="#D0000000">
            <Border Width="480" Background="#0D0C18" BorderBrush="#A78BFA" BorderThickness="1.5" CornerRadius="14" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#7C3AED" BlurRadius="30" ShadowDepth="0" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⧉" FontSize="18" FontWeight="Bold" Foreground="#C084FC" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Clone Installation" FontSize="17" FontWeight="Black" Foreground="#FFFFFF"/>
                        </StackPanel>
                        <Button Command="{Binding CloseCloneModalCommand}" Style="{StaticResource VayuDarkButton}" Width="28" Height="28" Padding="0" HorizontalAlignment="Right">
                            <Path Data="{StaticResource VayuIconClose}" Fill="#94A3B8" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <Border Background="#07060D" BorderBrush="#261E38" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="SOURCE INSTANCE" FontSize="9" FontWeight="Black" Foreground="#C084FC" Margin="0,0,0,3"/>
                            <TextBlock Text="{Binding CloningInstance.Name}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="{Binding CloningInstance.DisplaySubtitle}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="NEW INSTANCE NAME" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <Border Background="#07060D" BorderBrush="#261E38" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,14">
                        <TextBox Text="{Binding CloneNewName, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="12.5"/>
                    </Border>

                    <CheckBox IsChecked="{Binding CloneCopyData}" Style="{StaticResource VayuCheckBox}" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Copy installed mods, config files, and options" FontSize="11.5" Foreground="#CBD5E1"/>
                        </StackPanel>
                    </CheckBox>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CloseCloneModalCommand}" Style="{StaticResource VayuDarkButton}" Padding="16,8" Margin="0,0,8,0"/>
                        <Button Content="Clone Instance" Command="{Binding ConfirmCloneCommand}" Style="{StaticResource VayuAccentButton}" Padding="20,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- 10. LAUNCH WITH CUSTOM NAME 3D MODAL                            -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Visibility="{Binding IsCustomLaunchModalOpen, Converter={StaticResource BoolToVis}}" Background="#D0000000">
            <Border Width="460" Background="#0D0C18" BorderBrush="#7C3AED" BorderThickness="1.5" CornerRadius="14" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#7C3AED" BlurRadius="30" ShadowDepth="0" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="18" Foreground="#C084FC" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Launch with Custom Name" FontSize="17" FontWeight="Black" Foreground="#FFFFFF"/>
                        </StackPanel>
                        <Button Command="{Binding CloseCustomLaunchModalCommand}" Style="{StaticResource VayuDarkButton}" Width="28" Height="28" Padding="0" HorizontalAlignment="Right">
                            <Path Data="{StaticResource VayuIconClose}" Fill="#94A3B8" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <Border Background="#07060D" BorderBrush="#261E38" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="TARGET INSTANCE" FontSize="9" FontWeight="Black" Foreground="#C084FC" Margin="0,0,0,3"/>
                            <TextBlock Text="{Binding CustomLaunchTargetInstance.Name}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="{Binding CustomLaunchTargetInstance.DisplaySubtitle}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="PLAYER USERNAME" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <Border Background="#07060D" BorderBrush="#261E38" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,20">
                        <TextBox Text="{Binding CustomLaunchPlayerName, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="12.5"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CloseCustomLaunchModalCommand}" Style="{StaticResource VayuDarkButton}" Padding="16,8" Margin="0,0,8,0"/>
                        <Button Content="Launch Game 🚀" Command="{Binding ConfirmCustomLaunchCommand}" Style="{StaticResource VayuAccentButton}" Padding="20,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
