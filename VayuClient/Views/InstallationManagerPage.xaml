<UserControl x:Class="VayuClient.Views.InstallationManagerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="780" d:DesignWidth="1100"
             Background="#070B14">

    <Grid>
        <!-- ═══ AMBIENT CYBER NETHER BACKGROUND ═══ -->
        <Image Source="/Assets/Images/bg_cyber_nether.jpg" 
               Stretch="UniformToFill" 
               HorizontalAlignment="Center" 
               VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality"
               Opacity="0.25"/>

        <!-- Dark Radial & Linear Gradient Overlay for High Readability -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#D0070B14" Offset="0.0"/>
                    <GradientStop Color="#E6070B14" Offset="0.5"/>
                    <GradientStop Color="#FA070B14" Offset="1.0"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Margin="28,18,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header + Main Nav Tabs -->
                <RowDefinition Height="Auto"/> <!-- Search & Filter Toolbar -->
                <RowDefinition Height="*"/>    <!-- Content Area (Game Library Grid / Modpacks / Mods) -->
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- 1. TOP HEADER & MAIN ACTION BUTTONS                             -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Navigation Tabs (Installations, Modpacks, Mods, Resource Packs, Shaders) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Game Library" Command="{Binding SelectTabCommand}" CommandParameter="Installations"
                            FontSize="13.5" FontWeight="Black" Margin="0,0,12,0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource VayuDarkButton}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="{StaticResource VayuTextDimBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Installations">
                                        <Setter Property="Foreground" Value="#38BDF8"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,2.5"/>
                                        <Setter Property="BorderBrush" Value="#38BDF8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Explore Modpacks" Command="{Binding SelectTabCommand}" CommandParameter="Modpacks"
                            FontSize="13" FontWeight="Bold" Margin="0,0,12,0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource VayuDarkButton}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="{StaticResource VayuTextDimBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Modpacks">
                                        <Setter Property="Foreground" Value="#38BDF8"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,2.5"/>
                                        <Setter Property="BorderBrush" Value="#38BDF8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Add-on Mods" Command="{Binding SelectTabCommand}" CommandParameter="Mods"
                            FontSize="13" FontWeight="Bold" Margin="0,0,12,0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource VayuDarkButton}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="{StaticResource VayuTextDimBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Mods">
                                        <Setter Property="Foreground" Value="#38BDF8"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,2.5"/>
                                        <Setter Property="BorderBrush" Value="#38BDF8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Resource Packs" Command="{Binding SelectTabCommand}" CommandParameter="Resource Packs"
                            FontSize="13" FontWeight="Bold" Margin="0,0,12,0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource VayuDarkButton}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="{StaticResource VayuTextDimBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Resource Packs">
                                        <Setter Property="Foreground" Value="#38BDF8"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,2.5"/>
                                        <Setter Property="BorderBrush" Value="#38BDF8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Shader Packs" Command="{Binding SelectTabCommand}" CommandParameter="Shaders"
                            FontSize="13" FontWeight="Bold" Margin="0,0,12,0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource VayuDarkButton}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="{StaticResource VayuTextDimBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Shaders">
                                        <Setter Property="Foreground" Value="#38BDF8"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,2.5"/>
                                        <Setter Property="BorderBrush" Value="#38BDF8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Data Packs" Command="{Binding SelectTabCommand}" CommandParameter="Data Packs"
                            FontSize="13" FontWeight="Bold" Margin="0,0,12,0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource VayuDarkButton}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="{StaticResource VayuTextDimBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Data Packs">
                                        <Setter Property="Foreground" Value="#38BDF8"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,2.5"/>
                                        <Setter Property="BorderBrush" Value="#38BDF8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Action Toolbar: Create, Import & Folder -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding NewInstallationCommand}"
                            Style="{StaticResource VayuAccentButton}" Padding="16,8" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource VayuIconPlus}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="New Installation" FontSize="12.5" FontWeight="Black" Foreground="#FFFFFF"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ImportModpackCommand}"
                            Style="{StaticResource VayuDarkButton}" Padding="13,8" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource VayuIconDownload}" Fill="#94A3B8" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Import (.mrpack)" FontSize="12" Foreground="#CBD5E1"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding OpenGameDirectoryCommand}"
                            Style="{StaticResource VayuDarkButton}" Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource VayuIconFolder}" Fill="#94A3B8" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Game Folder" FontSize="12" Foreground="#CBD5E1"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- 2. GAME LIBRARY SEARCH & FILTER TOOLBAR                         -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <!-- Installations Filter Bar -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="Installations">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Box -->
                    <Border Grid.Column="0" Background="#0C1322" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,14,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource VayuIconSearch}" Fill="#64748B" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding LibrarySearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontFamily="{StaticResource VayuFontFamily}" FontSize="12.5"
                                     VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Filter Chips (Loaders & Favorites) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="FILTER:" FontSize="10.5" FontWeight="Black" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ItemsControl ItemsSource="{Binding LibraryLoaders}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Content="{Binding}" 
                                                 GroupName="LibraryLoaderFilters"
                                                 FontSize="11" FontWeight="Bold" Margin="0,0,6,0"
                                                 Cursor="Hand">
                                        <RadioButton.Style>
                                            <Style TargetType="RadioButton">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="RadioButton">
                                                            <Border x:Name="ChipBorder" Background="#0C1322" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Padding="10,4">
                                                                <TextBlock Text="{TemplateBinding Content}" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="ChipBorder" Property="Background" Value="#1E3A8A"/>
                                                                    <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#38BDF8"/>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#2563EB"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </RadioButton.Style>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Sort Dropdown -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="SORT:" FontSize="10.5" FontWeight="Black" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding LibrarySortOptions}" SelectedItem="{Binding LibrarySortBy}"
                                  Style="{StaticResource VayuComboBox}" Width="130" Height="30"/>
                    </StackPanel>
                </Grid>

                <!-- Project Hub (Modpacks / Addons) Search Bar -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="Installations">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#0C1322" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource VayuIconSearch}" Fill="#64748B" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontFamily="{StaticResource VayuFontFamily}" FontSize="12.5"
                                     VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Button Grid.Column="1" Content="Search Modrinth" Command="{Binding SearchModrinthCommand}"
                            Style="{StaticResource VayuDarkButton}" Padding="16,7"/>
                </Grid>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- 3. MAIN GAME LIBRARY CONTENT GRID                               -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="2">
                <!-- ─── TAB: INSTALLATIONS (PREMIUM GAME LIBRARY CARDS GRID) ─── -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource VayuScrollViewer}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="Installations">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <StackPanel>
                        <!-- Empty State -->
                        <Border Visibility="{Binding HasInstallations, Converter={StaticResource InverseBoolToVis}}"
                                CornerRadius="12" Background="#0C1322" BorderBrush="#1E293B" BorderThickness="1"
                                Padding="40,40" Margin="0,20,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{StaticResource VayuIconInstances}" Fill="#38BDF8" Width="44" Height="44" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                <TextBlock Text="Game Library is Empty" FontSize="18" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                <TextBlock Text="Create your first isolated Minecraft installation or explore popular modpacks." FontSize="13" Foreground="#94A3B8" Margin="0,6,0,24" HorizontalAlignment="Center"/>
                                <Button Style="{StaticResource VayuAccentButton}" Padding="20,10" Command="{Binding NewInstallationCommand}" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource VayuIconPlus}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Create New Installation" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Responsive Game Library Cards Grid -->
                        <ItemsControl ItemsSource="{Binding FilteredInstallations}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="310" Height="360" Margin="0,0,16,20" CornerRadius="14" 
                                            Background="#0C1322" BorderThickness="1.5"
                                            ClipToBounds="True">
                                        <!-- Active vs Regular Border Style -->
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="#1E293B"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#38BDF8"/>
                                                        <Setter Property="Background" Value="#0F1B30"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="140"/> <!-- Header Artwork -->
                                                <RowDefinition Height="*"/>   <!-- Content & Specs -->
                                                <RowDefinition Height="Auto"/><!-- Actions Footer -->
                                            </Grid.RowDefinitions>

                                            <!-- 1. Cinematic Artwork Header -->
                                            <Grid Grid.Row="0">
                                                <Image Source="{Binding BannerArtwork}" Stretch="UniformToFill" 
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <!-- Dark gradient fade down into card body -->
                                                <Rectangle>
                                                    <Rectangle.Fill>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#20000000" Offset="0.0"/>
                                                            <GradientStop Color="#A00C1322" Offset="0.6"/>
                                                            <GradientStop Color="#FF0C1322" Offset="1.0"/>
                                                        </LinearGradientBrush>
                                                    </Rectangle.Fill>
                                                </Rectangle>

                                                <!-- Top Badge: Loader Pill -->
                                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,12,0,0"
                                                        CornerRadius="6" Background="#CC070B14" BorderBrush="{Binding LoaderAccentColor}" BorderThickness="1"
                                                        Padding="8,3">
                                                    <TextBlock Text="{Binding LoaderBadgeText}" FontSize="10.5" FontWeight="Black" Foreground="{Binding LoaderAccentColor}"/>
                                                </Border>

                                                <!-- Top Right: Active Badge or Favorite Star -->
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0">
                                                    <!-- Active Checkmark Badge -->
                                                    <Border Background="#2563EB" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,6,0"
                                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="✓ ACTIVE" FontSize="10" FontWeight="Black" Foreground="#FFFFFF"/>
                                                    </Border>

                                                    <!-- Favorite Star Button -->
                                                    <Button Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Background="#CC070B14" BorderBrush="#1E293B" BorderThickness="1" Width="26" Height="26" Cursor="Hand">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border CornerRadius="13" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                                                    <TextBlock Text="★" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="#64748B"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <!-- 2. Instance Metadata & Specs -->
                                            <StackPanel Grid.Row="1" Margin="14,8,14,10">
                                                <!-- Instance Name -->
                                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Black" Foreground="#FFFFFF" 
                                                           TextTrimming="CharacterEllipsis" Margin="0,0,0,3"/>

                                                <!-- Subtitle: Minecraft Version + Loader -->
                                                <TextBlock Text="{Binding DisplaySubtitle, StringFormat='Minecraft {0}'}" 
                                                           FontSize="12" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10"/>

                                                <!-- Specs Grid (RAM, Mods, Profile, Last Played) -->
                                                <Border Background="#070B14" BorderBrush="#162238" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- RAM Spec -->
                                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,6">
                                                            <TextBlock Text="💾 " FontSize="10.5"/>
                                                            <TextBlock Text="{Binding DisplayRam}" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0"/>
                                                        </StackPanel>

                                                        <!-- Mod Count Spec -->
                                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                                                            <TextBlock Text="🧩 " FontSize="10.5"/>
                                                            <TextBlock Text="{Binding DisplayModCount}" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0"/>
                                                        </StackPanel>

                                                        <!-- Profile Spec -->
                                                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                                                            <TextBlock Text="⚡ " FontSize="10.5"/>
                                                            <TextBlock Text="{Binding PerformanceProfile}" FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
                                                        </StackPanel>

                                                        <!-- Last Played -->
                                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                                            <TextBlock Text="🕒 " FontSize="10.5"/>
                                                            <TextBlock Text="{Binding DisplayLastPlayed}" FontSize="10.5" Foreground="#94A3B8"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>

                                            <!-- 3. Action Buttons Footer -->
                                            <Border Grid.Row="2" Background="#080E1A" BorderBrush="#162238" BorderThickness="0,1,0,0" Padding="12,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Play / Select CTA -->
                                                    <Button Grid.Column="0" 
                                                            Command="{Binding DataContext.PlayInstanceDirectlyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Cursor="Hand" Margin="0,0,8,0">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="PlayBtnBorder" CornerRadius="8" Background="#1E3A8A" BorderBrush="#2563EB" BorderThickness="1" Padding="12,7">
                                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                                    <Path Data="{StaticResource VayuIconPlay}" Fill="#FFFFFF" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                                    <TextBlock x:Name="PlayBtnText" Text="SELECT &amp; PLAY" FontSize="11.5" FontWeight="Black" Foreground="#FFFFFF"/>
                                                                                </StackPanel>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                    <Setter TargetName="PlayBtnBorder" Property="Background" Value="#2563EB"/>
                                                                                    <Setter TargetName="PlayBtnBorder" Property="BorderBrush" Value="#38BDF8"/>
                                                                                    <Setter TargetName="PlayBtnText" Property="Text" Value="PLAY NOW"/>
                                                                                </DataTrigger>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="PlayBtnBorder" Property="Background" Value="#38BDF8"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>

                                                    <!-- Tool Icons: Inspect, Edit, Folder, Delete -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <!-- Inspect Specs -->
                                                        <Button Command="{Binding DataContext.InspectInstanceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource VayuDarkButton}" Width="30" Height="30" Padding="0" Margin="0,0,4,0" ToolTip="Inspect Instance Specs">
                                                            <Path Data="{StaticResource VayuIconSearch}" Fill="#94A3B8" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center"/>
                                                        </Button>

                                                        <!-- Edit Specs -->
                                                        <Button Command="{Binding DataContext.EditInstanceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource VayuDarkButton}" Width="30" Height="30" Padding="0" Margin="0,0,4,0" ToolTip="Edit Installation">
                                                            <Path Data="{StaticResource VayuIconSettings}" Fill="#94A3B8" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center"/>
                                                        </Button>

                                                        <!-- Open Folder -->
                                                        <Button Command="{Binding DataContext.OpenInstanceFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource VayuDarkButton}" Width="30" Height="30" Padding="0" Margin="0,0,4,0" ToolTip="Open Game Folder">
                                                            <Path Data="{StaticResource VayuIconFolder}" Fill="#94A3B8" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center"/>
                                                        </Button>

                                                        <!-- Delete Instance -->
                                                        <Button Command="{Binding DataContext.DeleteInstanceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource VayuDarkButton}" Width="30" Height="30" Padding="0" ToolTip="Delete Instance">
                                                            <Path Data="{StaticResource VayuIconClose}" Fill="#EF4444" Width="9" Height="9" Stretch="Uniform" HorizontalAlignment="Center"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ─── TAB: MODPACKS & ADD-ONS (MODRINTH EXPLORER) ─── -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="Installations">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource VayuScrollViewer}">
                        <StackPanel Margin="0,0,0,20">
                            <!-- Modrinth Search Results -->
                            <ItemsControl ItemsSource="{Binding ModrinthProjects}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,12" Padding="16,14" CornerRadius="10" Background="#0C1322" BorderBrush="#1E293B" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Project Icon -->
                                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="8" Background="#162238" Margin="0,0,16,0" ClipToBounds="True">
                                                    <Image Source="{Binding IconUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Border>

                                                <!-- Info -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Black" Foreground="#FFFFFF" Margin="0,0,8,0"/>
                                                        <Border Background="#1E3A8A" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ProjectType}" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding Downloads, StringFormat='⬇ {0:N0} downloads • Author: '}" FontSize="11" Foreground="#64748B"/>
                                                </StackPanel>

                                                <!-- Install Action Button -->
                                                <Button Grid.Column="2" Content="Install" 
                                                        Command="{Binding DataContext.OpenModpackModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource VayuAccentButton}" Padding="16,8" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- 4. INSTANCE INSPECT MODAL DRAWER                                -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Visibility="{Binding IsInspectOpen, Converter={StaticResource BoolToVis}}" Background="#B0000000">
            <Border Width="480" MaxHeight="600" Background="#0C1322" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="14" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <!-- Modal Header -->
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="Instance Specifications" FontSize="17" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        <Button Command="{Binding CloseInspectCommand}" Style="{StaticResource VayuDarkButton}" Width="28" Height="28" Padding="0" HorizontalAlignment="Right">
                            <Path Data="{StaticResource VayuIconClose}" Fill="#94A3B8" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- Details Box -->
                    <Border Background="#070B14" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding InspectingInstance.Name}" FontSize="16" FontWeight="Black" Foreground="#38BDF8" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding InspectingInstance.DisplaySubtitle, StringFormat='Loader: {0}'}" FontSize="12.5" FontWeight="Bold" Foreground="#E2E8F0" Margin="0,0,0,10"/>
                            
                            <TextBlock Text="Allocated Memory:" FontSize="11" Foreground="#64748B"/>
                            <TextBlock Text="{Binding InspectingInstance.DisplayRam}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8"/>

                            <TextBlock Text="Performance Profile:" FontSize="11" Foreground="#64748B"/>
                            <TextBlock Text="{Binding InspectingInstance.PerformanceProfile}" FontSize="12" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,8"/>

                            <TextBlock Text="Installed Mods Count:" FontSize="11" Foreground="#64748B"/>
                            <TextBlock Text="{Binding InspectingInstance.DisplayModCount}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8"/>

                            <TextBlock Text="Game Directory:" FontSize="11" Foreground="#64748B"/>
                            <TextBlock Text="{Binding InspectingInstance.GameDirectory}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        </StackPanel>
                    </Border>

                    <!-- Close Button -->
                    <Button Content="Close" Command="{Binding CloseInspectCommand}" Style="{StaticResource VayuAccentButton}" Padding="16,8" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- 5. EDIT INSTANCE MODAL                                          -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Visibility="{Binding IsEditModalOpen, Converter={StaticResource BoolToVis}}" Background="#B0000000">
            <Border Width="480" Background="#0C1322" BorderBrush="#2563EB" BorderThickness="1.5" CornerRadius="14" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Edit Installation Configuration" FontSize="17" FontWeight="Black" Foreground="#FFFFFF" Margin="0,0,0,16"/>

                    <TextBlock Text="INSTALLATION NAME" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <Border Background="#070B14" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,12">
                        <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="12.5"/>
                    </Border>

                    <TextBlock Text="MINECRAFT VERSION" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding ModpackVersions}" SelectedItem="{Binding EditVersion}" Style="{StaticResource VayuComboBox}" Margin="0,0,0,12"/>

                    <TextBlock Text="MOD LOADER" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding ModpackLoaders}" SelectedItem="{Binding EditLoader}" Style="{StaticResource VayuComboBox}" Margin="0,0,0,12"/>

                    <TextBlock Text="{Binding EditRamMB, StringFormat='ALLOCATED RAM: {0} MB'}" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <Slider Minimum="2048" Maximum="16384" SmallChange="1024" LargeChange="2048" TickFrequency="1024" IsSnapToTickEnabled="True"
                            Value="{Binding EditRamMB}" Margin="0,0,0,16"/>

                    <!-- Modal Actions -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CancelEditCommand}" Style="{StaticResource VayuDarkButton}" Padding="16,8" Margin="0,0,8,0"/>
                        <Button Content="Save Changes" Command="{Binding SaveInstanceEditCommand}" Style="{StaticResource VayuAccentButton}" Padding="18,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
