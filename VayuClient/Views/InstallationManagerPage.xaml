<UserControl x:Class="VayuClient.Views.InstallationManagerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="#070B14">

    <Grid>
        <!-- ═══ AMBIENT CYBER NETHER BACKGROUND ═══ -->
        <Image Source="/Assets/Images/bg_cyber_nether.jpg" 
               Stretch="UniformToFill" 
               HorizontalAlignment="Center" 
               VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality"
               Opacity="0.38"/>

        <!-- Dark Gradient Overlay for Maximum Readability -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#CC070B14" Offset="0.0"/>
                    <GradientStop Color="#E6070B14" Offset="0.6"/>
                    <GradientStop Color="#F8070B14" Offset="1.0"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Margin="28,20,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ═══ TOP TABS & ACTIONS ═══ -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation Subtabs -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Installations" Command="{Binding SelectTabCommand}" CommandParameter="Installations"
                        FontSize="13" FontWeight="Bold" Margin="0,0,14,0" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource VayuDarkButton}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Foreground" Value="{StaticResource VayuTextDimBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="Installations">
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                    <Setter Property="BorderBrush" Value="#2563EB"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="Modpacks" Command="{Binding SelectTabCommand}" CommandParameter="Modpacks"
                        FontSize="13" FontWeight="Bold" Margin="0,0,14,0" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource VayuDarkButton}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Foreground" Value="{StaticResource VayuTextDimBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="Modpacks">
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                    <Setter Property="BorderBrush" Value="#2563EB"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="Mods" Command="{Binding SelectTabCommand}" CommandParameter="Mods"
                        FontSize="13" FontWeight="Bold" Margin="0,0,14,0" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource VayuDarkButton}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Foreground" Value="{StaticResource VayuTextDimBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="Mods">
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                    <Setter Property="BorderBrush" Value="#2563EB"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="Resource Packs" Command="{Binding SelectTabCommand}" CommandParameter="Resource Packs"
                        FontSize="13" FontWeight="Bold" Margin="0,0,14,0" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource VayuDarkButton}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Foreground" Value="{StaticResource VayuTextDimBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="Resource Packs">
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                    <Setter Property="BorderBrush" Value="#2563EB"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="Shaders" Command="{Binding SelectTabCommand}" CommandParameter="Shaders"
                        FontSize="13" FontWeight="Bold" Margin="0,0,14,0" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource VayuDarkButton}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Foreground" Value="{StaticResource VayuTextDimBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="Shaders">
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                    <Setter Property="BorderBrush" Value="#2563EB"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <!-- Actions: Create Instance, Import & Folder -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="+ New Installation" Command="{Binding NewInstallationCommand}"
                        Style="{StaticResource VayuAccentButton}" Padding="16,7" Margin="0,0,8,0"/>
                <Button Content="Import (.mrpack / .zip)" Command="{Binding ImportModpackCommand}"
                        Style="{StaticResource VayuDarkButton}" Padding="14,7" Margin="0,0,8,0"/>
                <Button Content="Open Game Folder" Command="{Binding OpenGameDirectoryCommand}"
                        Style="{StaticResource VayuDarkButton}" Padding="14,7"/>
            </StackPanel>
        </Grid>

        <!-- ═══ SEARCH & FILTER BAR (Visible on project tabs) ═══ -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActiveTab}" Value="Installations">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search Input -->
            <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Data="{StaticResource VayuIconSearch}" Fill="#94A3B8" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontFamily="{StaticResource VayuFontFamily}" FontSize="12"
                             VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Search Filter Bar Right -->
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Filter loader combo -->
                <ComboBox Grid.Column="0" ItemsSource="{Binding ModLoaders}" SelectedItem="{Binding SelectedLoaderFilter}"
                          Width="130" Margin="0,0,8,0" Style="{StaticResource VayuComboBox}"/>

                <Button Grid.Column="1" Content="Search" Command="{Binding SearchModrinthCommand}"
                        Style="{StaticResource VayuDarkButton}" Padding="16,6"/>
            </Grid>
        </Grid>

        <!-- ═══ MAIN CONTENT AREA ═══ -->
        <Grid Grid.Row="2">
            <!-- ─── 1. INSTALLATIONS TAB ─── -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTab}" Value="Installations">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>

                <StackPanel>
                    <!-- Empty State for Installations -->
                    <Border Visibility="{Binding HasInstallations, Converter={StaticResource InverseBoolToVis}}"
                            CornerRadius="8" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1"
                            Padding="36,32" Margin="0,10,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{StaticResource VayuIconInstances}" Fill="{StaticResource VayuTextMutedBrush}" Width="36" Height="36" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                            <TextBlock Text="No Minecraft installations found" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                            <TextBlock Text="Create your first isolated Minecraft instance or explore modpacks to get started." FontSize="12.5" Foreground="{StaticResource VayuTextDimBrush}" Margin="0,4,0,20" HorizontalAlignment="Center"/>
                            <Button Style="{StaticResource VayuAccentButton}" Padding="18,9" Command="{Binding NewInstallationCommand}" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource VayuIconPlus}" Fill="#FFFFFF" Width="11" Height="11" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Create New Instance" FontSize="12.5" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Installations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Padding="16,14" CornerRadius="8" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Vector Icon -->
                                    <Border Grid.Column="0" Width="40" Height="40" Background="#152033" CornerRadius="6" Margin="0,0,14,0">
                                        <Path Data="{StaticResource VayuIconInstances}" Fill="{StaticResource VayuBrightBlueBrush}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Text & Status Badge -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,8,0"/>
                                            <Border Background="#1D4ED8" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,6,0"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="ACTIVE" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding DisplaySubtitle}" FontSize="11.5" Foreground="{StaticResource VayuTextDimBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <!-- Actions: Select, Folder, Edit, Delete -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Play/Select Button -->
                                        <Button Content="Select" 
                                                Command="{Binding DataContext.SelectInstallationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource VayuAccentButton}" Padding="12,5" Margin="0,0,6,0"
                                                ToolTip="Set as active Minecraft instance"/>

                                        <!-- Open Folder Button -->
                                        <Button Command="{Binding DataContext.OpenInstanceFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource VayuDarkButton}" Padding="10,5" Margin="0,0,6,0"
                                                ToolTip="Open instance directory in File Explorer">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource VayuIconFolder}" Fill="#94A3B8" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Folder" FontSize="11"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Edit Button -->
                                        <Button Command="{Binding DataContext.EditInstanceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource VayuDarkButton}" Padding="10,5" Margin="0,0,6,0"
                                                ToolTip="Edit instance configuration &amp; RAM">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource VayuIconEdit}" Fill="#94A3B8" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Edit" FontSize="11"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Delete Button -->
                                        <Button Command="{Binding DataContext.DeleteInstanceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource VayuDangerButton}" Padding="10,5"
                                                ToolTip="Delete this instance">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource VayuIconTrash}" Fill="#EF4444" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Delete" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

            <!-- ─── 2. MODRINTH PROJECTS TAB (Modpacks, Mods, Shaders, Resource Packs) ─── -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTab}" Value="Installations">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- ─── HORIZONTAL FEATURED CAROUSEL SHELF ─── -->
                        <Border Margin="0,0,0,16" Padding="14,12" CornerRadius="8" Background="#0C1322" BorderBrush="#1E293B" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⭐ FEATURED &amp; POPULAR DISCOVERIES" FontSize="11.5" FontWeight="Black" Foreground="{StaticResource VayuBrightBlueBrush}"/>
                                        <TextBlock Text=" — Quick 1-Click Install" FontSize="11" Foreground="{StaticResource VayuTextMutedBrush}" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Style="{StaticResource VayuScrollViewer}">
                                    <ItemsControl ItemsSource="{Binding ModrinthProjects}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="220" Margin="0,0,12,6" Padding="12" CornerRadius="6" Background="#111A2C" BorderBrush="#1E293B" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <Border Grid.Row="0" Height="80" CornerRadius="4" Background="#152033" Margin="0,0,0,8" ClipToBounds="True">
                                                            <Grid>
                                                                <Image Source="{Binding IconUrl, Converter={StaticResource WebImage}}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                <Border VerticalAlignment="Bottom" Background="#D9070B14" Padding="6,2">
                                                                    <TextBlock Text="{Binding DownloadsDisplay}" FontSize="9.5" FontWeight="Bold" Foreground="#22C55E"/>
                                                                </Border>
                                                            </Grid>
                                                        </Border>

                                                        <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>
                                                        <TextBlock Grid.Row="2" Text="{Binding Description}" FontSize="10.5" Foreground="{StaticResource VayuTextDimBrush}" TextTrimming="CharacterEllipsis" MaxHeight="28" Margin="0,0,0,8"/>

                                                        <Button Grid.Row="3" Content="Install" 
                                                                Command="{Binding DataContext.InstallProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource VayuAccentButton}" Padding="10,5" HorizontalAlignment="Stretch"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="ALL PROJECTS (PAGE CATALOG)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource VayuTextDimBrush}" Margin="0,0,0,10"/>

                        <ItemsControl ItemsSource="{Binding ModrinthProjects}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="14,12" CornerRadius="6" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Modrinth Real Project Image / Icon -->
                                        <Border Grid.Column="0" Width="44" Height="44" Background="#152033" BorderBrush="#243247" BorderThickness="1" CornerRadius="6" Margin="0,0,14,0" ClipToBounds="True">
                                            <Grid>
                                                <!-- Web Image -->
                                                <Image Source="{Binding IconUrl, Converter={StaticResource WebImage}}" Width="44" Height="44" Stretch="UniformToFill" 
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                
                                                <!-- Fallback Icon if project has no icon_url -->
                                                <Border Background="#152033" Visibility="{Binding HasIconUrl, Converter={StaticResource InverseBoolToVis}}">
                                                    <Path Data="{StaticResource VayuIconMods}" Fill="#22C55E" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Title, Author & Description -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,8,0"/>
                                                <Border Background="#10251C" CornerRadius="3" Padding="6,1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding DownloadsDisplay}" FontSize="10" FontWeight="SemiBold" Foreground="#22C55E"/>
                                                </Border>
                                                <TextBlock Text="{Binding Author, StringFormat='by {0}'}" FontSize="11" Foreground="{StaticResource VayuTextMutedBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{StaticResource VayuTextDimBrush}" TextWrapping="Wrap" MaxHeight="34"/>
                                        </StackPanel>

                                        <!-- Install / Add Button -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0">
                                            <Button Content="Get Project" 
                                                    Command="{Binding DataContext.InstallProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource VayuAccentButton}" Padding="16,7"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Modrinth Pagination Footer Bar -->
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Summary -->
                    <TextBlock Grid.Column="0" Text="{Binding PaginationSummary}" 
                               FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource VayuTextMutedBrush}" VerticalAlignment="Center"/>

                    <!-- Pagination Navigation -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Prev Page -->
                        <Button Style="{StaticResource VayuDarkButton}" Padding="12,5" Margin="0,0,6,0"
                                Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoPrevious}" ToolTip="Previous 10 projects">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="‹" FontSize="14" FontWeight="Bold" Margin="0,-2,4,0"/>
                                <TextBlock Text="Prev" FontSize="11.5"/>
                            </StackPanel>
                        </Button>

                        <!-- Page Number Direct Selector Pills -->
                        <ItemsControl ItemsSource="{Binding PageNumbers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" 
                                            Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource VayuDarkButton}" Padding="10,5" Margin="2,0" FontSize="11.5" FontWeight="Bold"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Next Page -->
                        <Button Style="{StaticResource VayuDarkButton}" Padding="12,5" Margin="6,0,0,0"
                                Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}" ToolTip="Next 10 projects">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Next" FontSize="11.5"/>
                                <TextBlock Text="›" FontSize="14" FontWeight="Bold" Margin="4,-2,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- ═══ MODAL 1: MODPACK INSTALLATION CONFIGURATION MODAL ═════════ -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.RowSpan="3" Margin="-24,-16,-24,-20"
              Visibility="{Binding IsModpackModalOpen, Converter={StaticResource BoolToVis}}"
              Background="#E0070B14">
            <Border Width="480" CornerRadius="8" 
                    Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1"
                    Padding="24,20" HorizontalAlignment="Center" VerticalAlignment="Center">

                <StackPanel>
                    <!-- Modal Header -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Install Modpack" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="{Binding PendingModpack.Title, StringFormat='Configuring instance for {0}'}" 
                                       FontSize="11.5" Foreground="{StaticResource VayuTextDimBrush}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1" Command="{Binding CancelModpackInstallCommand}"
                                Content="✕" FontSize="12" FontWeight="Bold"
                                Style="{StaticResource VayuDarkButton}" Width="28" Height="28" Padding="0"
                                Cursor="Hand" VerticalAlignment="Top"/>
                    </Grid>

                    <!-- Modpack Details Badge -->
                    <Border CornerRadius="6" Background="#152033" BorderBrush="#243247" BorderThickness="1" Padding="12,10" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="4" Background="#0F172A" Margin="0,0,10,0" ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding PendingModpack.IconUrl, Converter={StaticResource WebImage}}" Width="36" Height="36" Stretch="UniformToFill" 
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <Border Background="#0F172A" Visibility="{Binding PendingModpack.HasIconUrl, Converter={StaticResource InverseBoolToVis}}">
                                        <Path Data="{StaticResource VayuIconMods}" Fill="#22C55E" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PendingModpack.Title}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="{Binding PendingModpack.Author, StringFormat='Created by {0}'}" FontSize="11" Foreground="{StaticResource VayuTextMutedBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Field 1: Instance Name -->
                    <TextBlock Text="INSTANCE NAME" FontSize="11" FontWeight="Bold" Foreground="{StaticResource VayuTextDimBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding ModpackInstanceName, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource VayuGlassTextBox}" Height="36" Margin="0,0,0,12"/>

                    <!-- Field 2 & 3: Mod Loader & Minecraft Version -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Loader -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="MOD LOADER" FontSize="11" FontWeight="Bold" Foreground="{StaticResource VayuTextDimBrush}" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding ModpackLoaders}" 
                                      SelectedItem="{Binding SelectedModpackLoader}"
                                      Style="{StaticResource VayuComboBox}" Height="36"/>
                        </StackPanel>

                        <!-- Version -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="GAME VERSION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource VayuTextDimBrush}" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding ModpackVersions}" 
                                      SelectedItem="{Binding SelectedModpackVersion}"
                                      Style="{StaticResource VayuComboBox}" Height="36"/>
                        </StackPanel>
                    </Grid>

                    <!-- Actions: Cancel / Install -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Cancel" Command="{Binding CancelModpackInstallCommand}"
                                Style="{StaticResource VayuDarkButton}" Padding="14,7" Margin="0,0,8,0"/>
                        <Button Content="Create &amp; Install" Command="{Binding ConfirmModpackInstallCommand}"
                                Style="{StaticResource VayuAccentButton}" Padding="16,7"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- ═══ MODAL 2: EDIT INSTANCE CONFIGURATION MODAL ════════════════ -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.RowSpan="3" Margin="-24,-16,-24,-20"
              Visibility="{Binding IsEditModalOpen, Converter={StaticResource BoolToVis}}"
              Background="#E00B1220">
            <Border Width="480" CornerRadius="6" 
                    Background="#151F32" BorderBrush="#243247" BorderThickness="1"
                    Padding="24,20" HorizontalAlignment="Center" VerticalAlignment="Center">

                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Edit Instance Configuration" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <Button Grid.Column="1" Command="{Binding CancelEditCommand}"
                                Content="✕" FontSize="12" FontWeight="Bold"
                                Style="{StaticResource VayuDarkButton}" Width="28" Height="28" Padding="0"
                                Cursor="Hand" VerticalAlignment="Top"/>
                    </Grid>

                    <TextBlock Text="INSTANCE NAME" FontSize="11" FontWeight="Bold" Foreground="{StaticResource VayuTextDimBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource VayuGlassTextBox}" Height="36" Margin="0,0,0,12"/>

                    <TextBlock Text="{Binding EditRamMB, StringFormat='ALLOCATED RAM: {0} MB'}" 
                               FontSize="11" FontWeight="Bold" Foreground="{StaticResource VayuTextDimBrush}" Margin="0,0,0,6"/>
                    <Slider Value="{Binding EditRamMB}" Minimum="1024" Maximum="16384" SmallChange="512" LargeChange="1024"
                            Style="{StaticResource VayuGlassSlider}" Margin="0,0,0,16"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CancelEditCommand}"
                                Style="{StaticResource VayuDarkButton}" Padding="14,7" Margin="0,0,8,0"/>
                        <Button Content="Save Changes" Command="{Binding SaveInstanceEditCommand}"
                                Style="{StaticResource VayuAccentButton}" Padding="16,7"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- ═══ MODAL 3: TARGET INSTANCE SELECTOR (Mods/Shaders/Packs) ═══ -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.RowSpan="3" Margin="-24,-16,-24,-20"
              Visibility="{Binding IsTargetInstanceModalOpen, Converter={StaticResource BoolToVis}}"
              Background="#E5070B14">
            <Border Width="500" CornerRadius="8" 
                    Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1"
                    Padding="24,20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <!-- Modal Header -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding TargetContentType, StringFormat='Install {0}'}" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="{Binding PendingContentProject.Title, StringFormat='Choose target instance for {0}'}" 
                                       FontSize="11.5" Foreground="{StaticResource VayuTextDimBrush}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1" Command="{Binding CancelContentInstallCommand}"
                                Content="✕" FontSize="12" FontWeight="Bold"
                                Style="{StaticResource VayuDarkButton}" Width="28" Height="28" Padding="0"
                                Cursor="Hand" VerticalAlignment="Top"/>
                    </Grid>

                    <!-- Project Summary Card with Logo -->
                    <Border CornerRadius="6" Background="#141E33" BorderBrush="#1E293B" BorderThickness="1" Padding="12" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="6" Background="#1B2638" Margin="0,0,12,0" ClipToBounds="True">
                                <Image Source="{Binding PendingContentProject.IconUrl, Converter={StaticResource WebImage}}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PendingContentProject.Title}" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="{Binding PendingContentProject.Author, StringFormat='by {0}'}" FontSize="11" Foreground="{StaticResource VayuTextMutedBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Target Instance Selection -->
                    <TextBlock Text="SELECT DESTINATION INSTANCE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource VayuTextDimBrush}" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding Installations}"
                              SelectedItem="{Binding SelectedTargetInstance}"
                              Style="{StaticResource VayuComboBox}" Height="38" Margin="0,0,0,16">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="{Binding Loader, StringFormat=' ({0}'}" Foreground="{StaticResource VayuBrightBlueBrush}" Margin="6,0,0,0"/>
                                    <TextBlock Text="{Binding MinecraftVersion, StringFormat=' {0})'}" Foreground="{StaticResource VayuTextDimBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CancelContentInstallCommand}"
                                Style="{StaticResource VayuDarkButton}" Padding="14,7" Margin="0,0,8,0"/>
                        <Button Content="Install to Instance" Command="{Binding ConfirmContentInstallCommand}"
                                Style="{StaticResource VayuAccentButton}" Padding="18,7"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Grid>
</UserControl>
