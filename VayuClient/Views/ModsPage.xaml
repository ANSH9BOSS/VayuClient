<UserControl x:Class="VayuClient.Views.ModsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:VayuClient.Converters"
             Background="#070B14">

    <Grid>
        <!-- ═══ AMBIENT LUSH CAVES BACKGROUND ═══ -->
        <Image Source="/Assets/Images/bg_lush_caves.jpg" 
               Stretch="UniformToFill" 
               HorizontalAlignment="Center" 
               VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality"
               Opacity="0.25"/>

        <!-- Dark Gradient Overlay for Maximum Readability -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#D0070B14" Offset="0.0"/>
                    <GradientStop Color="#E6070B14" Offset="0.5"/>
                    <GradientStop Color="#FA070B14" Offset="1.0"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Margin="28,18,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header + Instance Selector Toolbar -->
                <RowDefinition Height="Auto"/> <!-- Categories & Filter Toolbar -->
                <RowDefinition Height="*"/>    <!-- Mods Grid / Empty State -->
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- 1. TOP HEADER & INSTANCE PICKER TOOLBAR                         -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <Path Data="{StaticResource VayuIconMods}" Fill="#38BDF8" Width="20" Height="20" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="MODS LIBRARY" FontSize="20" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        <Border Background="#1E3A8A" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding EnabledModCount, StringFormat='{}{0} ACTIVE'}" FontSize="10.5" FontWeight="Black" Foreground="#38BDF8"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Manage, toggle, and install optimizations, HUD widgets, and game expansions."
                               FontSize="12" Foreground="{StaticResource VayuTextDimBrush}"/>
                </StackPanel>

                <!-- Actions: Instance Picker, Open Folder, Browse, Add Mod -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Instance Dropdown Picker -->
                    <Border CornerRadius="8" Background="#0C1322" BorderBrush="#1E293B" BorderThickness="1" Padding="8,4" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="INSTANCE:" FontSize="10.5" FontWeight="Black" Foreground="#64748B" VerticalAlignment="Center" Margin="4,0,8,0"/>
                            <ComboBox ItemsSource="{Binding AvailableInstances}"
                                      SelectedItem="{Binding SelectedInstance}"
                                      Style="{StaticResource VayuComboBox}"
                                      Width="210" Height="30">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            <TextBlock Text="{Binding Loader, StringFormat=' ({0})'}" Foreground="#38BDF8" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource VayuDarkButton}" Padding="13,8" Margin="0,0,8,0"
                            Command="{Binding OpenModsFolderCommand}"
                            IsEnabled="{Binding HasSelectedInstance}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource VayuIconFolder}" Fill="#94A3B8" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Open Folder" FontSize="12" Foreground="#CBD5E1"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource VayuDarkButton}" Padding="13,8" Margin="0,0,8,0"
                            Command="{Binding BrowseModrinthCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource VayuIconSearch}" Fill="#38BDF8" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Get Mods" FontSize="12" Foreground="#38BDF8" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource VayuAccentButton}" Padding="16,8"
                            Command="{Binding AddModCommand}"
                            IsEnabled="{Binding HasSelectedInstance}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource VayuIconPlus}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Add .jar" FontSize="12" FontWeight="Black" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- 2. CATEGORY PILLS & SEARCH TOOLBAR                              -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <Border Grid.Column="0" Background="#0C1322" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,14,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource VayuIconSearch}" Fill="#64748B" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontFamily="{StaticResource VayuFontFamily}" FontSize="12.5"
                                 VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Category Filter Chips -->
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Style="{StaticResource VayuScrollViewer}" Margin="0,0,10,0">
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Content="{Binding}" 
                                             GroupName="ModCategoryFilters"
                                             FontSize="11" FontWeight="Bold" Margin="0,0,6,0"
                                             Cursor="Hand">
                                    <RadioButton.Style>
                                        <Style TargetType="RadioButton">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="RadioButton">
                                                        <Border x:Name="ChipBorder" Background="#0C1322" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Padding="10,4">
                                                            <TextBlock Text="{TemplateBinding Content}" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="ChipBorder" Property="Background" Value="#1E3A8A"/>
                                                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#38BDF8"/>
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#2563EB"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </RadioButton.Style>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Status Filter Dropdown -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="STATUS:" FontSize="10.5" FontWeight="Black" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}"
                              Style="{StaticResource VayuComboBox}" Width="110" Height="30"/>
                </StackPanel>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- 3. MODS CARDS GRID                                              -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="2">
                <!-- Empty State (No Mods Installed) -->
                <Border Visibility="{Binding HasMods, Converter={StaticResource InverseBoolToVis}}"
                        CornerRadius="12" Background="#0C1322" BorderBrush="#1E293B" BorderThickness="1"
                        Padding="40,40" Margin="0,10,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <Path Data="{StaticResource VayuIconMods}" Fill="#38BDF8" Width="44" Height="44" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <TextBlock Text="No Mods Found in Active Instance" FontSize="18" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                        <TextBlock Text="Enhance your gameplay with Sodium, Iris Shaders, AppleSkin, and performance mods." FontSize="13" Foreground="#94A3B8" Margin="0,6,0,24" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource VayuAccentButton}" Padding="18,9" Command="{Binding BrowseModrinthCommand}" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource VayuIconSearch}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Browse Modrinth Mods" FontSize="12.5" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource VayuDarkButton}" Padding="18,9" Command="{Binding AddModCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource VayuIconPlus}" Fill="#94A3B8" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Drop .jar File" FontSize="12.5" Foreground="#CBD5E1"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Responsive Mod Cards Grid -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource VayuScrollViewer}"
                              Visibility="{Binding HasMods, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Mods}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="315" Height="140" Margin="0,0,14,14" CornerRadius="10" 
                                        Background="#0C1322" BorderBrush="#1E293B" BorderThickness="1.5"
                                        Padding="14,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Mod Icon -->
                                        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Width="36" Height="36" CornerRadius="6" Background="#162238" VerticalAlignment="Top" ClipToBounds="True">
                                            <Image Source="{Binding IconPath}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>

                                        <!-- Mod Header & Category -->
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="Black" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <Border Background="#152238" CornerRadius="4" Padding="5,1.5" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Category}" FontSize="9.5" FontWeight="Black" Foreground="{Binding CategoryBadgeColor}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Version, StringFormat='v{0}'}" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Enable/Disable Switch -->
                                        <CheckBox Grid.Row="0" Grid.Column="2" IsChecked="{Binding IsEnabled}"
                                                  Command="{Binding DataContext.ToggleModCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"
                                                  Cursor="Hand" VerticalAlignment="Top" Style="{StaticResource VayuToggleSwitch}"/>

                                        <!-- Short Description -->
                                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Description}" 
                                                   FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" Margin="10,4,0,0" VerticalAlignment="Top"/>

                                        <!-- Footer: File Size & Delete Button -->
                                        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" BorderBrush="#162238" BorderThickness="0,1,0,0" Padding="0,6,0,0" Margin="0,4,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- File Size / Author Info -->
                                                <TextBlock Grid.Column="0" Text="{Binding FileSizeFormatted, StringFormat='Size: {0}'}" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center"/>

                                                <!-- Actions: Remove Mod -->
                                                <Button Grid.Column="1" Content="Remove" 
                                                        Command="{Binding DataContext.DeleteModCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource VayuDarkButton}" Padding="10,3" FontSize="10.5" Foreground="#EF4444"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
