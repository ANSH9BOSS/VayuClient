<UserControl x:Class="VayuClient.Views.ModsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:VayuClient.Converters"
             Background="#06070B">

    <UserControl.Resources>
        <ResourceDictionary>
            <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
            <converters:WebImageConverter x:Key="WebImage"/>
            <converters:EqualityMultiConverter x:Key="EqualityMultiConverter"/>

            <!-- 3D Tactile Cyber-Purple Toggle Switch for Mod Activation -->
            <Style x:Key="Vayu3DModToggleSwitch" TargetType="CheckBox">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Width="42" Height="22" Background="Transparent">
                                <Border x:Name="Track" Background="#0C0816" BorderBrush="#2A1E44" BorderThickness="1.2" CornerRadius="11">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.6"/>
                                    </Border.Effect>
                                    <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="#7E729B" HorizontalAlignment="Left" Margin="2,0,0,0">
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.5"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#7C3AED" Offset="0.0"/>
                                                <GradientStop Color="#9333EA" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="Track" Property="BorderBrush" Value="#C084FC"/>
                                    <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                                    <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                                    <Setter TargetName="Track" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#A855F7" BlurRadius="10" ShadowDepth="1" Opacity="0.55"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Track" Property="BorderBrush" Value="#A855F7"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 3D Category Filter Pill Radio Style -->
            <Style x:Key="Vayu3DCategoryPill" TargetType="RadioButton">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="ChipBorder" CornerRadius="12" Padding="12,5"
                                    Background="#0B0E18" BorderBrush="#251C3D" BorderThickness="1.2">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.4"/>
                                </Border.Effect>
                                <TextBlock x:Name="ChipText" Text="{TemplateBinding Content}" FontSize="11" FontWeight="Bold" Foreground="#948EA5"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="ChipBorder" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#7C3AED" Offset="0.0"/>
                                                <GradientStop Color="#9333EA" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#D8B4FE"/>
                                    <Setter TargetName="ChipText" Property="Foreground" Value="#FFFFFF"/>
                                    <Setter TargetName="ChipBorder" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#7C3AED" BlurRadius="12" ShadowDepth="1" Opacity="0.6"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#A855F7"/>
                                    <Setter TargetName="ChipText" Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!-- ═══ AMBIENT LUSH CAVES 3D BACKGROUND ═══ -->
        <Image Source="/Assets/Images/bg_lush_caves.jpg" 
               Stretch="UniformToFill" 
               HorizontalAlignment="Center" 
               VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality"
               Opacity="0.20"/>

        <!-- Deep Obsidian Atmospheric Gradient Overlay -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#D806070B" Offset="0.0"/>
                    <GradientStop Color="#EB06070B" Offset="0.55"/>
                    <GradientStop Color="#FA06070B" Offset="1.0"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Margin="28,20,28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header + Instance Selector Toolbar -->
                <RowDefinition Height="Auto"/> <!-- Categories & Filter Toolbar -->
                <RowDefinition Height="*"/>    <!-- Mods Grid / Empty State -->
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- 1. TOP HEADER & 3D INSTANCE PICKER TOOLBAR                      -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Width="32" Height="32" CornerRadius="8" Background="#161028" BorderBrush="#3B2A60" BorderThickness="1.2" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#7C3AED" BlurRadius="10" ShadowDepth="1" Opacity="0.4"/>
                            </Border.Effect>
                            <Path Data="{StaticResource VayuIconMods}" Fill="#C084FC" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="MODS LIBRARY" FontSize="20" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        <Border Background="#16102A" BorderBrush="#7C3AED" BorderThickness="1.2" CornerRadius="8" Padding="10,3" Margin="14,0,0,0" VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#7C3AED" BlurRadius="8" ShadowDepth="1" Opacity="0.35"/>
                            </Border.Effect>
                            <TextBlock Text="{Binding EnabledModCount, StringFormat='{}{0} ACTIVE'}" FontSize="11" FontWeight="Black" Foreground="#C084FC"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Manage, toggle, and install optimizations, HUD widgets, and game expansions."
                               FontSize="12" Foreground="{StaticResource VayuTextMutedBrush}"/>
                </StackPanel>

                <!-- Actions: Instance Picker, Open Folder, Browse, Add Mod -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 3D Instance Dropdown Picker Capsule -->
                    <Border CornerRadius="8" Background="#0C101D" BorderBrush="#251C3D" BorderThickness="1.2" Padding="8,4" Margin="0,0,10,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="1" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="INSTANCE:" FontSize="10.5" FontWeight="Black" Foreground="#7D7596" VerticalAlignment="Center" Margin="4,0,8,0"/>
                            <ComboBox ItemsSource="{Binding AvailableInstances}"
                                      SelectedItem="{Binding SelectedInstance}"
                                      Style="{StaticResource VayuComboBox}"
                                      Width="210" Height="30">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            <TextBlock Text="{Binding Loader, StringFormat=' ({0})'}" Foreground="#C084FC" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource Vayu3DButton}" Padding="13,8" Margin="0,0,8,0"
                            Command="{Binding OpenModsFolderCommand}"
                            IsEnabled="{Binding HasSelectedInstance}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource VayuIconFolder}" Fill="#948EA5" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Open Folder" FontSize="12" Foreground="#CBD5E1"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource Vayu3DButton}" Padding="13,8" Margin="0,0,8,0"
                            Command="{Binding ConvertInstanceCommand}"
                            IsEnabled="{Binding HasSelectedInstance}"
                            ToolTip="Convert this instance's modpack to another Minecraft version">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Convert Version" FontSize="12" Foreground="#C084FC" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource Vayu3DButton}" Padding="13,8" Margin="0,0,8,0"
                            Command="{Binding BrowseModrinthCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource VayuIconSearch}" Fill="#C084FC" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Get Mods" FontSize="12" Foreground="#C084FC" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource Vayu3DPrimaryButton}" Padding="16,8"
                            Command="{Binding AddModCommand}"
                            IsEnabled="{Binding HasSelectedInstance}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource VayuIconPlus}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Add .jar" FontSize="12" FontWeight="Black" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- 2. CATEGORY PILLS & 3D SEARCH TOOLBAR                           -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="1" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 3D Recessed Search Box -->
                <Border Grid.Column="0" Background="#0C101D" BorderBrush="#251C3D" BorderThickness="1.2" CornerRadius="8" Padding="10,6" Margin="0,0,14,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.4"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource VayuIconSearch}" Fill="#7D7596" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontFamily="{StaticResource VayuFontFamily}" FontSize="12.5"
                                 VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 3D Category Filter Chips -->
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Style="{StaticResource VayuScrollViewer}" Margin="0,0,10,0">
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Content="{Binding}" 
                                             GroupName="ModCategoryFilters"
                                             Command="{Binding Path=DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             CommandParameter="{Binding}"
                                             Style="{StaticResource Vayu3DCategoryPill}"
                                             Margin="0,0,8,0">
                                    <RadioButton.IsChecked>
                                        <MultiBinding Converter="{StaticResource EqualityMultiConverter}" Mode="OneWay">
                                            <Binding Path="DataContext.SelectedCategory" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                            <Binding Path="."/>
                                        </MultiBinding>
                                    </RadioButton.IsChecked>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Status Filter Dropdown -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="STATUS:" FontSize="10.5" FontWeight="Black" Foreground="#7D7596" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}"
                              Style="{StaticResource VayuComboBox}" Width="115" Height="30"/>
                </StackPanel>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- 3. 3D MODS CARDS GRID                                           -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="2">
                <!-- 3D Empty State (No Mods Installed) -->
                <Border Visibility="{Binding HasMods, Converter={StaticResource InverseBoolToVis}}"
                        CornerRadius="14" Background="{StaticResource VayuCardGradient}" 
                        BorderBrush="{StaticResource Vayu3DBorderBrush}" BorderThickness="1.5"
                        Padding="40,48" Margin="0,10,0,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.5"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="64" Height="64" CornerRadius="16" Background="#161028" BorderBrush="#4C1D95" BorderThickness="1.5" Margin="0,0,0,18" HorizontalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#7C3AED" BlurRadius="16" ShadowDepth="2" Opacity="0.5"/>
                            </Border.Effect>
                            <Path Data="{StaticResource VayuIconMods}" Fill="#C084FC" Width="30" Height="30" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="No Mods Found in Active Instance" FontSize="18" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                        <TextBlock Text="Enhance your gameplay with Sodium, Iris Shaders, AppleSkin, and performance mods." FontSize="13" Foreground="#948EA5" Margin="0,6,0,24" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource Vayu3DPrimaryButton}" Padding="20,10" Command="{Binding BrowseModrinthCommand}" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource VayuIconSearch}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Browse Modrinth Mods" FontSize="12.5" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Vayu3DButton}" Padding="18,10" Command="{Binding AddModCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource VayuIconPlus}" Fill="#948EA5" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Drop .jar File" FontSize="12.5" Foreground="#CBD5E1"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Responsive 3D Mod Cards Grid -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource VayuScrollViewer}"
                              Visibility="{Binding HasMods, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Mods}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="318" Height="145" Margin="0,0,16,16" CornerRadius="10" 
                                        Background="{StaticResource VayuCardGradient}" 
                                        BorderBrush="{StaticResource Vayu3DBorderBrush}" BorderThickness="1.2"
                                        Padding="14,12">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.45"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 3D Mod Icon Frame -->
                                        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Width="38" Height="38" CornerRadius="8" Background="#161028" BorderBrush="#3B2A60" BorderThickness="1" VerticalAlignment="Top" ClipToBounds="True">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#7C3AED" BlurRadius="6" ShadowDepth="1" Opacity="0.3"/>
                                            </Border.Effect>
                                            <Image Source="{Binding IconPath, Converter={StaticResource WebImage}}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>

                                        <!-- Mod Header & Category -->
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="Black" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <Border Background="#16102A" BorderBrush="#3B2A60" BorderThickness="0.8" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Category}" FontSize="9.5" FontWeight="Black" Foreground="{Binding CategoryBadgeColor}"/>
                                                </Border>
                                                <Border Background="#0C0816" BorderBrush="{Binding CompatibilityColor}" BorderThickness="0.8" CornerRadius="4" Padding="5,1.5" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding CompatibilityText}" FontSize="8.5" FontWeight="Bold" Foreground="{Binding CompatibilityColor}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Version, StringFormat='v{0}'}" FontSize="10" Foreground="#7D7596" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 3D Enable/Disable Switch -->
                                        <CheckBox Grid.Row="0" Grid.Column="2" IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                  Command="{Binding DataContext.ToggleModCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"
                                                  Cursor="Hand" VerticalAlignment="Top" Style="{StaticResource Vayu3DModToggleSwitch}"/>

                                        <!-- Short Description -->
                                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Description}" 
                                                   FontSize="11" Foreground="#948EA5" TextTrimming="CharacterEllipsis" Margin="10,5,0,0" VerticalAlignment="Top"/>

                                        <!-- Footer: File Size & Delete Button -->
                                        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" BorderBrush="#1C152E" BorderThickness="0,1,0,0" Padding="0,7,0,0" Margin="0,4,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- File Size / Loader Info -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ModLoader}" FontSize="10" FontWeight="Bold" Foreground="#C084FC" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding FileSizeFormatted, StringFormat='Size: {0}'}" FontSize="10.5" Foreground="#7D7596"/>
                                                </StackPanel>

                                                <!-- Actions: Remove Mod -->
                                                <Button Grid.Column="1" Content="Remove" 
                                                        Command="{Binding DataContext.DeleteModCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource VayuDangerButton}" Padding="10,3" FontSize="10.5"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
