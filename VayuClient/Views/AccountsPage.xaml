<UserControl x:Class="VayuClient.Views.AccountsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:VayuClient.Converters"
             Background="#070B14">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <converters:SkinHeadImageConverter x:Key="SkinHeadImage"/>
        <converters:BoolToActiveBorderBrushConverter x:Key="BoolToActiveBorderBrush"/>
    </UserControl.Resources>

    <Grid>
        <!-- ═══ AMBIENT MOUNTAIN AURORA BACKGROUND ═══ -->
        <Image Source="/Assets/Images/bg_mountain_aurora.jpg" 
               Stretch="UniformToFill" 
               HorizontalAlignment="Center" 
               VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality"
               Opacity="0.38"/>

        <!-- Dark Gradient Overlay for Maximum Readability -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#CC070B14" Offset="0.0"/>
                    <GradientStop Color="#E6070B14" Offset="0.6"/>
                    <GradientStop Color="#F8070B14" Offset="1.0"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource VayuScrollViewer}">
            <StackPanel Margin="28,20,28,32">
                <!-- Header -->
                <StackPanel Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Path Data="{StaticResource VayuIconAccounts}" Fill="{StaticResource VayuBrightBlueBrush}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Accounts &amp; Profiles" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Manage Microsoft authentication and local offline player profiles"
                               FontSize="12" Foreground="{StaticResource VayuTextDimBrush}"/>
                </StackPanel>

                <!-- ═══ MICROSOFT ACCOUNTS CARD ═══ -->
                <Border CornerRadius="6" Background="{StaticResource VayuSurfaceBrush}" BorderBrush="{StaticResource VayuBorderBrush}" BorderThickness="1"
                        Padding="22,18" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="OFFICIAL AUTHENTICATION" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource VayuBrightBlueBrush}"/>
                                <TextBlock Text="Microsoft Account" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Sign In Button -->
                            <Button Grid.Column="1" Style="{StaticResource VayuAccentButton}" Padding="18,8" VerticalAlignment="Center"
                                    Visibility="{Binding IsLoggingInMicrosoft, Converter={StaticResource InverseBoolToVis}}"
                                    Command="{Binding SignInMicrosoftCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⊞" FontSize="14" FontWeight="Bold" Margin="0,0,6,0" Foreground="White" VerticalAlignment="Center"/>
                                    <TextBlock Text="Sign in with Microsoft" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock Text="Authenticate via Microsoft OAuth to access official multiplayer servers, custom skins, and realms."
                                   FontSize="12" Foreground="{StaticResource VayuTextDimBrush}" Margin="0,0,0,14"/>

                        <!-- Device Code Login Flow Panel -->
                        <Border Visibility="{Binding IsLoggingInMicrosoft, Converter={StaticResource BoolToVis}}"
                                CornerRadius="4" Background="#1B2638" BorderBrush="#2563EB" BorderThickness="1"
                                Padding="18,14" Margin="0,4,0,14">
                            <StackPanel>
                                <TextBlock Text="Microsoft Device Code Authentication" FontSize="13.5" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                                <TextBlock Text="Open https://microsoft.com/link in your browser and enter the verification code:"
                                           FontSize="12" Foreground="{StaticResource VayuTextDimBrush}" Margin="0,0,0,10"/>

                                <Border Background="#0F172A" CornerRadius="4" Padding="16,10" HorizontalAlignment="Left" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding MicrosoftUserCode}" FontSize="24" FontWeight="Bold"
                                                   Foreground="{StaticResource VayuBrightBlueBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        <Button Style="{StaticResource VayuDarkButton}" Padding="12,6" Command="{Binding CopyUserCodeCommand}" Margin="0,0,6,0">
                                             <TextBlock Text="Copy Code" FontSize="11.5"/>
                                        </Button>
                                        <Button Style="{StaticResource VayuDarkButton}" Padding="12,6" Command="{Binding OpenVerificationLinkCommand}">
                                            <TextBlock Text="Open Link" FontSize="11.5"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{Binding MicrosoftAuthStatus}" FontSize="11.5"
                                           Foreground="{StaticResource VayuBrightBlueBrush}" Margin="0,0,0,10"/>

                                <Button Style="{StaticResource VayuDarkButton}" HorizontalAlignment="Left" Padding="14,6"
                                        Command="{Binding CancelMicrosoftLoginCommand}">
                                    <TextBlock Text="Cancel Login" FontSize="11.5" Foreground="{StaticResource VayuTextDimBrush}"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Empty State for Microsoft Accounts -->
                        <Border Visibility="{Binding HasMicrosoftAccounts, Converter={StaticResource InverseBoolToVis}}"
                                CornerRadius="4" Background="#151F32" BorderBrush="#243247" BorderThickness="1"
                                Padding="16,12" Margin="0,0,0,8">
                            <TextBlock Text="No Microsoft accounts connected yet. Click 'Login with Microsoft' above to authenticate." 
                                       FontSize="11.5" Foreground="{StaticResource VayuTextDimBrush}" HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Microsoft Accounts List -->
                        <ItemsControl ItemsSource="{Binding MicrosoftAccounts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Background="#1B2638" BorderBrush="{Binding IsActive, Converter={StaticResource BoolToActiveBorderBrush}}" BorderThickness="1.5"
                                            Padding="16,12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="4"
                                                    Background="#0F172A" BorderBrush="#243247" BorderThickness="1" Margin="0,0,12,0" ClipToBounds="True">
                                                <Image Source="{Binding Converter={StaticResource SkinHeadImage}}" Width="36" Height="36"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="UniformToFill"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Username}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource VayuTextBrush}" Margin="0,0,8,0"/>
                                                    <Border CornerRadius="3" Background="#10251C" BorderBrush="#22C55E" BorderThickness="1" Padding="6,1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                        <TextBlock Text="MICROSOFT" FontSize="9" FontWeight="Bold" Foreground="#22C55E"/>
                                                    </Border>
                                                    <Border CornerRadius="3" Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" Padding="6,1" VerticalAlignment="Center"
                                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="CURRENT ACTIVE" FontSize="8.5" FontWeight="Black" Foreground="#34D399"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Uuid}" FontSize="11" Foreground="{StaticResource VayuTextMutedBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource VayuAccentButton}" Padding="12,5" Margin="0,0,6,0"
                                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                                                        IsEnabled="False">
                                                    <TextBlock Text="✓ Active" FontSize="11.5" FontWeight="Bold" Foreground="White"/>
                                                </Button>
                                                <Button Style="{StaticResource VayuDarkButton}" Padding="12,5" Margin="0,0,6,0"
                                                        Visibility="{Binding IsActive, Converter={StaticResource InverseBoolToVis}}"
                                                        Command="{Binding DataContext.SelectProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Id}">
                                                    <TextBlock Text="Select" FontSize="11.5"/>
                                                </Button>
                                                <Button Style="{StaticResource VayuDangerButton}" Padding="10,5"
                                                        Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Id}">
                                                    <TextBlock Text="Delete" FontSize="11.5"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ═══ OFFLINE PLAYER PROFILES CARD ═══ -->
                <Border CornerRadius="6" Background="{StaticResource VayuSurfaceBrush}" BorderBrush="{StaticResource VayuBorderBrush}" BorderThickness="1"
                        Padding="22,18">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="LOCAL PLAYER PROFILES" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource VayuBrightBlueBrush}"/>
                                <TextBlock Text="Offline Profiles" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="1" Style="{StaticResource VayuAccentButton}" Padding="18,8" VerticalAlignment="Center"
                                    Command="{Binding ShowCreateProfileCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource VayuIconPlus}" Fill="#FFFFFF" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Create Offline Profile" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock Text="Create custom local player usernames for offline / direct IP gameplay."
                                   FontSize="12" Foreground="{StaticResource VayuTextDimBrush}" Margin="0,0,0,14"/>

                        <!-- Empty State for Offline Profiles -->
                        <Border Visibility="{Binding HasOfflineProfiles, Converter={StaticResource InverseBoolToVis}}"
                                CornerRadius="4" Background="#151F32" BorderBrush="#243247" BorderThickness="1"
                                Padding="16,12" Margin="0,0,0,8">
                            <TextBlock Text="No offline player profiles created yet. Click 'Create Offline Profile' to add one." 
                                       FontSize="11.5" Foreground="{StaticResource VayuTextDimBrush}" HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Offline Profiles List -->
                        <ItemsControl ItemsSource="{Binding OfflineProfiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Background="#1B2638" BorderBrush="{Binding IsActive, Converter={StaticResource BoolToActiveBorderBrush}}" BorderThickness="1.5"
                                            Padding="16,12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="4"
                                                    Background="#0F172A" BorderBrush="#243247" BorderThickness="1" Margin="0,0,12,0" ClipToBounds="True">
                                                <Image Source="{Binding Converter={StaticResource SkinHeadImage}}" Width="36" Height="36"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="UniformToFill"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Username}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource VayuTextBrush}" Margin="0,0,8,0"/>
                                                    <Border CornerRadius="3" Background="#1E293B" BorderBrush="#243247" BorderThickness="1" Padding="6,1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                        <TextBlock Text="OFFLINE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource VayuTextDimBrush}"/>
                                                    </Border>
                                                    <Border CornerRadius="3" Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" Padding="6,1" VerticalAlignment="Center"
                                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="CURRENT ACTIVE" FontSize="8.5" FontWeight="Black" Foreground="#34D399"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Uuid}" FontSize="11" Foreground="{StaticResource VayuTextMutedBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource VayuAccentButton}" Padding="12,5" Margin="0,0,6,0"
                                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                                                        IsEnabled="False">
                                                    <TextBlock Text="✓ Active" FontSize="11.5" FontWeight="Bold" Foreground="White"/>
                                                </Button>
                                                <Button Style="{StaticResource VayuDarkButton}" Padding="12,5" Margin="0,0,6,0"
                                                        Visibility="{Binding IsActive, Converter={StaticResource InverseBoolToVis}}"
                                                        Command="{Binding DataContext.SelectProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Id}">
                                                    <TextBlock Text="Select" FontSize="11.5"/>
                                                </Button>
                                                <Button Style="{StaticResource VayuDangerButton}" Padding="10,5"
                                                        Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Id}">
                                                    <TextBlock Text="Delete" FontSize="11.5"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══ OFFLINE PROFILE CREATION MODAL ═══ -->
        <Grid Visibility="{Binding IsCreatingProfile, Converter={StaticResource BoolToVis}}"
              Background="#E00B1220">
            <Border Width="420" CornerRadius="6" 
                    Background="#151F32" BorderBrush="#243247" BorderThickness="1"
                    Padding="24,20" HorizontalAlignment="Center" VerticalAlignment="Center">

                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Create Offline Profile" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <Button Grid.Column="1" Command="{Binding CancelCreateProfileCommand}"
                                Content="✕" FontSize="14" Foreground="{StaticResource VayuTextDimBrush}"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4"/>
                    </Grid>

                    <TextBlock Text="PLAYER USERNAME" FontSize="11" FontWeight="Bold" Foreground="{StaticResource VayuTextDimBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding NewProfileUsername, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource VayuGlassTextBox}" Height="36" Margin="0,0,0,18"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CancelCreateProfileCommand}"
                                Style="{StaticResource VayuDarkButton}" Padding="14,7" Margin="0,0,8,0"/>
                        <Button Content="Create Profile" Command="{Binding CreateProfileCommand}"
                                Style="{StaticResource VayuAccentButton}" Padding="16,7"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
