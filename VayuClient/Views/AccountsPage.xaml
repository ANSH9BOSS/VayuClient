<UserControl x:Class="VayuClient.Views.AccountsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:VayuClient.Converters"
             Background="#050507"
             FontFamily="{StaticResource VayuFontFamily}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <converters:SkinHeadImageConverter x:Key="SkinHeadImage"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>

        <!-- ═══ REFINED BUTTON STYLES FOR REDESIGNED ACCOUNTS SCREEN ═══ -->

        <!-- Crisp White Pill Primary Button (SELECT / PRIMARY ACTION) -->
        <Style x:Key="RefSelectButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#09080E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ControlTemplate.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </ControlTemplate.Resources>
                        <Border x:Name="Bd" CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                TextBlock.Foreground="{TemplateBinding Foreground}"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CBD5E1"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Restrained Dark Red Border Button (DELETE) -->
        <Style x:Key="RefDeleteButton" TargetType="Button">
            <Setter Property="Background" Value="#150B0E"/>
            <Setter Property="Foreground" Value="#F87171"/>
            <Setter Property="BorderBrush" Value="#4C151B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ControlTemplate.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </ControlTemplate.Resources>
                        <Border x:Name="Bd" CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                TextBlock.Foreground="{TemplateBinding Foreground}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#7F1D1D"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#DC2626"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#450A0A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Dark Matte Button (+ ADD ACCOUNT / CANCEL) -->
        <Style x:Key="RefDarkButton" TargetType="Button">
            <Setter Property="Background" Value="#0F0E17"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderBrush" Value="#252136"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ControlTemplate.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </ControlTemplate.Resources>
                        <Border x:Name="Bd" CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                TextBlock.Foreground="{TemplateBinding Foreground}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A1828"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4C3D6E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0A0910"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary White Button (SIGN IN WITH MICROSOFT) -->
        <Style x:Key="RefWhiteButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#09080E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ControlTemplate.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </ControlTemplate.Resources>
                        <Border x:Name="Bd" CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                TextBlock.Foreground="{TemplateBinding Foreground}"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CBD5E1"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- More / Options Button (···) -->
        <Style x:Key="RefMoreButton" TargetType="Button">
            <Setter Property="Background" Value="#0F0E17"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderBrush" Value="#252136"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ControlTemplate.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </ControlTemplate.Resources>
                        <Border x:Name="Bd" CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                TextBlock.Foreground="{TemplateBinding Foreground}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A1828"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4C3D6E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Floating Dock Navigation Button Style -->
        <Style x:Key="DockNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ControlTemplate.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </ControlTemplate.Resources>
                        <Border x:Name="Bd" CornerRadius="16"
                                Background="{TemplateBinding Background}"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                TextBlock.Foreground="{TemplateBinding Foreground}"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#161424"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0E0D18"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active Dock Navigation Item -->
        <Style x:Key="DockActiveNavButton" TargetType="Button" BasedOn="{StaticResource DockNavButton}">
            <Setter Property="Foreground" Value="#D8B4FE"/>
            <Setter Property="Background" Value="#1E1933"/>
            <Setter Property="BorderBrush" Value="#7C3AED"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ControlTemplate.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </ControlTemplate.Resources>
                        <Border x:Name="Bd" CornerRadius="16"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                TextBlock.Foreground="{TemplateBinding Foreground}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="#050507">

        <!-- ═══ SUBTLE PURPLE AMBIENT BACKGROUND LIGHT ═══ -->
        <Ellipse Width="600" Height="450" HorizontalAlignment="Left" VerticalAlignment="Center"
                 Margin="-120,0,0,60" IsHitTestVisible="False" Opacity="0.07">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#A855F7" Offset="0.0"/>
                    <GradientStop Color="#7C3AED" Offset="0.5"/>
                    <GradientStop Color="Transparent" Offset="1.0"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- ═══ TOP HEADER ═══ -->
        <TextBlock Text="ACCOUNTS &amp; PROFILES"
                   FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"
                   Margin="48,32,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <!-- ═══ MAIN ASYMMETRIC CONTENT AREA ═══ -->
        <Grid Margin="48,70,48,76" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- 1. LEFT: ACTIVE ACCOUNT SHOWCASE WITH GEOMETRIC BRACKET        -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Grid Grid.Column="0" VerticalAlignment="Center">
                
                <!-- Stylized Geometric Hairline Outer Bracket -->
                <!-- Shape: Rounded-rect left with chamfered pointed tab on right -->
                <Path Data="M 12,0 L 430,0 L 476,120 L 430,240 L 12,240 A 12,12 0 0 1 0,228 L 0,12 A 12,12 0 0 1 12,0 Z"
                      Stroke="#581C87" StrokeThickness="1.2"
                      Fill="#090812"
                      HorizontalAlignment="Left" VerticalAlignment="Center"
                      Width="478" Height="242"/>

                <!-- Active Account Inner Content -->
                <Grid Width="450" Height="240" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Large Minecraft Skin Head Avatar -->
                    <Border Grid.Column="0" Width="176" Height="176" CornerRadius="12"
                            Background="#141021" BorderBrush="#2E2248" BorderThickness="1"
                            Margin="24,0,24,0" VerticalAlignment="Center" ClipToBounds="True">
                        <Image Source="{Binding ActiveProfile, Converter={StaticResource SkinHeadImage}}"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               Stretch="UniformToFill"/>
                    </Border>

                    <!-- Active Account Metadata -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,28,0">
                        
                        <!-- Real Username -->
                        <TextBlock Text="{Binding ActiveProfileUsername}"
                                   FontSize="26" FontWeight="Black" Foreground="#FFFFFF"
                                   TextTrimming="CharacterEllipsis" MaxWidth="210"/>

                        <!-- Account Type Display -->
                        <TextBlock Text="{Binding ActiveProfileAccountTypeDisplay}"
                                   FontSize="11" FontWeight="Bold" Foreground="#858099"
                                   Margin="0,5,0,0"/>

                        <!-- Glowing Active Dot Status -->
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                    Visibility="{Binding HasActiveProfile, Converter={StaticResource BoolToVis}}">
                            <Ellipse Width="7" Height="7" Fill="#A855F7" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="ACTIVE" FontSize="11" FontWeight="Black" Foreground="#C084FC" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Empty active state prompt if no account is selected -->
                        <StackPanel Margin="0,10,0,0"
                                    Visibility="{Binding HasActiveProfile, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock Text="No active profile selected." FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- 2. CONNECTING CIRCUIT TRACE LINES                              -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Canvas Grid.Column="1" Width="60" Height="280" VerticalAlignment="Center" IsHitTestVisible="False">
                <!-- Circuit trace branching from left bracket tip (x=0, y=140) to right column -->
                <Path Data="M 0,140 L 25,140 L 35,42 L 60,42" Stroke="#6B21A8" StrokeThickness="1"/>
                <Path Data="M 35,42 L 35,102 L 60,102" Stroke="#6B21A8" StrokeThickness="1"/>
                <Path Data="M 0,140 L 25,140 L 35,178 L 60,178" Stroke="#6B21A8" StrokeThickness="1"/>
                <Path Data="M 35,178 L 35,238 L 60,238" Stroke="#6B21A8" StrokeThickness="1"/>
                
                <!-- Tiny geometric node dots -->
                <Ellipse Canvas.Left="-2" Canvas.Top="138" Width="4" Height="4" Fill="#A855F7"/>
                <Ellipse Canvas.Left="58" Canvas.Top="40" Width="4" Height="4" Fill="#7C3AED"/>
                <Ellipse Canvas.Left="58" Canvas.Top="100" Width="4" Height="4" Fill="#7C3AED"/>
                <Ellipse Canvas.Left="58" Canvas.Top="176" Width="4" Height="4" Fill="#7C3AED"/>
                <Ellipse Canvas.Left="58" Canvas.Top="236" Width="4" Height="4" Fill="#7C3AED"/>
            </Canvas>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- 3. RIGHT: OTHER ACCOUNTS & ACTIONS LIST                        -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="370" MaxWidth="440">

                <!-- ─── MICROSOFT ACCOUNTS SECTION ─── -->
                <StackPanel Margin="0,0,0,16">

                    <!-- List of other Microsoft Accounts -->
                    <ItemsControl ItemsSource="{Binding OtherMicrosoftAccounts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0C0A14" BorderBrush="#1C182B" BorderThickness="1" CornerRadius="8"
                                        Padding="12,8" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Minecraft Avatar -->
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="5"
                                                Background="#141021" ClipToBounds="True" Margin="0,0,12,0">
                                            <Image Source="{Binding Converter={StaticResource SkinHeadImage}}"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                   Stretch="UniformToFill"/>
                                        </Border>

                                        <!-- Username & Type -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Username}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="MICROSOFT" FontSize="9.5" FontWeight="Bold" Foreground="#7E7B92" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Actions -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="SELECT" Style="{StaticResource RefSelectButton}"
                                                    Command="{Binding DataContext.SelectProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Id}" Margin="0,0,6,0"/>
                                            <Button Content="DELETE" Style="{StaticResource RefDeleteButton}"
                                                    Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Id}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Microsoft Action Buttons Row -->
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Button Content="+ ADD ACCOUNT" Style="{StaticResource RefDarkButton}"
                                Command="{Binding ShowCreateProfileCommand}" Margin="0,0,10,0"/>
                        <Button Content="SIGN IN WITH MICROSOFT" Style="{StaticResource RefWhiteButton}"
                                Command="{Binding SignInMicrosoftCommand}"/>
                    </StackPanel>
                </StackPanel>

                <!-- ─── OFFLINE PROFILES SECTION ─── -->
                <StackPanel Margin="0,8,0,0">

                    <!-- List of other Offline Profiles -->
                    <ItemsControl ItemsSource="{Binding OtherOfflineProfiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0C0A14" BorderBrush="#1C182B" BorderThickness="1" CornerRadius="8"
                                        Padding="12,8" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Minecraft Avatar -->
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="5"
                                                Background="#141021" ClipToBounds="True" Margin="0,0,12,0">
                                            <Image Source="{Binding Converter={StaticResource SkinHeadImage}}"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                   Stretch="UniformToFill"/>
                                        </Border>

                                        <!-- Username & Type -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Username}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="OFFLINE" FontSize="9.5" FontWeight="Bold" Foreground="#7E7B92" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Actions -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="SELECT" Style="{StaticResource RefSelectButton}"
                                                    Command="{Binding DataContext.SelectProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Id}" Margin="0,0,6,0"/>
                                            <Button Content="DELETE" Style="{StaticResource RefDeleteButton}"
                                                    Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Id}" Margin="0,0,6,0"/>
                                            <Button Content="···" Style="{StaticResource RefMoreButton}"
                                                    Command="{Binding DataContext.StartRenameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Id}" ToolTip="Rename Offline Profile"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Offline Action Buttons Row -->
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Button Content="+ ADD ACCOUNT" Style="{StaticResource RefDarkButton}"
                                Command="{Binding ShowCreateProfileCommand}" Margin="0,0,10,0"/>
                        <Button Content="SIGN IN WITH MICROSOFT" Style="{StaticResource RefWhiteButton}"
                                Command="{Binding SignInMicrosoftCommand}"/>
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- 4. FLOATING VAYU BOTTOM DOCK                                    -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,24"
                Background="#0C0B12" BorderBrush="#201C2E" BorderThickness="1"
                CornerRadius="20" Padding="6,3" Height="40">
            <StackPanel Orientation="Horizontal">
                <Button Content="HOME" Style="{StaticResource DockNavButton}"
                        Command="{Binding NavigateCommand}" CommandParameter="Home"/>
                <Button Content="LIBRARY" Style="{StaticResource DockNavButton}"
                        Command="{Binding NavigateCommand}" CommandParameter="InstallationManager"/>
                <Button Content="MODS" Style="{StaticResource DockNavButton}"
                        Command="{Binding NavigateCommand}" CommandParameter="Mods"/>
                <Button Content="SERVERS" Style="{StaticResource DockNavButton}"
                        Command="{Binding NavigateCommand}" CommandParameter="Servers"/>
                <Button Content="ACCOUNTS" Style="{StaticResource DockActiveNavButton}"
                        Command="{Binding NavigateCommand}" CommandParameter="Accounts"/>
                <Button Content="SETTINGS" Style="{StaticResource DockNavButton}"
                        Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- 5. OFFLINE PROFILE CREATION MODAL                              -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Visibility="{Binding IsCreatingProfile, Converter={StaticResource BoolToVis}}"
              Background="#E0050508" Panel.ZIndex="100">
            <Border Width="420" CornerRadius="10"
                    Background="#0D0C16" BorderBrush="#262138" BorderThickness="1.5"
                    Padding="26,22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Create Offline Profile" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <Button Grid.Column="1" Command="{Binding CancelCreateProfileCommand}"
                                Content="✕" FontSize="13" Foreground="#94A3B8"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4"/>
                    </Grid>

                    <TextBlock Text="PLAYER USERNAME" FontSize="10.5" FontWeight="Bold" Foreground="#858099" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding NewProfileUsername, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource VayuGlassTextBox}" Height="36" Margin="0,0,0,18"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CancelCreateProfileCommand}"
                                Style="{StaticResource RefDarkButton}" Margin="0,0,8,0"/>
                        <Button Content="Create Profile" Command="{Binding CreateProfileCommand}"
                                Style="{StaticResource RefWhiteButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- 6. RENAME OFFLINE PROFILE MODAL                                -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}"
              Background="#E0050508" Panel.ZIndex="100">
            <Border Width="420" CornerRadius="10"
                    Background="#0D0C16" BorderBrush="#262138" BorderThickness="1.5"
                    Padding="26,22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Rename Profile" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <Button Grid.Column="1" Command="{Binding CancelRenameCommand}"
                                Content="✕" FontSize="13" Foreground="#94A3B8"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4"/>
                    </Grid>

                    <TextBlock Text="NEW USERNAME" FontSize="10.5" FontWeight="Bold" Foreground="#858099" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource VayuGlassTextBox}" Height="36" Margin="0,0,0,18"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CancelRenameCommand}"
                                Style="{StaticResource RefDarkButton}" Margin="0,0,8,0"/>
                        <Button Content="Save Changes" Command="{Binding ConfirmRenameCommand}"
                                Style="{StaticResource RefWhiteButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- 7. MICROSOFT DEVICE CODE AUTHENTICATION MODAL                  -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Visibility="{Binding IsLoggingInMicrosoft, Converter={StaticResource BoolToVis}}"
              Background="#E0050508" Panel.ZIndex="110">
            <Border Width="460" CornerRadius="10"
                    Background="#0D0C16" BorderBrush="#7C3AED" BorderThickness="1.5"
                    Padding="28,24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Microsoft Authentication" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                    <TextBlock Text="Open microsoft.com/link in your browser and enter the code below:"
                               FontSize="12" Foreground="#94A3B8" Margin="0,0,0,14"/>

                    <!-- Code Box -->
                    <Border Background="#07060B" BorderBrush="#3B1C66" BorderThickness="1" CornerRadius="6"
                            Padding="16,12" HorizontalAlignment="Stretch" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding MicrosoftUserCode}" FontSize="24" FontWeight="Black"
                                       Foreground="#C084FC" VerticalAlignment="Center" TextAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource RefDarkButton}" Padding="10,5" Command="{Binding CopyUserCodeCommand}" Margin="0,0,6,0">
                                    <TextBlock Text="Copy Code" FontSize="11"/>
                                </Button>
                                <Button Style="{StaticResource RefDarkButton}" Padding="10,5" Command="{Binding OpenVerificationLinkCommand}">
                                    <TextBlock Text="Open Link" FontSize="11"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Status Text -->
                    <TextBlock Text="{Binding MicrosoftAuthStatus}" FontSize="11.5"
                               Foreground="#A855F7" Margin="0,0,0,14"/>

                    <Button Style="{StaticResource RefDarkButton}" HorizontalAlignment="Right"
                            Command="{Binding CancelMicrosoftLoginCommand}">
                        <TextBlock Text="Cancel" FontSize="11.5"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
