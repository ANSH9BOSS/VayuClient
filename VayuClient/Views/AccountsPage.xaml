<UserControl x:Class="VayuClient.Views.AccountsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:VayuClient.Converters"
             xmlns:controls="clr-namespace:VayuClient.Controls"
             Background="#06070B"
             FontFamily="{StaticResource VayuFontFamily}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <converters:SkinHeadImageConverter x:Key="SkinHeadImage"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>

        <!-- ═══ 3D BUTTON STYLES FOR ACCOUNTS SCREEN ═══ -->

        <!-- 3D White Beveled Primary Button (SELECT / PRIMARY ACTION) -->
        <Style x:Key="Vayu3DSelectButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#09080E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- 3D Drop Shadow -->
                            <Border CornerRadius="6" Background="#000000" Opacity="0.5" Margin="0,2,-0,-2"/>
                            <!-- Button Base -->
                            <Border x:Name="Bd" CornerRadius="6"
                                    Background="{TemplateBinding Background}"
                                    BorderThickness="0"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <!-- Top Highlight Bevel -->
                                    <Border CornerRadius="6,6,0,0" Height="2" VerticalAlignment="Top" Background="#FFFFFFFF" Opacity="0.8"/>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      TextBlock.Foreground="{TemplateBinding Foreground}"
                                                      TextBlock.FontWeight="Bold"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FFFFFF" BlurRadius="10" ShadowDepth="0" Opacity="0.3"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1.5"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Bd" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 3D Crimson Red Button (DELETE) -->
        <Style x:Key="Vayu3DDeleteButton" TargetType="Button">
            <Setter Property="Background" Value="#1A0B10"/>
            <Setter Property="Foreground" Value="#F87171"/>
            <Setter Property="BorderBrush" Value="#5C1D24"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- 3D Base -->
                            <Border x:Name="Bd" CornerRadius="6"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <!-- Top Highlight Bevel -->
                                    <Border CornerRadius="5,5,0,0" Height="1" VerticalAlignment="Top" Background="#FF7F1D1D" Opacity="0.6"/>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      TextBlock.Foreground="{TemplateBinding Foreground}"
                                                      TextBlock.FontWeight="Bold"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#7F1D1D"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#DC2626"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1.5"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Bd" Property="Background" Value="#450A0A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 3D Dark Obsidian Button (+ ADD ACCOUNT / CANCEL) -->
        <Style x:Key="Vayu3DDarkActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#120E1E"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderBrush" Value="#2A2242"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- 3D Shadow -->
                            <Border CornerRadius="6" Background="#000000" Opacity="0.4" Margin="0,2,0,-2"/>
                            <!-- Base -->
                            <Border x:Name="Bd" CornerRadius="6"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <!-- Top Edge Bevel -->
                                    <Border CornerRadius="5,5,0,0" Height="1" VerticalAlignment="Top" Background="#FFFFFF" Opacity="0.15"/>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      TextBlock.Foreground="{TemplateBinding Foreground}"
                                                      TextBlock.FontWeight="SemiBold"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F1735"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#A855F7"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1.5"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Bd" Property="Background" Value="#0C0916"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 3D Purple Accent Action Button (SIGN IN WITH MICROSOFT) -->
        <Style x:Key="Vayu3DPurplePrimaryBtn" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#9333EA" Offset="0.0"/>
                        <GradientStop Color="#7C3AED" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#C084FC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- 3D Shadow -->
                            <Border CornerRadius="6" Background="#000000" Opacity="0.5" Margin="0,2,0,-2"/>
                            <!-- Base -->
                            <Border x:Name="Bd" CornerRadius="6"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <!-- Top Edge Bevel -->
                                    <Border CornerRadius="5,5,0,0" Height="1.5" VerticalAlignment="Top" Background="#FFFFFF" Opacity="0.4"/>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      TextBlock.Foreground="{TemplateBinding Foreground}"
                                                      TextBlock.FontWeight="Bold"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#A855F7" Offset="0.0"/>
                                            <GradientStop Color="#8B5CF6" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#A855F7" BlurRadius="12" ShadowDepth="0" Opacity="0.5"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1.5"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Bd" Property="Background" Value="#6B21A8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- More Button (···) -->
        <Style x:Key="Vayu3DMoreBtn" TargetType="Button" BasedOn="{StaticResource Vayu3DDarkActionBtn}">
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

    </UserControl.Resources>

    <Grid Background="#06070B">

        <!-- ═══ 3D PURPLE AMBIENT LIGHT LAYER ═══ -->
        <Ellipse Width="800" Height="600" HorizontalAlignment="Left" VerticalAlignment="Center"
                 Margin="-200,0,0,0" IsHitTestVisible="False" Opacity="0.07">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#A855F7" Offset="0.0"/>
                    <GradientStop Color="#7C3AED" Offset="0.5"/>
                    <GradientStop Color="Transparent" Offset="1.0"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- ═══ TOP HEADER ═══ -->
        <StackPanel Margin="48,24,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="ACCOUNTS" FontSize="16" FontWeight="Black" Foreground="#FFFFFF"/>
                <TextBlock Text="&amp; PROFILES" FontSize="16" FontWeight="Black" Foreground="#A855F7" Margin="6,0,0,0"/>
            </StackPanel>
            <TextBlock Text="Manage your authenticated Microsoft accounts and offline player identities"
                       FontSize="11" Foreground="#64748B" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- ═══ MAIN 2-COLUMN STUDIO LAYOUT ═══ -->
        <Grid Margin="48,68,48,76" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="480"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- 1. LEFT COLUMN: 3D ACTIVE HEROIC PLAYER SHOWCASE                -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Border Grid.Column="0" CornerRadius="18" Background="#0B0817" BorderBrush="#2F1B4E" BorderThickness="1.2"
                    Padding="16,18">
                <Border.Effect>
                    <DropShadowEffect Color="#7C3AED" BlurRadius="28" ShadowDepth="0" Opacity="0.22"/>
                </Border.Effect>
                <Grid>
                    <!-- Top Bevel Accent -->
                    <Border CornerRadius="16,16,0,0" Height="2" VerticalAlignment="Top">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#A855F7" Offset="0.0"/>
                                <GradientStop Color="#C084FC" Offset="0.5"/>
                                <GradientStop Color="#7C3AED" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        
                        <!-- 3D Running Player Stage (Unconfined & Unclipped) -->
                        <Grid Width="260" Height="290" Margin="0,4,0,10" HorizontalAlignment="Center">
                            <!-- Glowing Purple Floor Halo Under Feet -->
                            <Ellipse Width="180" Height="30" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4" IsHitTestVisible="False">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#80A855F7" Offset="0.0"/>
                                        <GradientStop Color="#257C3AED" Offset="0.5"/>
                                        <GradientStop Color="#00000000" Offset="1.0"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <!-- Subtle Ambient Backlight -->
                            <Ellipse Width="200" Height="220" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.3">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#50A855F7" Offset="0.0"/>
                                        <GradientStop Color="#00000000" Offset="1.0"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <!-- 3D Player Body Model -->
                            <controls:PlayerBody3D Profile="{Binding ActiveProfile}" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Width="260" Height="290"/>
                        </Grid>

                        <!-- Account Type Badge -->
                        <Border Background="#1C1335" BorderBrush="#7C3AED" BorderThickness="1" CornerRadius="5"
                                HorizontalAlignment="Center" Padding="8,3" Margin="0,0,0,6">
                            <TextBlock Text="{Binding ActiveProfileAccountTypeDisplay}" FontSize="9.5" FontWeight="Black" Foreground="#C084FC"/>
                        </Border>

                        <!-- Active Username -->
                        <TextBlock Text="{Binding ActiveProfileUsername}"
                                   FontSize="22" FontWeight="Black" Foreground="#FFFFFF"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="280"/>

                        <!-- Active Status Dot -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0"
                                    Visibility="{Binding HasActiveProfile, Converter={StaticResource BoolToVis}}">
                            <Ellipse Width="7" Height="7" Fill="#A855F7" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#A855F7" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="ACTIVE &amp; READY TO PLAY" FontSize="10.5" FontWeight="Black" Foreground="#D8B4FE" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Empty active state prompt -->
                        <TextBlock Text="No active profile selected." FontSize="11" Foreground="#64748B"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"
                                   Visibility="{Binding HasActiveProfile, Converter={StaticResource InverseBoolToVis}}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- 2. RIGHT COLUMN: SAVED ACCOUNTS & AUTHENTICATION ACTIONS        -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Grid Grid.Column="2" VerticalAlignment="Center">
                <StackPanel>

                    <!-- Section Top Action Header -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SAVED PROFILES" FontSize="13" FontWeight="Black" Foreground="#FFFFFF"/>
                            <TextBlock Text="Switch between Microsoft and Offline identities" FontSize="10" Foreground="#7D7596" Margin="0,1,0,0"/>
                        </StackPanel>

                        <!-- Add / Login Action Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="+ OFFLINE" Style="{StaticResource Vayu3DDarkActionBtn}"
                                    Command="{Binding ShowCreateProfileCommand}" Margin="0,0,8,0" Padding="12,5" FontSize="10.5"/>
                            <Button Content="SIGN IN MICROSOFT" Style="{StaticResource Vayu3DPurplePrimaryBtn}"
                                    Command="{Binding SignInMicrosoftCommand}" Padding="14,6" FontSize="10.5"/>
                        </StackPanel>
                    </Grid>

                    <!-- Scrollable Account List Container -->
                    <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>

                            <!-- ─── MICROSOFT ACCOUNTS SECTION ─── -->
                            <ItemsControl ItemsSource="{Binding OtherMicrosoftAccounts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0D0A18" BorderBrush="#251D38" BorderThickness="1" CornerRadius="10"
                                                Padding="12,8" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Minecraft Avatar -->
                                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                                        Background="#141021" BorderBrush="#3B2E58" BorderThickness="1"
                                                        ClipToBounds="True" Margin="0,0,12,0">
                                                    <controls:PlayerBody3D Profile="{Binding}" DisplayMode="HeadOnly"/>
                                                </Border>

                                                <!-- Username & Type -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Username}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="MICROSOFT AUTH" FontSize="9" FontWeight="Black" Foreground="#A855F7" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <!-- Actions -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="SELECT" Style="{StaticResource Vayu3DSelectButton}"
                                                            Command="{Binding DataContext.SelectProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Id}" Margin="0,0,6,0"/>
                                                    <Button Content="DELETE" Style="{StaticResource Vayu3DDeleteButton}"
                                                            Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Id}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- ─── OFFLINE PROFILES SECTION ─── -->
                            <ItemsControl ItemsSource="{Binding OtherOfflineProfiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0D0A18" BorderBrush="#251D38" BorderThickness="1" CornerRadius="10"
                                                Padding="12,8" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Minecraft Avatar -->
                                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                                        Background="#141021" BorderBrush="#3B2E58" BorderThickness="1"
                                                        ClipToBounds="True" Margin="0,0,12,0">
                                                    <controls:PlayerBody3D Profile="{Binding}" DisplayMode="HeadOnly"/>
                                                </Border>

                                                <!-- Username & Type -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Username}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="OFFLINE PROFILE" FontSize="9" FontWeight="Black" Foreground="#64748B" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <!-- Actions -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="SELECT" Style="{StaticResource Vayu3DSelectButton}"
                                                            Command="{Binding DataContext.SelectProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Id}" Margin="0,0,6,0"/>
                                                    <Button Content="DELETE" Style="{StaticResource Vayu3DDeleteButton}"
                                                            Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Id}" Margin="0,0,6,0"/>
                                                    <Button Content="···" Style="{StaticResource Vayu3DMoreBtn}"
                                                            Command="{Binding DataContext.StartRenameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Id}" ToolTip="Rename Offline Profile"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </ScrollViewer>

                </StackPanel>
            </Grid>
        </Grid>


        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- 5. OFFLINE PROFILE CREATION 3D MODAL                           -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Visibility="{Binding IsCreatingProfile, Converter={StaticResource BoolToVis}}"
              Background="#D0050508" Panel.ZIndex="100">
            <Border Width="420" CornerRadius="14"
                    Background="#0D0C18" BorderBrush="#3B2E58" BorderThickness="1.5"
                    Padding="26,22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#7C3AED" BlurRadius="30" ShadowDepth="0" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Create Offline Profile" FontSize="16" FontWeight="Black" Foreground="#FFFFFF"/>
                        <Button Grid.Column="1" Command="{Binding CancelCreateProfileCommand}"
                                Content="✕" FontSize="13" Foreground="#94A3B8"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4"/>
                    </Grid>

                    <TextBlock Text="PLAYER USERNAME" FontSize="10.5" FontWeight="Bold" Foreground="#858099" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding NewProfileUsername, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource VayuGlassTextBox}" Height="38" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CancelCreateProfileCommand}"
                                Style="{StaticResource Vayu3DDarkActionBtn}" Margin="0,0,8,0"/>
                        <Button Content="Create Profile" Command="{Binding CreateProfileCommand}"
                                Style="{StaticResource Vayu3DPurplePrimaryBtn}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- 6. RENAME OFFLINE PROFILE 3D MODAL                             -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}"
              Background="#D0050508" Panel.ZIndex="100">
            <Border Width="420" CornerRadius="14"
                    Background="#0D0C18" BorderBrush="#3B2E58" BorderThickness="1.5"
                    Padding="26,22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#7C3AED" BlurRadius="30" ShadowDepth="0" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Rename Profile" FontSize="16" FontWeight="Black" Foreground="#FFFFFF"/>
                        <Button Grid.Column="1" Command="{Binding CancelRenameCommand}"
                                Content="✕" FontSize="13" Foreground="#94A3B8"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4"/>
                    </Grid>

                    <TextBlock Text="NEW USERNAME" FontSize="10.5" FontWeight="Bold" Foreground="#858099" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource VayuGlassTextBox}" Height="38" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CancelRenameCommand}"
                                Style="{StaticResource Vayu3DDarkActionBtn}" Margin="0,0,8,0"/>
                        <Button Content="Save Changes" Command="{Binding ConfirmRenameCommand}"
                                Style="{StaticResource Vayu3DPurplePrimaryBtn}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- 7. MICROSOFT DEVICE CODE AUTHENTICATION 3D MODAL               -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Visibility="{Binding IsLoggingInMicrosoft, Converter={StaticResource BoolToVis}}"
              Background="#D0050508" Panel.ZIndex="110">
            <Border Width="460" CornerRadius="14"
                    Background="#0D0C18" BorderBrush="#7C3AED" BorderThickness="1.5"
                    Padding="28,24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#7C3AED" BlurRadius="36" ShadowDepth="0" Opacity="0.35"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Microsoft Authentication" FontSize="17" FontWeight="Black" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                    <TextBlock Text="Open microsoft.com/link in your browser and enter the code below:"
                               FontSize="12" Foreground="#94A3B8" Margin="0,0,0,16"/>

                    <!-- 3D Code Box -->
                    <Border Background="#07060D" BorderBrush="#4A2578" BorderThickness="1.2" CornerRadius="8"
                            Padding="16,14" HorizontalAlignment="Stretch" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding MicrosoftUserCode}" FontSize="24" FontWeight="Black"
                                       Foreground="#C084FC" VerticalAlignment="Center" TextAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Copy Code" Style="{StaticResource Vayu3DDarkActionBtn}" Padding="10,5" Command="{Binding CopyUserCodeCommand}" Margin="0,0,6,0"/>
                                <Button Content="Open Link" Style="{StaticResource Vayu3DPurplePrimaryBtn}" Padding="10,5" Command="{Binding OpenVerificationLinkCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Status Text -->
                    <TextBlock Text="{Binding MicrosoftAuthStatus}" FontSize="11.5"
                               Foreground="#A855F7" Margin="0,0,0,16"/>

                    <Button Content="Cancel" Style="{StaticResource Vayu3DDarkActionBtn}" HorizontalAlignment="Right"
                            Command="{Binding CancelMicrosoftLoginCommand}"/>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
