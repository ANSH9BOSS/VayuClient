<Window x:Class="VayuClient.Views.ModpackConverterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:VayuClient.Converters"
        Title="VayuClient — Version &amp; Modpack Converter"
        FontFamily="{StaticResource VayuFontFamily}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Width="780" Height="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseDown"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="12" Background="#080D18" BorderBrush="#38BDF8" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="35" ShadowDepth="6" Opacity="0.85"/>
        </Border.Effect>

        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title / Header Bar -->
                <RowDefinition Height="*"/>    <!-- Content Area (Config / Converting / Results) -->
                <RowDefinition Height="Auto"/> <!-- Footer Action Buttons -->
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- 1. HEADER                                                       -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="8"
                        Background="#152238" BorderBrush="#38BDF8" BorderThickness="1.2"
                        Margin="0,0,12,0">
                    <TextBlock Text="🔄" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="VERSION &amp; MODPACK CONVERTER" FontSize="15.5" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        <Border Background="#1E3A8A" CornerRadius="4" Padding="6,1.5" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="CROSS-VERSION ENGINE" FontSize="9.5" FontWeight="Black" Foreground="#38BDF8"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Convert your modpack to newer or older Minecraft versions with automatic Modrinth sync." 
                               FontSize="11.5" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource TitleBarCloseButton}" Click="Close_Click" Width="30" Height="30">
                    <TextBlock Text="✕" FontSize="12" Foreground="#94A3B8"/>
                </Button>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- 2. CONTENT CONTAINER                                            -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="1">
                <!-- ─── PHASE 1: CONFIGURATION VIEW ─── -->
                <Grid x:Name="ConfigView" Visibility="Visible">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource VayuScrollViewer}">
                        <StackPanel Margin="0,0,8,0">
                            <!-- Source Instance Overview Box -->
                            <Border Background="#0C1424" BorderBrush="#1B2942" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="SOURCE INSTANCE" FontSize="9.5" FontWeight="Black" Foreground="#38BDF8" Margin="0,0,0,3"/>
                                        <TextBlock x:Name="TxtSourceName" Text="Spunky Optimized" FontSize="16" FontWeight="Black" Foreground="#FFFFFF"/>
                                        <TextBlock x:Name="TxtSourceSubtitle" Text="Minecraft 1.21.11 Fabric • 45 Mods Installed" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <Border Grid.Column="1" Background="#111B2E" BorderBrush="#1E3A8A" BorderThickness="1" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📦 " FontSize="11"/>
                                            <TextBlock x:Name="TxtSourceModCount" Text="45 Mods" FontSize="11.5" FontWeight="Bold" Foreground="#38BDF8"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Target Settings Form -->
                            <TextBlock Text="CONVERSION TARGET SETTINGS" FontSize="11" FontWeight="Black" Foreground="#CBD5E1" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Target MC Version -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="TARGET MINECRAFT VERSION" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CmbTargetVersion" Style="{StaticResource VayuComboBox}" SelectionChanged="CmbTargetVersion_SelectionChanged"/>
                                </StackPanel>

                                <!-- Target Mod Loader -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="TARGET MOD LOADER" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CmbTargetLoader" Style="{StaticResource VayuComboBox}" SelectionChanged="CmbTargetLoader_SelectionChanged"/>
                                </StackPanel>
                            </Grid>

                            <!-- New Instance Name Field -->
                            <TextBlock Text="NEW INSTANCE NAME" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                            <Border Background="#070B14" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,14">
                                <TextBox x:Name="TxtNewInstanceName" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="12.5"/>
                            </Border>

                            <!-- RAM Allocation Slider -->
                            <TextBlock x:Name="TxtAllocatedRamLabel" Text="ALLOCATED RAM: 4096 MB" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                            <Slider x:Name="SliderRam" Minimum="2048" Maximum="16384" SmallChange="1024" LargeChange="2048" TickFrequency="1024" IsSnapToTickEnabled="True"
                                    Value="4096" ValueChanged="SliderRam_ValueChanged" Margin="0,0,0,18"/>

                            <!-- Asset Preservation Options -->
                            <TextBlock Text="PRESERVATION OPTIONS" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                            <Border Background="#070B14" BorderBrush="#162238" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <CheckBox x:Name="ChkCopyResourcePacks" IsChecked="True" Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🎨 Copy Resource Packs (Transfers all textures &amp; packs directly)" FontSize="11.5" Foreground="#E2E8F0"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox x:Name="ChkCopyShaderPacks" IsChecked="True" Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="✨ Copy Shaderpacks (Transfers all custom shaders)" FontSize="11.5" Foreground="#E2E8F0"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox x:Name="ChkCopyOptions" IsChecked="True">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="⚙ Copy Game Options &amp; Controls (options.txt)" FontSize="11.5" Foreground="#E2E8F0"/>
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ─── PHASE 2: CONVERTING PROGRESS VIEW ─── -->
                <Grid x:Name="ConvertingView" Visibility="Collapsed">
                    <Border Background="#0A101D" BorderBrush="#1E3A8A" BorderThickness="1" CornerRadius="10" Padding="24"
                            VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center" Width="560">
                            <Border Width="48" Height="48" CornerRadius="24" Background="#111D33" BorderBrush="#38BDF8" BorderThickness="1.5"
                                    HorizontalAlignment="Center" Margin="0,0,0,16">
                                <TextBlock Text="🔄" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock x:Name="TxtProgressPercent" Text="0%" FontSize="28" FontWeight="Black" Foreground="#38BDF8" 
                                       HorizontalAlignment="Center" Margin="0,0,0,6"/>

                            <TextBlock x:Name="TxtProgressOperation" Text="Connecting to Modrinth API..." FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,6"/>

                            <TextBlock x:Name="TxtProgressDetail" Text="Scanning source instance..." FontSize="11.5" Foreground="#94A3B8"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,18"/>

                            <!-- Progress Bar -->
                            <ProgressBar x:Name="ProgressBarConversion" Height="10" Minimum="0" Maximum="100" Value="0"
                                         Foreground="#38BDF8" Background="#162238" BorderThickness="0" Margin="0,0,0,16"/>

                            <TextBlock Text="Fetching compatible versions for your target Minecraft release. Please wait..." 
                                       FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ─── PHASE 3: RESULTS & DIAGNOSTICS VIEW ─── -->
                <Grid x:Name="ResultsView" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Metrics Cards -->
                            <RowDefinition Height="Auto"/> <!-- Tabs Bar -->
                            <RowDefinition Height="*"/>    <!-- Tab Content -->
                        </Grid.RowDefinitions>

                        <!-- Metrics Cards (Ported vs Missing vs Resource Packs) -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Ported Mods Card -->
                            <Border Grid.Column="0" Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="PORTED MODS" FontSize="9.5" FontWeight="Black" Foreground="#34D399"/>
                                    <TextBlock x:Name="TxtPortedCount" Text="0" FontSize="20" FontWeight="Black" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                                    <TextBlock Text="Compatible releases synced" FontSize="10" Foreground="#A7F3D0"/>
                                </StackPanel>
                            </Border>

                            <!-- Missing Mods Card -->
                            <Border Grid.Column="2" Background="#451A03" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="MISSING / INCOMPATIBLE" FontSize="9.5" FontWeight="Black" Foreground="#FBBF24"/>
                                    <TextBlock x:Name="TxtMissingCount" Text="0" FontSize="20" FontWeight="Black" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                                    <TextBlock Text="Not available on target version" FontSize="10" Foreground="#FDE68A"/>
                                </StackPanel>
                            </Border>

                            <!-- Resource Packs Card -->
                            <Border Grid.Column="4" Background="#1E1B4B" BorderBrush="#818CF8" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="RESOURCE PACKS" FontSize="9.5" FontWeight="Black" Foreground="#A5B4FC"/>
                                    <TextBlock x:Name="TxtResourcePacksCount" Text="0" FontSize="20" FontWeight="Black" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                                    <TextBlock Text="Copied &amp; preserved" FontSize="10" Foreground="#C7D2FE"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Tab Selection Bar -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton x:Name="RbTabMissing" Content="⚠️ Missing Mods (0)" Checked="RbTabMissing_Checked"
                                         FontSize="11.5" FontWeight="Bold" Style="{StaticResource VayuTabRadioButton}" Margin="0,0,8,0"/>
                            <RadioButton x:Name="RbTabPorted" Content="✓ Ported Mods (0)" Checked="RbTabPorted_Checked"
                                         FontSize="11.5" FontWeight="Bold" Style="{StaticResource VayuTabRadioButton}" Margin="0,0,8,0"/>
                            <RadioButton x:Name="RbTabPacks" Content="🎨 Resource Packs (0)" Checked="RbTabPacks_Checked"
                                         FontSize="11.5" FontWeight="Bold" Style="{StaticResource VayuTabRadioButton}"/>
                        </StackPanel>

                        <!-- Tab Content Container -->
                        <Border Grid.Row="2" Background="#070B14" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="10">
                            <Grid>
                                <!-- Missing Mods List -->
                                <ScrollViewer x:Name="MissingModsContainer" VerticalScrollBarVisibility="Auto" Style="{StaticResource VayuScrollViewer}" Visibility="Visible">
                                    <StackPanel>
                                        <TextBlock Text="The following mods from your original instance could not be found or have no compatible build on Modrinth for this target version:" 
                                                   FontSize="11.5" Foreground="#94A3B8" Margin="4,2,4,10" TextWrapping="Wrap"/>
                                        <ItemsControl x:Name="ItemsMissingMods">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#0C1424" BorderBrush="#24334C" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{Binding ModName}" FontSize="12.5" FontWeight="Bold" Foreground="#F59E0B"/>
                                                                <TextBlock Text="{Binding OriginalFileName, StringFormat='File: {0}'}" FontSize="10.5" Foreground="#94A3B8" Margin="0,1,0,2"/>
                                                                <TextBlock Text="{Binding Reason}" FontSize="11" Foreground="#EF4444"/>
                                                            </StackPanel>

                                                            <Button Grid.Column="1" Tag="{Binding ModrinthSearchUrl}" Click="SearchModrinth_Click"
                                                                    Style="{StaticResource VayuDarkButton}" Padding="10,5" VerticalAlignment="Center">
                                                                <TextBlock Text="Search ↗" FontSize="11" Foreground="#38BDF8"/>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="TxtNoMissingMods" Text="Awesome! All mods were successfully resolved and ported." 
                                                   FontSize="12" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,30,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- Ported Mods List -->
                                <ScrollViewer x:Name="PortedModsContainer" VerticalScrollBarVisibility="Auto" Style="{StaticResource VayuScrollViewer}" Visibility="Collapsed">
                                    <ItemsControl x:Name="ItemsPortedMods">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#0C1424" BorderBrush="#1B2942" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding ModName}" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                            <TextBlock Text="{Binding NewFileName}" FontSize="11" Foreground="#38BDF8" Margin="0,1,0,0"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding TargetVersion, StringFormat='v{0}'}" FontSize="11" FontWeight="Bold" Foreground="#A78BFA" HorizontalAlignment="Right"/>
                                                            <TextBlock Text="{Binding FormattedSize}" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- Resource Packs List -->
                                <ScrollViewer x:Name="ResourcePacksContainer" VerticalScrollBarVisibility="Auto" Style="{StaticResource VayuScrollViewer}" Visibility="Collapsed">
                                    <StackPanel>
                                        <ItemsControl x:Name="ItemsResourcePacks">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#0C1424" BorderBrush="#1B2942" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,6">
                                                        <TextBlock Text="{Binding}" FontSize="11.5" FontWeight="Bold" Foreground="#CBD5E1"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="TxtNoResourcePacks" Text="No resource packs found in source instance." 
                                                   FontSize="11.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,30,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- 3. FOOTER ACTIONS                                               -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Info Note -->
                <TextBlock x:Name="TxtFooterNote" Text="Original instance files will remain 100% safe and untouched." 
                           FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                <!-- Config Actions -->
                <StackPanel x:Name="ConfigActions" Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Cancel" Click="Close_Click" Style="{StaticResource VayuDarkButton}" Padding="16,8" Margin="0,0,8,0"/>
                    <Button x:Name="BtnStartConvert" Content="Convert Modpack 🔄" Click="StartConvert_Click" Style="{StaticResource VayuAccentButton}" Padding="20,8"/>
                </StackPanel>

                <!-- Converting Actions -->
                <StackPanel x:Name="ConvertingActions" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed">
                    <Button Content="Abort Conversion" Click="CancelConvert_Click" Style="{StaticResource VayuDarkButton}" Padding="16,8"/>
                </StackPanel>

                <!-- Results Actions -->
                <StackPanel x:Name="ResultsActions" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed">
                    <Button Content="📂 Open Mods Folder" Click="OpenModsFolder_Click" Style="{StaticResource VayuDarkButton}" Padding="14,8" Margin="0,0,8,0"/>
                    <Button Content="Close" Click="Close_Click" Style="{StaticResource VayuDarkButton}" Padding="16,8" Margin="0,0,8,0"/>
                    <Button Content="Play Converted Instance 🚀" Click="PlayConverted_Click" Style="{StaticResource VayuAccentButton}" Padding="20,8"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
