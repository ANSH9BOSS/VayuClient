<UserControl x:Class="VayuClient.Views.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:VayuClient.Core"
             xmlns:controls="clr-namespace:VayuClient.Controls"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1100"
             Background="#060912">

    <Grid>
        <!-- 1. Ambient Background Artwork & Glow -->
        <Image Source="/Assets/Images/vayu_minecraft_hero.jpg" Stretch="UniformToFill" Opacity="0.25"
               RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
        
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.45" RadiusX="0.65" RadiusY="0.65">
                    <GradientStop Color="#00060912" Offset="0.0"/>
                    <GradientStop Color="#B0060912" Offset="0.6"/>
                    <GradientStop Color="#FC060912" Offset="1.0"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- 2. Central Welcome Card Container -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Style="{StaticResource VayuScrollViewer}" Padding="32,20">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="920">
                
                <!-- Logo & Brand Header -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                    <Border Width="68" Height="68" CornerRadius="34" Background="#0F172A" BorderBrush="#00D2FF" BorderThickness="2"
                            HorizontalAlignment="Center" Margin="0,0,0,14">
                        <Border.Effect>
                            <DropShadowEffect Color="#00D2FF" BlurRadius="24" ShadowDepth="0" Opacity="0.75"/>
                        </Border.Effect>
                        <Image Source="/Assets/Images/vayu_logo.png" Width="40" Height="40" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="WELCOME TO " FontSize="26" FontWeight="Black" Foreground="#FFFFFF"/>
                        <TextBlock Text="VAYU" FontSize="26" FontWeight="Black" Foreground="#00D2FF"/>
                        <TextBlock Text="CLIENT" FontSize="26" FontWeight="Black" Foreground="#38BDF8" Margin="4,0,0,0"/>
                    </StackPanel>

                    <TextBlock Text="Next-Generation High-FPS Minecraft Client Architecture"
                               FontSize="13" FontWeight="SemiBold" Foreground="#94A3B8"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Choice Cards (Microsoft Login vs Offline Account) -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ─── CARD 1: MICROSOFT LOGIN ─── -->
                    <Border Grid.Column="0" CornerRadius="14" Background="#D00B1220" BorderBrush="#1E293B" BorderThickness="1.5"
                            Padding="22" SnapsToDevicePixels="True">
                        <StackPanel>
                            <!-- Header -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Width="36" Height="36" CornerRadius="10" Background="#1E293B" Margin="0,0,12,0">
                                    <Path Data="{StaticResource VayuIconAccounts}" Fill="#00D2FF" Width="16" Height="16" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="MICROSOFT ACCOUNT" FontSize="13.5" FontWeight="Black" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Official Auth • Online Realms &amp; Skins" FontSize="11" Foreground="#38BDF8"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="Sign in securely with your official Microsoft account to sync your player skin, access multiplayer servers, and join official Realms."
                                       FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,16" LineHeight="17"/>

                            <!-- Device Code Status if Logging In -->
                            <Border Visibility="{Binding IsLoggingInMicrosoft, Converter={StaticResource BoolToVis}}"
                                    Background="#152033" CornerRadius="10" BorderBrush="#2563EB" BorderThickness="1"
                                    Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="{Binding MicrosoftAuthStatus}" FontSize="11.5" FontWeight="Bold" Foreground="#38BDF8" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                                    
                                    <!-- User Code Display with Copy Button -->
                                    <Border Background="#0B1220" CornerRadius="6" BorderBrush="#38BDF8" BorderThickness="1"
                                            Padding="10,6" Margin="0,10,0,8" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding MicrosoftUserCode}" FontSize="20" FontWeight="Black" Foreground="#FFFFFF"/>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                        <Button Command="{Binding CopyUserCodeCommand}" Style="{StaticResource VayuDarkButton}" Padding="10,4" Margin="0,0,6,0" Cursor="Hand">
                                            <TextBlock Text="📋 Copy Code" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                                        </Button>
                                        <Button Command="{Binding OpenVerificationUriCommand}" Style="{StaticResource VayuPrimaryButton}" Padding="10,4" Cursor="Hand">
                                            <TextBlock Text="🌐 Open Login Page" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Actions -->
                            <Button Command="{Binding StartMicrosoftLoginCommand}"
                                    IsEnabled="{Binding IsMicrosoftLoginAvailable}"
                                    Style="{StaticResource VayuPrimaryButton}" Height="40" Cursor="Hand"
                                    Visibility="{Binding IsLoggingInMicrosoft, Converter={StaticResource InverseBoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding MicrosoftButtonText}" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding CancelMicrosoftLoginCommand}"
                                    Style="{StaticResource VayuDarkButton}" Height="34" Margin="0,6,0,0" Cursor="Hand"
                                    Visibility="{Binding IsLoggingInMicrosoft, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="✕  Cancel Sign-In" FontSize="11.5" FontWeight="Bold" Foreground="#EF4444"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- ─── CARD 2: OFFLINE / LOCAL ACCOUNT ─── -->
                    <Border Grid.Column="2" CornerRadius="14" Background="#D00B1220" BorderBrush="#1E293B" BorderThickness="1.5"
                            Padding="22" SnapsToDevicePixels="True">
                        <StackPanel>
                            <!-- Header -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Width="36" Height="36" CornerRadius="10" Background="#1E293B" Margin="0,0,12,0">
                                    <TextBlock Text="⚡" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="LOCAL / OFFLINE" FontSize="13.5" FontWeight="Black" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Instant Setup • No Password" FontSize="11" Foreground="#10B981"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="Jump straight into singleplayer or offline LAN servers immediately by choosing a player display username."
                                       FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,14" LineHeight="17"/>

                            <!-- Input Box -->
                            <TextBlock Text="PLAYER USERNAME" FontSize="10" FontWeight="Black" Foreground="#64748B" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding OfflineUsername, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource VayuTextBox}" Height="36" Margin="0,0,0,4"
                                     FontSize="12.5" FontWeight="Bold"/>

                            <!-- Real Validation Error message -->
                            <TextBlock Text="{Binding OfflineValidationMessage}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#EF4444" Margin="0,0,0,10" TextWrapping="Wrap"
                                       Visibility="{Binding OfflineValidationMessage, Converter={StaticResource StringToVis}}"/>

                            <!-- Create & Continue Button -->
                            <Button Command="{Binding CreateOfflineAccountCommand}"
                                    IsEnabled="{Binding IsOfflineAccountAvailable}"
                                    Style="{StaticResource VayuDarkButton}" Height="40" Cursor="Hand"
                                    BorderBrush="#10B981" BorderThickness="1.5">
                                <TextBlock Text="{Binding OfflineButtonText}" FontSize="12.5" FontWeight="Bold" Foreground="#34D399"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Existing Profiles Quick Selector -->
                <Border CornerRadius="12" Background="#800B1220" BorderBrush="#1E293B" BorderThickness="1"
                        Padding="16,12" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- If Profiles Exist -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Visibility="{Binding HasExistingProfiles, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Existing Profiles Found on this PC" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <ComboBox ItemsSource="{Binding ExistingProfiles}" 
                                      SelectedItem="{Binding SelectedExistingProfile}"
                                      Style="{StaticResource VayuComboBox}" Width="260" Margin="0,6,0,0" HorizontalAlignment="Left">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding Converter={StaticResource SkinHeadImage}}" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                            <TextBlock Text="{Binding Username}" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            <Border Margin="8,0,0,0" Background="#1E293B" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AccountType}" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- If No Profiles Exist -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Visibility="{Binding HasNoExistingProfiles, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="No Existing Profiles Found" FontSize="11.5" FontWeight="Bold" Foreground="#64748B"/>
                            <TextBlock Text="Sign in with Microsoft or create a Local profile above to start playing." FontSize="10.5" Foreground="#475569" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1" Command="{Binding SelectExistingAccountAndContinueCommand}"
                                IsEnabled="{Binding CanContinueWithProfile}"
                                Style="{StaticResource VayuPrimaryButton}" Padding="18,8" VerticalAlignment="Center" Cursor="Hand">
                            <TextBlock Text="{Binding ContinueButtonText}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Global Status / Error Message with Retry -->
                <StackPanel Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}"
                            HorizontalAlignment="Center" Margin="0,0,0,8">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="#EF4444" TextAlignment="Center" Margin="0,0,0,4"/>
                    <Button Command="{Binding RetryAfterErrorCommand}"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center">
                        <TextBlock Text="🔄 Try Again" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                    </Button>
                </StackPanel>

                <!-- Skip / Enter Directly Button -->
                <Button Command="{Binding CompleteOnboardingCommand}"
                        Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <TextBlock Text="Skip Setup &amp; Open Home Dashboard →" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                </Button>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
