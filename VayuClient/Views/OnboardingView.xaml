<UserControl x:Class="VayuClient.Views.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:VayuClient.Core"
             xmlns:controls="clr-namespace:VayuClient.Controls"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1100"
             Background="#060912">

    <Grid>
        <!-- 1. Ambient Background Artwork & Glow -->
        <Image Source="/Assets/Images/vayu_minecraft_hero.jpg" Stretch="UniformToFill" Opacity="0.25"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        
        <Rectangle>
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.45" RadiusX="0.65" RadiusY="0.65">
                    <GradientStop Color="#00060912" Offset="0.0"/>
                    <GradientStop Color="#B0060912" Offset="0.6"/>
                    <GradientStop Color="#FC060912" Offset="1.0"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- 2. Central Welcome Card Container -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Style="{StaticResource VayuScrollViewer}" Padding="32,24">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="880">
                
                <!-- Logo & Brand Header -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,28">
                    <Border Width="72" Height="72" CornerRadius="36" Background="#0F172A" BorderBrush="#00D2FF" BorderThickness="2"
                            HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Border.Effect>
                            <DropShadowEffect Color="#00D2FF" BlurRadius="24" ShadowDepth="0" Opacity="0.75"/>
                        </Border.Effect>
                        <Image Source="/Assets/Images/vayu_logo.png" Width="44" Height="44" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="WELCOME TO " FontSize="28" FontWeight="Black" Foreground="#FFFFFF"/>
                        <TextBlock Text="VAYU" FontSize="28" FontWeight="Black" Foreground="#00D2FF"/>
                        <TextBlock Text="CLIENT" FontSize="28" FontWeight="Black" Foreground="#38BDF8" Margin="4,0,0,0"/>
                    </StackPanel>

                    <TextBlock Text="Next-Generation High-FPS Minecraft Client Architecture"
                               FontSize="13.5" FontWeight="SemiBold" Foreground="#94A3B8"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Choice Cards (Microsoft Login vs Offline Account) -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ─── CARD 1: MICROSOFT LOGIN ─── -->
                    <Border Grid.Column="0" CornerRadius="14" Background="#D00B1220" BorderBrush="#1E293B" BorderThickness="1.5"
                            Padding="24" SnapsToDevicePixels="True">
                        <StackPanel>
                            <!-- Header -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Width="38" Height="38" CornerRadius="10" Background="#1E293B" Margin="0,0,12,0">
                                    <Path Data="{StaticResource VayuIconAccounts}" Fill="#00D2FF" Width="18" Height="18" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="MICROSOFT ACCOUNT" FontSize="14" FontWeight="Black" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Official Auth • Online Realms" FontSize="11" Foreground="#38BDF8"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="Sign in securely with your official Microsoft account to sync your skins, access online multiplayer servers, and join official Realms."
                                       FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,20" LineHeight="18"/>

                            <!-- Device Code Status if Logging In -->
                            <Border Visibility="{Binding IsLoggingInMicrosoft, Converter={StaticResource BoolToVis}}"
                                    Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding MicrosoftAuthStatus}" FontSize="11.5" FontWeight="Bold" Foreground="#38BDF8" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding MicrosoftUserCode}" FontSize="18" FontWeight="Black" Foreground="#FFFFFF" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Actions -->
                            <Button Command="{Binding StartMicrosoftLoginCommand}"
                                    Style="{StaticResource VayuPrimaryButton}" Height="42" Cursor="Hand"
                                    Visibility="{Binding IsLoggingInMicrosoft, Converter={StaticResource InverseBoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎮  Login with Microsoft" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding CancelMicrosoftLoginCommand}"
                                    Style="{StaticResource VayuDarkButton}" Height="36" Margin="0,8,0,0" Cursor="Hand"
                                    Visibility="{Binding IsLoggingInMicrosoft, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Cancel Login" FontSize="12" FontWeight="Bold" Foreground="#EF4444"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- ─── CARD 2: OFFLINE / LOCAL ACCOUNT ─── -->
                    <Border Grid.Column="2" CornerRadius="14" Background="#D00B1220" BorderBrush="#1E293B" BorderThickness="1.5"
                            Padding="24" SnapsToDevicePixels="True">
                        <StackPanel>
                            <!-- Header -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Width="38" Height="38" CornerRadius="10" Background="#1E293B" Margin="0,0,12,0">
                                    <TextBlock Text="⚡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="LOCAL / OFFLINE" FontSize="14" FontWeight="Black" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Instant Setup • No Password" FontSize="11" Foreground="#10B981"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="Jump straight into singleplayer or offline LAN servers immediately by choosing a player display username."
                                       FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,16" LineHeight="18"/>

                            <!-- Input Box -->
                            <TextBlock Text="PLAYER USERNAME" FontSize="10" FontWeight="Black" Foreground="#64748B" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding OfflineUsername, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource VayuTextBox}" Height="38" Margin="0,0,0,14"
                                     FontSize="13" FontWeight="Bold"/>

                            <!-- Create & Continue Button -->
                            <Button Command="{Binding CreateOfflineAccountCommand}"
                                    Style="{StaticResource VayuDarkButton}" Height="42" Cursor="Hand"
                                    BorderBrush="#10B981" BorderThickness="1.5">
                                <TextBlock Text="▶  Play with Local Account" FontSize="13" FontWeight="Bold" Foreground="#34D399"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Existing Profiles Quick Selector (if any profile is already stored) -->
                <Border Visibility="{Binding HasExistingProfiles, Converter={StaticResource BoolToVis}}"
                        CornerRadius="12" Background="#800B1220" BorderBrush="#1E293B" BorderThickness="1"
                        Padding="16,12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Existing Profiles Found" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <ComboBox ItemsSource="{Binding ExistingProfiles}" 
                                      SelectedItem="{Binding SelectedExistingProfile}"
                                      DisplayMemberPath="Username"
                                      Style="{StaticResource VayuComboBox}" Width="240" Margin="0,6,0,0" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <Button Grid.Column="1" Command="{Binding SelectExistingAccountAndContinueCommand}"
                                Style="{StaticResource VayuPrimaryButton}" Padding="18,8" VerticalAlignment="Center" Cursor="Hand">
                            <TextBlock Text="Continue with Selected Profile →" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Status Feedback Message -->
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold"
                           Foreground="#EF4444" HorizontalAlignment="Center" Margin="0,0,0,10"
                           Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}"/>

                <!-- Skip / Enter Directly Button -->
                <Button Command="{Binding CompleteOnboardingCommand}"
                        Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center">
                    <TextBlock Text="Skip Setup &amp; Open Home Dashboard →" FontSize="11.5" FontWeight="Bold" Foreground="#64748B"/>
                </Button>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
